procedure TCreateStructure.AddDefNodes(CType: String; cnode: IXMLNode);
var
  pNode: IXMLNode;
  i: Integer;
begin
  tnode := GetDefNode(CType);
  for i := 0 to tnode.ChildNodes.Count - 1 do
  begin
    pNode := cnode.AddChild(tnode.ChildNodes.Nodes[i].NodeName);
    pNode.NodeValue := VarToStr(tnode.ChildNodes.Nodes[i].NodeValue);
  end;
end;

function TCreateStructure.GetDefNode(sType: String): IXMLNode;
begin
  result := nil;
  if lowercase(sType) = 'form' then
  begin
    result := tsNode;
  end
  else if lowercase(sType) = 'frame' then
  begin
    result := dcNode;
  end
  else if lowercase(sType) = 'field' then
  begin
    result := fldNode;
  end
  else if lowercase(sType) = 'fillgrid' then
  begin
    result := fgNode;
  end
  else if lowercase(sType) = 'genmap' then
  begin
    result := genNode;
  end
  else if lowercase(sType) = 'mdmap' then
  begin
    result := mdNode;
  end;
end;

procedure TCreateStructure.GetCompNode;
begin
  tsNode := pxml.DocumentElement.ChildNodes.FindNode('tstruct');
  dcNode := pxml.DocumentElement.ChildNodes.FindNode('dc');
  fldNode := pxml.DocumentElement.ChildNodes.FindNode('field');
  fgNode := pxml.DocumentElement.ChildNodes.FindNode('fillgrid');
  genNode := pxml.DocumentElement.ChildNodes.FindNode('genmap');
  mdNode := pxml.DocumentElement.ChildNodes.FindNode('mdmap');
end;

procedure TCreateStructure.AddDetailsNodes(fldNode: IXMLNode; CustDType,Separator : String);
var
  dnode, n: IXMLNode;
begin
  dnode := fldNode.ChildNodes[xml_Details];
  dnode.ChildNodes.Delete(xml_SQL);
  dnode.ChildNodes.Delete(xml_Source);
  dnode.AddChild(xml_SQL);
  n := dnode.ChildNodes[xml_SQL];
  n.Attributes['txt'] := '';
  n.Attributes['firesql'] := False;
  if Lowercase(Trim(CustDType)) = 'multi select' then begin
    n.Attributes['mulselect'] := 'true';
    n.Attributes['mulsep'] := Separator;
  end;
  n := nil;
  dnode.AddChild(xml_CField);
  dnode.AddChild(xml_SGHeight);
  n := dnode.ChildNodes[xml_SGHeight];
  n.NodeValue := 0;
  n := nil;
  dnode.AddChild(xml_SGWidth);
  n := dnode.ChildNodes[xml_SGWidth];
  n.NodeValue := 0;
  n := nil;
  dnode.AddChild(xml_AutoSelect);
  dnode.AddChild(xml_Refresh);
  dnode.AddChild(xml_List);
  n := dnode.AddChild(xml_Source);
  n.Attributes['table'] := '';
  n.Attributes['cap'] := '';
  n.Attributes['stype'] := '';
  n.Attributes['scol'] := '0';
  dnode.AddChild(xml_FParent);
  dnode.AddChild(xml_FSource);
  dnode.AddChild(xml_SourceTable);
  dnode.AddChild(xml_Suggestive);
  dnode.AddChild(xml_Trans);
  dnode.AddChild(xml_Sequence);
  dnode.AddChild(xml_Dynamic);
end;

