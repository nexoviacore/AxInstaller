// ReadTStructDef
(*
  ReadTstructDef will read definitions (def table) from the mentioned DB (This will be decided in .NET layer)
  Based on definition XML needs to be created.
  (Directly from table def can be loaded and XML can be framed)
  This Framed XML.
*)
procedure TCreateStructure.ReadTStructDef(stransid: String);
var
  tmnode: IXMLNode;
  userdesigned: Boolean;
  Ht, Lt, wt, Top1, Top2: Integer;
  t, sType: String;
  q: TXDS;
begin
  writeintolog('ReadTStructDef starts');
  try
    tmnode := nil;
    (*
      bSkipPageRelatedProcess boolean variable introduced to SKIP Page related process at the time of READTSTRUCTDEF.
      So this will be true only when the call is from READTSTRUCTDEF.

      But at the same time we need to execute this same process at the time of WRITETSTRUCTDEF ,
      For that we required menupos and menulist values . So this needs to be updated in STRUTCURE XML.
      So when calling WRITETSTRUCTDEF with STRUCTURE XML , we can execute this page related process.
    *)
    bSkipPageRelatedProcess := True;
    (*
    bSkipActionNodePreparation boolean variable introduced to SKIP Action node related process (LoadActionNode) at the time of READTSTRUCTDEF.
    So this will be true only when the call is from READTSTRUCTDEF.

    But the same required in SAVESTRUCTURE and WRITETSTRUCTDEF, so the code is written accordinly.
    *)
    bSkipActionNodePreparation := True;
    FName := stransid;
    // Load Basic structs node
    LoadPropsXML;

    fxml := LoadXMLData('<root pform="yes"></root>');
    enode := fxml.DocumentElement;
    // Load TStruct properties to XML
    LoadTstructProperties;
    // Load DC properties to XML
    LoadDCProperties;
    // Load MDMAP properties to XML
    LoadMDMapProperties;
    (*
    28/03/2022
    Commenting LoadDesktopActionProperties,since action node details will be fetched from actual structure XML (if exists)
    and updated when calling WriteTStructDef.
    *)
    // Load Desktop Action properties to XML
    //LoadDesktopActionProperties;
    // Load Action properties to XML
    LoadActionScriptProperties;
    // Load AxpConfig properties to XML
    if lowercase(FName) <> 'axglo' then LoadAxpConfigProperties;

    //Set CreatePage True when IncludePage is t/true
    if (Lowercase(sIncludePage) = 't') or (Lowercase(sIncludePage) = 'true') then
     CreateDefPage := True;
    // Updating default page value
    if CreateDefPage then // linked with core structure - isacoretrans
      fxml.DocumentElement.Attributes['defpage'] := 'n'
    else
      fxml.DocumentElement.Attributes['defpage'] := 'y';

    t := Axp.dbm.gf.convertToDBDateTime(Axp.dbm.connection.dbtype,
      Axp.dbm.getserverdatetime);
    if not IsStructExists(FName) then
    begin
      fxml.DocumentElement.Attributes['createdon'] := t;
      fxml.DocumentElement.Attributes['createdby'] := Axp.dbm.gf.username;
    end;
    fxml.DocumentElement.Attributes['updatedon'] := t;
    fxml.DocumentElement.Attributes['updatedby'] := Axp.dbm.gf.username;

    // Adding x__headtext to comps node
    cnode := enode.ChildNodes.FindNode('comps');
    if not Assigned(cnode) then
    begin
      cnode := enode.AddChild('comps');
      cnode.Attributes['cat'] := 'comps';
      tmnode := cnode.AddChild('x__headtext');
      tmnode.Attributes['t'] := 'lbl';
      tmnode.Attributes['p'] := 'x__heading';
      tmnode.Attributes['c'] := 'Test11';
      tmnode.Attributes['tlhw'] := '5,3,19,56';
      tmnode.Attributes['color'] := '';
      tmnode.Attributes['font'] := 'Tahoma,12,tfff';
    end;

    // Process AxToolBar
    try
      try
        sType := 'tstruct';
        q := nil;
        q := TXDS.Create('q', nil, Axp.dbm.connection, Axp.dbm.gf);
        q.buffered := True;
        q.CDS.CommandText :=
          'select title,key,folder,action,task,script,api,icon,parent,haschildren,ordno,footer,visible,position from AxToolBar where name = '
          + QuotedStr(FName) + ' and stype = ' + QuotedStr(sType) +
          ' and (parent is null or parent = '''') order by ordno';
        q.open;
        if q.CDS.RecordCount > 0 then begin
          LoadToolBarToCompsNode(q, cnode, IntToStr(q.CDS.RecordCount)); // Load comps from AxToolbar
          AddTaskNode(cnode);
          AddHeadingButton(cnode);
        end else LoadCompsNode(cnode); // Add default comps (btn)
      except
        on e: Exception do
        begin
          errstr := copy(e.message, 1, 199);
          if (errstr <> '') then
            raise Exception.Create('Error while loading Toolbar details for Tstruct('+FName+') - '+errstr);
        end;
      end;
    finally
      if Assigned(q) then
      begin
        q.close;
        q.Destroy;
        q := nil;
      end;
    end;

    // Create ifrmaes
    inode := enode.ChildNodes.FindNode('iframes');
    userdesigned := Assigned(inode);
    if not userdesigned then
    begin
      inode := enode.AddChild('iframes');
      inode.Attributes['cat'] := 'iframes';
      // inode.Attributes['layout'] := 'default';
      if (lowercase(layout) = 'header tabbed') then
        inode.Attributes['layout'] := 'single'
      else if (lowercase(layout) = 'header tabbed footer') then
        inode.Attributes['layout'] := 'double'
      else
        inode.Attributes['layout'] := lowercase(layout);
    end;
    Top1 := 0;
    Ht := 0;
    Top2 := 89 + 30;
    wt := 0;
    Lt := 0;
    inode := enode.ChildNodes.FindNode('iframes');

    // temp XMLNode to hold TSTRUCT PAGE menupos and menulist values when handling READTSTRUCTDEF
    // Since these values required when updating page (in WRITETSTRUCTDEF)

    tmnode := nil;
    tmnode := enode.AddChild('temp');
    tmnode.AddChild('menupos').NodeValue := menupos;
    //    replace \ to \\ --This is not needed since its handled in udocoreaction
    //menulist := ReplaceStr(menulist, '\', '\\');
    tmnode.AddChild('menulist').NodeValue := menulist;
    // menupos and menulist values updated in structure xml temp node.
    // listview also updated so no need to parse xml in WRITETSTRUCTDEF to get these values.
    tmnode.AddChild('listview').NodeValue :=
      ifthen(createlview, 'true', 'false');
    // set layout value
    tmnode.AddChild('layout').NodeValue := layout;

    //Set Page Caption
    tmnode.AddChild('fcaption').NodeValue := FCaption;

    //Set defaultPage
    if CreateDefPage then // isacoretrans
      tmnode.AddChild('defpage').NodeValue := 'false'
    else
      tmnode.AddChild('defpage').NodeValue := 'true';
    //Set Includepage
    tmnode.AddChild('includepage').NodeValue := sIncludePage;
	  //This will get the DC tables that will be deleted if user has changed the dc table name and also
    //choosen to delete the old dc tables.
    tmnode.AddChild('changeddc').NodeValue := CheckDCTableChange;


    // This can be read at the time of WRITETSTRUCTDEF

    //Complete Structure XML will be created at this stage

  finally
    // Set bSkipPageRelatedProcess boolean var value to false.
    bSkipPageRelatedProcess := False;
    //Set bSkipActionNodePreparation boolea var value to false.
    bSkipActionNodePreparation := False;
  end;
  writeintolog('ReadTStructDef ends');
end;


// WriteTStructDef
(*
  WriteTStructDef will update structure XML in Core struct Table and then It will create Transaction tables in mentioned DB (This will be decided in .NET layer).
  (As per sabarish sir suggestion , Saving Structure tables needs to be avoided (axpflds , axpdcs etc.,))
  Create ListView
  Create and Arrange (menu) Page
*)
procedure TCreateStructure.WriteTStructDef(stransid, sStructXML: String);
var
  tmnode,oenode: IXMLNode;
  changeDCList : String;
  oxml : IXMLDocument;
  HasNOdefPage : boolean;
begin
  writeintolog('WriteTStructDef starts');

  if sStructXML = '' then
  begin
    writeintolog('Structure xml is empty.');
    Exit;
  end;
  try
    (*
      Based on bImportOnlyXMLandCreateTransactionTables variable value Import structure functionality will differ.
      When bImportOnlyXMLandCreateTransactionTables is true then only XML and Transaction tables will get created
      else normal structure import will happen.
    *)
    // Assigning bImportOnlyXMLandCreateTransactionTables boolean var value to true
    bImportOnlyXMLandCreateTransactionTables := True;
    //Skip axuseraccess table deletion at the time of WriteTStructDef (by set true)
    bSkipUserAccessDelOnWriteDef := True;
    oxml := nil;
    oenode := nil;

    // Reset req values
    tmnode := nil;
    createlview := False;
    menupos := '';
    menulist := '';
    layout := '';
    changeDCList := '';
    servicename := 'WriteTStructDef';

    // Assign Transid to FName
    FName := stransid;
    //When its axglo tstruct then do not create page
    if lowercase(FName) = 'axglo' then
      accpage := False;


    //Load existing structure xml
    try
      oxml := Axp.GetStructure('tstructs',stransid,'','');
    except
    end;
    if assigned(oxml) then begin
       if (oxml.documentelement.childnodes.count <> 0) and bSkipExistingStructureImport then
       begin
          writeintolog('Skipping the import of structure **'+stransid+'**, as it already exists.');

          //
          if SkippedTransIdsList.IndexOf(stransid) = -1 then
            SkippedTransIdsList.Add(stransid);
          //
          Exit;
       end;
      oenode := oxml.DocumentElement;
      if assigned(oenode) then begin
        actnode := oenode.ChildNodes.FindNode('actions');
      end;
    end;

    // Load structure XML
    fxml := LoadXMLData(sStructXML);
    enode := fxml.DocumentElement;

    //Update existing action node to newly framed structure XML.
    LoadActionnode;

    // Assign basic required values  (read from temp node of structure xml)
    (*
      tempnode will be added with req values in READTSTRUCTDEF function result
    *)
    tmnode := enode.ChildNodes.FindNode('temp'); // Find temp node
    if Assigned(tmnode) then
    begin
      HasNOdefPage := false;
      menupos := VarToStr(tmnode.ChildValues['menupos']); // read menupos value
      menulist := VarToStr(tmnode.ChildValues['menulist']);
      //Replace \\ to \ --This is not needed since its handled in udocoreaction
      //menulist := ReplaceStr(menulist, '\\', '\');
      // read menulist value

      //Set defaultPage - isacoretrans
      HasNOdefPage := VartoStr(tmnode.ChildValues['defpage']) = 'false';
      CreateDefPage := hasdefpage;
//      CreateDefPage := VartoStr(tmnode.ChildValues['defpage']) = 'false';
      //Read Inlcudepage value
      sIncludePage := VarToStr(tmnode.ChildValues['includepage']);
      //Set CreatePage True when IncludePage is t/true
      if (Lowercase(sIncludePage) = 't') or (Lowercase(sIncludePage) = 'true') then
         CreateDefPage := True;
     //bSkipPageCreation handling should work only in AxInstaller EXE and REST DLL
      bSkipPageCreation := HasNOdefPage;
//       or (Lowercase(Trim(sIncludePage)) = 't') or (Lowercase(Trim(sIncludePage)) = 'true');

      GetPageFolderName;
      // Calling GetPagefoldername to get Page foldername and ordnum

      // Read listview property value - This can be read from XML but to avoid parsing we added this here.
      if lowercase(VarToStr(tmnode.ChildValues['listview'])) = 'true' then
        createlview := True
      else
        createlview := False;

      // Read design layout type
      layout := VarToStr(tmnode.ChildValues['layout']); // read layout type

      //Read Page Caption
      FCaption := VarToStr(tmnode.ChildValues['fcaption']);

      changeDCList := VarToStr(tmnode.ChildValues['changeddc']);

      // Removed remp node before start processing structure XML
      enode.ChildNodes.Remove(tmnode);
    end;
    // Load ifrmaes
    inode := enode.ChildNodes.FindNode('iframes');

    //Had Attribute checked can be added.
    if inode.HasAttribute('layout') then
      layout := inode.Attributes['layout']; //Common for new/modify struct and publish
    if layout = '' then layout := 'default';
    // Axp.dbm.gf.IsService := True;

    // Calling import structure
    ImportStructure;

    if Trim(changeDCList) <> '' then TransferDataAndDropOldTable(changeDCList);

    (*
      Lview and Page will be updated directly when doing publish , so no need to process it
      again at the time of publish.
    *)
    if Not bIsPublishStructure then
    begin
      // createlview value updated when calling LoadTstructProperties - This can be read from StructXML - ChildValues[xml_ListView]
      if createlview then
      begin
        DeleteListView(FName); // Delete Lview
        CreateListView; // Create Lview
      end
      else
        DeleteListView(FName); // Delete Lview
      //When accpage is true , then only update axpages table
      //if accpage then
      //begin
        SetTstructIcon;
        // Calling update pages - This will update axpages and axprops
        //UpdatePagesByPosition;
        //If the page is not accessible from menu then here it will make
        //the page hidden by setting visible = 'F' in Axpages table.
        if not accpage then HidePageFromMenu;
        //if tsIcon <> '' then // tsIcon will get updated when calling  CreatePageXML
          //SetTstructIcon;
      //end;
    end;
  finally
    // Assigning bImportOnlyXMLandCreateTransactionTables boolean var value to false
    bImportOnlyXMLandCreateTransactionTables := False;
    bSkipUserAccessDelOnWriteDef := False;  //reset value
    oxml := nil;
    oenode := nil;
  end;
  writeintolog('WriteTStructDef ends');
end;

