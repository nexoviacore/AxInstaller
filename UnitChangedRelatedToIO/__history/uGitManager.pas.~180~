            // raise
            // else
            begin
              errmsg := E.Message;
              console_write(errmsg);
              WriteLog('Error in CreateFolderStructures');
              WriteLog('Last error: ' + inttostr(E.lasterror));
              // WriteLog('HTTP Error Code : ' + inttostr(e.ErrorCode));
              WriteLog('HTTP Status     : ' + E.Message);
              WriteLog('Exception Type  : ' + E.ClassName);
              ReadErrorList(errmsg);

              httpretry := 0;
              while (httpretry < MaxhttpRetryCount) do
              begin
                try
                  errmsg := '';
                  Inc(httpretry);
                  Appwriteln('Retrying..(' + inttostr(httpretry) + ')');
                  WriteLog('Retrying..(' + inttostr(httpretry) + ')');
