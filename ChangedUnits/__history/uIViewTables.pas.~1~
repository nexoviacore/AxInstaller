unit uIViewTables;
{copied from ver 10.8\Fix4}
interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls,Contnrs,jpeg, buttons,StdCtrls,Spin, uAxprovider,uxds,
  XMLDoc, XMLIntf, uiViewXML;
type
  TIViewTables = class
  private
    axpro : TAxProvider;
    cxds,ixds,Sxds : txds;
    icaption,errorstr : string;
    axml : IXMLDocument;
    ErrorFile : TextFile;
    SQL_LIST : TStringList;
    procedure InsertIntoIviewButtonsTable;
    procedure InsertIntoIViewColsTable;
    procedure InsertIntoIViewMainTable;
    procedure InsertIntoIviewParamsTable;
    procedure InsertIntoIviewSqlTable;
    procedure InsertIntoIviewSubTotalsTable;
    procedure InsertIntoIviewHyperlinksTable;
    procedure InsertIntoIviewHypParValTable(iviewname,hypname:String;gnode:IXMLNode);
    procedure InsertIntoIviewCompsTable(cnode: ixmlnode);
  public
    enode : IXmlnode;
    pnlBtm : TLabel;
    iname,ErrorMsg : String;
    constructor create(axp : TAXprovider);
    destructor destroy;override;
    procedure InsertIntoIViewTables;
    procedure UpdateIViewTables;
    procedure DeleteRecordsInIviewTables;
  end;


implementation

{ TIViewTables }

constructor TIViewTables.create(axp: TAXprovider);
var
  fNo : Integer;
  fName : AnsiString;
begin
  axpro := axp;   fNo := 1;
  cxds := axp.dbm.GetXDS(nil);
  Sxds := axp.dbm.GetXDS(nil);
  ixds := axp.dbm.GetXDS(nil);
  ixds.buffered := true;
  errorstr := '';
  ErrorMsg := '';
  SQL_LIST:= TStringList.Create;
  {$IFNDEF ForService}
    fName := 'iviewtbl';
  {$ELSE}
    fName := 'iviewtbl_service';
  {$ENDIF}

  while True do        {since to handle rewrite on multiple running instances "while loop" is add}
  begin
    AssignFile(ErrorFile,fname+'.txt');
    try
      Rewrite(ErrorFile);
      break;
    except on e:Exception do
      errorstr := e.Message;
    end;
    if errorstr <> '' then begin
      ErrorMsg := Errorstr;
      fName := fname+inttostr(fNo)+'.txt';
      inc(fNo);
      errorstr := '';
      continue;
    end;
  end;
end;

destructor TIViewTables.destroy;
begin
  if assigned(cxds) then begin
    cxds.close;
    cxds.Destroy;
    cxds := nil;
  end;
  if assigned(ixds) then begin
    ixds.close;
    ixds.Destroy;
    ixds := nil;
  end;
  if assigned(Sxds) then begin
    Sxds.close;
    Sxds.Destroy;
    Sxds:= nil;
  end;
  if assigned(enode) then enode := nil;
  if assigned(SQL_LIST) then begin
    FreeAndNil(SQL_LIST);
  end;

  CloseFile(ErrorFile);
  inherited;
end;

procedure TIViewTables.InsertIntoIViewTables;
begin
  iname    := VarToStr(enode.Attributes['name']);
  icaption := VarToStr(enode.Attributes['caption']);
  ErrorMsg := '';
  DeleteRecordsInIviewTables;
  InsertIntoIViewMainTable;
  InsertIntoIViewColsTable;
  InsertIntoIviewSubTotalsTable;
  InsertIntoIviewButtonsTable;
  InsertIntoIviewParamsTable;
  InsertIntoIviewSqlTable;
  InsertIntoIviewHyperlinksTable;

end;

procedure TIViewTables.UpdateIViewTables;
begin
  ixds.CDS.CommandText := 'select distinct name from iviews';
  ixds.open;
  if ixds.CDS.RecordCount > 0 then begin
    while not ixds.cds.Eof do begin
      try
        axml := axpro.GetStructure('iviews',ixds.CDS.FieldByName('name').AsString,'','');
        enode := axml.DocumentElement;
        iname    := VarToStr(enode.Attributes['name']);
        icaption := VarToStr(enode.Attributes['caption']);
        DeleteRecordsInIviewTables;
        if assigned(pnlBtm) then begin
          pnlBtm.Caption := 'Storing Values to '+iname+'(IView) tables';
          pnlBtm.Refresh;
        end;
        InsertIntoIViewMainTable;
        InsertIntoIViewColsTable;
        InsertIntoIviewSubTotalsTable;
        InsertIntoIviewButtonsTable;
        InsertIntoIviewParamsTable;
        InsertIntoIviewSqlTable;
        InsertIntoIviewHyperlinksTable;
        ixds.CDS.Next;
      Except on E:Exception do
        begin
          errorstr := e.Message;
        end;
      end;
      if errorstr <> '' then begin
        if assigned(axpro) then begin
          axpro.dbm.gf.DoDebug.Log(axpro.dbm.gf.Axp_logstr+'\uIViewTables\UpdateIViewTables - '+errorstr);
          axpro.dbm.gf.DoDebug.Msg(errorstr);
        end;
        ErrorMsg := Errorstr;
        Writeln(ErrorFile,errorstr);
        ixds.CDS.Next;
      end;
    end;
  end;
end;


