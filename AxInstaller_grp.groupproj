<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{FE88B635-F0FF-4BE5-9D6A-5B57D3D7D6AB}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="AxInstaller.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="AxInstallerRest.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="AxInstaller">
        <MSBuild Projects="AxInstaller.dproj"/>
    </Target>
    <Target Name="AxInstaller:Clean">
        <MSBuild Projects="AxInstaller.dproj" Targets="Clean"/>
    </Target>
    <Target Name="AxInstaller:Make">
        <MSBuild Projects="AxInstaller.dproj" Targets="Make"/>
    </Target>
    <Target Name="AxInstallerRest">
        <MSBuild Projects="AxInstallerRest.dproj"/>
    </Target>
    <Target Name="AxInstallerRest:Clean">
        <MSBuild Projects="AxInstallerRest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="AxInstallerRest:Make">
        <MSBuild Projects="AxInstallerRest.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="AxInstaller;AxInstallerRest"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="AxInstaller:Clean;AxInstallerRest:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="AxInstaller:Make;AxInstallerRest:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
