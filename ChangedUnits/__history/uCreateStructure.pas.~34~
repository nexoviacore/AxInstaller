Function TCreateStructure.PrepareDataSetForAxToolBar(x : TXDS; ordno : Integer; purpose : String) : Integer;
var pKey, pIcon, pAction, pHint, pTask, pFolder, pParent, pHasChildren,pFooter,pScript,pAPI,pVisible,pPosition,BtnName : String;
    pleft : Integer;
begin
  if x.CDS.RecordCount = 0 then Exit;

  x.CDS.Filtered := False;
  if purpose = 'userdefined' then begin
    x.CDS.Filter := 'task is null or task = ''''';
    pleft := 59 + (10 * 12);
  end
  else if purpose = 'default' then
    x.CDS.Filter := 'task <> ''''';
  x.CDS.Filtered := True;

  if (x.CDS.RecordCount > 0) then begin
    while not x.CDS.Eof do
    begin
      pKey := x.CDS.FieldByName('key').AsString;
      pIcon := x.CDS.FieldByName('icon').AsString;
      pHint := x.CDS.FieldByName('title').AsString;

      pAction := x.CDS.FieldByName('action').AsString;
      pScript := x.CDS.FieldByName('script').AsString;
      pTask := x.CDS.FieldByName('task').AsString;
      pAPI := x.CDS.FieldByName('api').AsString;

      pFolder := x.CDS.FieldByName('folder').AsString;
      pParent := x.CDS.FieldByName('parent').AsString;
      pHasChildren := x.CDS.FieldByName('haschildren').AsString;
      pFooter := x.CDS.FieldByName('footer').AsString;
      pVisible := x.CDS.FieldByName('visible').AsString;
      pPosition := x.CDS.FieldByName('position').AsString;
      if ((purpose = 'userdefined') and (Lowercase(pHasChildren) = 'f')) then BtnName := pKey
      else BtnName := 'btn'+IntToStr(ordno);
      AddButtonForToolBar(BtnName,'', pAction, pHint, pTask, pScript,pAPI, '', pIcon,pKey,pHasChildren,pFooter,pVisible,pFolder,pPosition,pleft);
      pleft := pleft + 35;
      inc(ordno);
      x.CDS.next;
    end;
  end;
  Result := ordno;
  x.CDS.Filtered := False;
end;

procedure TCreateStructure.AddButtonForToolBar(i, img, action, hint, task, script,api, align,icon,TBKey,hasChildren,footer,tVisible,pFolder,Position: String;
  left: Integer);
var
  n,tmpNode: IXMLNode;
  s: String;
begin
//  n := cnode.AddChild('btn' + i);
  n := cnode.AddChild(i);
  n.Attributes['cat'] := 'btn';
  if (task = 'gofirst') or (task = 'goprior') or (task = 'gonext') or
    (task = 'golast') then
    n.Attributes['parent'] := 'x__heading'
  else
    n.Attributes['parent'] := 'x__toolbar';

  if task = 'listview' then
  begin
    n.Attributes['caption'] := 'List View';
    n.Attributes['sname'] := FName;
    n.Attributes['tlhw'] := '4,' + IntToStr(left) + ',26,75';
    n.Attributes['flat'] := 'True';
  end;
  AddAttributesToToolBarNode(n,hint,img,action,hint,task,script,icon,TBKey,footer,tVisible,Position,left);
  //Clear api details when api value is empty
  if (api = '') then
  begin
    //Clear API node and set api attribute value to empty
    tmpNode := nil;
    tmpNode := n.ChildNodes.FindNode('api');
    if assigned(tmpNode) and (tmpNode.ChildNodes.Count > 0) then tmpNode.ChildNodes.Clear;
    n.Attributes['api']:= '';
  end
  //Add api details to the btn node when api name is available
  else
  begin
    AddAPIdetailsToButtonNode(n,api);
    n.Attributes['api']:= api;
  end;

  if LowerCase(pFolder)='true' then n.Attributes['folder'] := 'true';
  if hasChildren = 'T' then CreateChildNodesForToolBar(n,TBKey);
