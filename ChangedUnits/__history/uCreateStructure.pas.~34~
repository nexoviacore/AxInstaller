procedure TCreateStructure.AddAttributesToToolBarNode(n : IXMLNode; caption,img,action,hint,task,script,icon,pKey,footer,tVisible,tPosition : String; left : Integer);
var s : String;
icdelm : Integer;
iconNode, icNode : IXMLNode;
begin
  n.Attributes['key'] := pKey;
  n.Attributes['caption'] := caption;
  n.Attributes['sname'] := 't' + FName;
  n.Attributes['tlhw'] := '4,' + IntToStr(left) + ',26,28';
  n.Attributes['flat'] := 'True';
  n.Attributes['img'] := img;
  n.Attributes['position'] := tPosition;
  n.Attributes['container'] := '';
  n.Attributes['hint'] := hint;

  if action <> '' then
    n.Attributes['action'] := action
  else if script <> '' then
  begin
    n.Attributes['action'] := script;
    n.Attributes['script'] := 'true';
  end
  else n.Attributes['action'] := '';

  n.Attributes['task'] := task;
  s := tasks.TStructShortcutkey(VarToStr(n.Attributes['task']));
  n.Attributes['scut'] := 'Ctrl+' + Trim(s);
  n.Attributes['def'] := '';
  n.Attributes['font'] := 'Tahoma,8,clBlack,ffff';
  if LowerCase(footer) = 'true' then
    n.Attributes['footer'] := 'true'
  else n.Attributes['footer'] := 'false';

  if LowerCase(tVisible) = 'true' then
    n.Attributes['visible'] := 'true'
  else n.Attributes['visible'] := 'false';


  if (icon <> '') then
  begin
    icdelm := Pos('|', icon);
    if icdelm > 0 then
    begin
      iconNode := n.AddChild('icon');
      icNode := iconNode.AddChild('text');
      icNode.Text := Copy(icon, 0, icdelm-1);;
      icNode := iconNode.AddChild('addClass');
      icNode.Text := Copy(icon, icdelm+ 1, length(icon));
    end
    else
    begin
      iconNode := n.AddChild('icon');
      iconNode.Text := icon;
    end;
  end;
  if LowerCase(task) = 'tasks' then n.Attributes['folder'] := 'true';
end;

procedure TCreateStructure.CreateChildNodesForToolBar(ParentNode : IXMLNode; pKey : String);
var ptype,pTitle, ordno, pIcon, pAction, pHint, pTask, pFolder, pParent, pHasChildren,pFooter,pScript,pVisible,pPosition : String;
    ccds : TXDS;
    chNode : IXMLNode;
    i : Integer;
begin
//    ParentNode.Attributes['folder'] := 'true';
    ptype := 'tstruct';
    ccds := axp.dbm.GetXDS(nil);
    ccds.buffered := True;
    ccds.CDS.CommandText := 'select title,key,folder,action,task,script,icon,parent,haschildren,ordno,footer,visible,position from AxToolBar where name = '+
                              QuotedStr(Fname) + ' and stype = ' + QuotedStr(ptype) + 'and parent = ' + QuotedStr(pKey) + 'order by ordno';
    ccds.Open;
    ccds.CDS.First;
    i := 1;
    while not ccds.CDS.Eof do
    begin
      chNode := ParentNode.AddChild('pop'+IntToStr(i));
      pKey := ccds.CDS.FieldByName('key').AsString;
      ordno := ccds.CDS.FieldByName('ordno').AsString;
      pIcon := ccds.CDS.FieldByName('icon').AsString;
      pAction := ccds.CDS.FieldByName('action').AsString;
      pHint := ccds.CDS.FieldByName('title').AsString;
      pTask := ccds.CDS.FieldByName('task').AsString;
      pScript := ccds.CDS.FieldByName('script').AsString;
      pFolder := ccds.CDS.FieldByName('folder').AsString;
      pParent := ccds.CDS.FieldByName('parent').AsString;
      pHasChildren := ccds.CDS.FieldByName('haschildren').AsString;
      pFooter := ccds.CDS.FieldByName('footer').AsString;
      pVisible := ccds.CDS.FieldByName('visible').AsString;
      pPosition := ccds.CDS.FieldByName('position').AsString;
      AddAttributesToToolBarNode(chNode,pHint,'',paction,phint,ptask,pScript,picon,pKey,pFooter,pVisible,pPosition,0);
      if LowerCase(pFolder)='true' then chNode.Attributes['folder'] := 'true';
      if (pHasChildren = 'T') then CreateChildNodesForToolBar(chNode, pKey);
      inc(i);
      ccds.CDS.Next;
    end;
end;

