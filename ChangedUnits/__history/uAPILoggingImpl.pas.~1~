// ExtractApiMethodName
function ExtractApiMethodName(const AURL: string): string;
var
  ParamsIndex: Integer;
  URL: String;
begin
  Result := '';
  try
    URL := StringReplace(AURL, '/', '\', [rfReplaceAll]);
    // If there are query parameters, find the segment before the first query parameter
    ParamsIndex := Pos('?', URL);
    if ParamsIndex > 0 then
      // Extract the path part before the query parameters
      Result := ExtractFileName(Copy(URL, 1, ParamsIndex - 1))
    else
      Result := ExtractFileName(URL); // Extract the last segment
  finally
  end;
end;

// ProcessandFormatContentSize
function ProcessandFormatContentSize(const AStr: string): string;
var
  SizeBytes: Int64;
  SizeKB: Double;
  SizeMB: Double;
begin
  // Calculate size in bytes for UTF-8 encoding
  SizeBytes := TEncoding.UTF8.GetByteCount(AStr);

  // Determine how to format based on size
  if SizeBytes < 1024 then
    Result := IntToStr(SizeBytes) + ' B' // Less than 1KB, show in bytes
  else
  begin
    SizeKB := SizeBytes / 1024; // Convert to KB
    if SizeKB < 1024 then
      Result := FormatFloat('#,##0.#', SizeKB) + ' KB'
      // Between 1KB to 1023.99KB, show in KB
    else
    begin
      SizeMB := SizeKB / 1024; // Convert to MB
      Result := FormatFloat('#,##0.#', SizeMB) + ' MB';
      // Greater than or equal to 1MB, show in MB
    end;
  end;
end;

// FormatTimeDifference
function FormatTimeDifference(const pRequestStartTime, pRequestEndTime
  : TDateTime): string;
var
  MillisecondsDiff: Int64;
  SecondsDiff: Double;
  MinutesDiff: Double;
begin
  // Calculate the difference in milliseconds
  MillisecondsDiff := MilliSecondsBetween(pRequestEndTime, pRequestStartTime);

  // Determine the appropriate format
  if MillisecondsDiff < 1000 then
    Result := Format('%d ms', [MillisecondsDiff])
  else
  begin
    SecondsDiff := MillisecondsDiff / 1000.0;
    if SecondsDiff < 60 then
      Result := Format('%.1f s', [SecondsDiff])
    else
    begin
      MinutesDiff := SecondsDiff / 60.0;
      Result := Format('%.1f min', [MinutesDiff]);
    end;
  end;
end;

// GetAllHeaders
function GetAllHeaders(Request: TWebRequest): string;
const
  CommonHeaders: array [0 .. 23] of string = ('Accept', 'Accept-Charset',
    'Accept-Encoding', 'Accept-Language', 'Authorization', 'Cache-Control',
    'Connection', 'Content-Length', 'Content-Type', 'Cookie', 'Date', 'Expect',
    'From', 'Host', 'If-Match', 'If-Modified-Since', 'If-None-Match',
    'If-Range', 'If-Unmodified-Since', 'Max-Forwards', 'Pragma', 'Referer',
    'User-Agent', 'X-Client-App');
var
  i: Integer;
  HeaderValue: string;
begin
  Result := '';
  for i := Low(CommonHeaders) to High(CommonHeaders) do
  begin
    HeaderValue := Request.GetFieldByName(CommonHeaders[i]);
    if HeaderValue <> '' then
    begin
      if Result <> '' then
        Result := Result + #13#10; // add newline if not first header
      Result := Result + CommonHeaders[i] + ': ' + HeaderValue;
    end;
  end;
end;

// GetRequestSource
function GetRequestSource(Request: TWebRequest): string;
begin
  // Check User-Agent header first
  Result := Request.UserAgent;

  // If User-Agent is empty, check Referer header
  if Result = '' then
    Result := Request.Referer;

  // If still empty, check custom header 'X-Client-App'
  if Result = '' then
    Result := Request.GetFieldByName('X-Client-App');

  // If none of the above have a value, default to 'Unknown' or any desired default
  if Result = '' then
    Result := 'Unknown';
end;

// GetFullRequestURL
function GetFullRequestURL(Request: TWebRequest): string;
begin
  Result := Request.RawPathInfo; // Start with the RawPathInfo

  // Append the QueryString if present
  // if Request.QueryString <> '' then
  // Result := Result + '?' + Request.QueryString;
end;

function GetFullRequestURLNew(Request: TWebRequest): string;
var
  RequestURL: String;
begin
  RequestURL := '';
  // Determine the protocol (http or https)
  if Request.ProtocolVersion = 'HTTP/1.1' then
  begin
    RequestURL := Request.URL;
    if RequestURL.StartsWith('https://') then
      Result := 'https://'
    else
      Result := 'http://'
  end
  else
    Result := 'http://';

  // Append the host (domain or IP address) and port
  Result := Result + Request.Host;

  // Append base URL
  Result := Result + Request.URL;

  // Append the raw path info
  Result := Result + Request.RawPathInfo;

end;

// GetAPINameFromFirstObject
function GetAPINameFromFirstObject(const JSONObject: TJSONObject): string;
var
  Pair: TJSONPair;
  FirstObject: TJSONObject;
begin
  Result := '';
  if JSONObject.Size > 0 then
  begin
    Pair := JSONObject.Get(0); // Get the first key-value pair
    if Assigned(Pair) and (Pair.jsonValue is TJSONObject) then
    begin
      FirstObject := Pair.jsonValue as TJSONObject;
      // Attempt to find "apiname" key and get its value
      Pair := FirstObject.Get('apiname');
      if Assigned(Pair) then
      begin
        // Return the value of the "purpose" key as a string
        Result := Pair.jsonValue.Value;
      end;
    end;
  end;
end;


// GetAPINameFromRootObject
function GetAPINameFromRootObject(const JSONObject: TJSONObject): string;
var
  Pair: TJSONPair;
  FirstObject: TJSONObject;
begin
  Result := '';
  try
  if Assigned(JSONObject) and (JSONObject.Size > 0) then
  begin
    // Attempt to find "apiname" key and get its value
    Pair := JSONObject.Get('apiname');
    if Assigned(Pair) then
    begin
      // Return the value of the "purpose" key as a string
      Result := Pair.jsonValue.Value;
    end;
  end;
  except
    //silent
  end;
end;

// GetAPIName
function GetAPIName(const JSONString: string): string;
var
  JSONObject: TJSONObject;
  JSONPair: TJSONPair;
  JSONArray: TJsonArray;
  jsonValue: TJSONValue;
begin
  Result := '';
  try
    // Parse the main JSON string
    JSONObject := TJSONObject.ParseJSONValue(JSONString) as TJSONObject;
    if Assigned(JSONObject) then
    begin
      try
        // Check if "_parameters" key exists and is a JSON array
        JSONPair := JSONObject.Get('_parameters');
        if Assigned(JSONPair) and (JSONPair.jsonValue is TJsonArray) then
        begin
          JSONArray := JSONPair.jsonValue as TJsonArray;
          // Check if the array has at least one element and the first element is a JSON object
          if (JSONArray.Size > 0) then
          begin
            jsonValue := JSONArray.Get(0);
            if Assigned(jsonValue) and (jsonValue is TJSONObject) then
            begin
              // Get apiname from the first object in the array
              Result := GetAPINameFromFirstObject(jsonValue as TJSONObject);
            end;
          end;
        end
        else
        begin
          Result := GetAPINameFromRootObject(JSONObject);
        end;
        if Result = '' then
          // Get apiname from the main JSON object
          Result := GetAPINameFromFirstObject(JSONObject);
      finally
        // Free the main JSON object
        JSONObject.Free;
      end;
    end;
  except
    on E: Exception do
    begin
      // Handle parsing or other errors
    end;
  end;
end;

