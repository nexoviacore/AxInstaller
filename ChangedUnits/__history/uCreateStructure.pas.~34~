Procedure TCreateStructure.LoadAxpConfigProperties;
var errstr,colNames,temp,sn : String;
    fnode : IXMLNode;
begin
  try
    writeintolog('AxpConfig Node append started...');
    fnode := enode.AddChild('axpconfigs_'+FName);
    fnode.Attributes['cat'] := 'config';

    //For searchcols Fields
    MXDS.close;
    MXDS.CDS.CommandText := 'select name from vw_field_informations where ' + Axp.dbm.gf.sqllower
                            + '(transid)= '+QuotedStr(LowerCase(FName)) +' and hideinsearch = ''F'' order by name asc';
    writeintolog(MXDS.CDS.CommandText);
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
      fnode.AddChild('CONFIGNAME').NodeValue := 'searchcols';
      colNames := '';
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        temp := MXDS.CDS.FieldByName('name').AsString;
        colNames := colNames+','+temp;
        MXDS.CDS.Next;
      end;
      fnode.AddChild('CVALUE').NodeValue := Copy(colNames,2,length(colNames));
    end;

    //For refreshselect Fields --- axusr^axuser-employee,no~axusr^axusername-department,no
    MXDS.close;
    MXDS.CDS.CommandText := 'Select mastertstruct,masterfield,name,savenormalized from vw_field_informations where '+
                            Axp.dbm.gf.sqllower+'(transid) = '+QuotedStr(LowerCase(FName))+'  and '+Axp.dbm.gf.sqllower+
                            '(modeofentry) in (''select from sql'',''select from form'') and '+
                            '(mastertstruct <> '''' or mastertstruct is not null) order by fldordno';
    writeintolog(MXDS.CDS.CommandText);
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
      fnode.AddChild('CONFIGNAME').NodeValue := 'refreshselect';
      colNames := '';
      temp := '';
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        sn := (LowerCase(MXDS.CDS.FieldByName('savenormalized').AsString));
        if sn = 'true' then sn := 'yes'
        else if sn = 'false' then sn := 'no';
        temp := (MXDS.CDS.FieldByName('mastertstruct').AsString)+'^'+(MXDS.CDS.FieldByName('masterfield').AsString)+'-'+
                (MXDS.CDS.FieldByName('name').AsString)+','+sn;
        colNames := colNames+'~'+temp;
        MXDS.CDS.Next;
      end;
      fnode.AddChild('CVALUE').NodeValue := Copy(colNames,2,length(colNames));
    end;
  except
    on e: Exception do
    begin
      errstr := copy(e.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create('Error while loading AxpConfig details '+errstr);
    end;
  end;
end;


Procedure TCreateStructure.LoadDesktopActionProperties;
