// SaveAxRequestDetails
procedure TAPILoggingHandler.SaveAxRequestDetails(Request: TWebRequest;
  Response: TWebResponse);
var
  sURL, ClientIP: String;
begin
  try
  RequestStartTime := Now;
  slWebRequest.Clear;

  // Generate a unique RequestID (you can adjust this logic as per your requirements)
  slWebRequest.Values['RequestID'] := TGuid.NewGuid.ToString;

  // Timestamp when the request was made
  // slWebRequest.Values['Timestamp'] := DateTimeToStr(Now);

  // Source application or entity invoking the API
  slWebRequest.Values['SourceFrom'] := GetRequestSource(Request);
  // 'UnKnown';//YourSourceApplication

//  ClientIP := Request.RemoteAddr;
//  if (ClientIP = '::1') or (ClientIP = '127.0.0.1') then
//    ClientIP := GetLocalIPNew;//GetLocalIPAddress; //GetLocalIP;
  // IP address of the machine from which the request originated
  slWebRequest.Values['SourceMachineIP'] := GetClientIP(Request);//GetClientIP(Request);//Request.RemoteAddr;

  // Request body (if applicable, for POST requests)
  slWebRequest.Values['RequestString'] := Request.Content;

  // HTTP headers sent with the request
  slWebRequest.Values['Headers'] := GetAllHeaders(Request);

  // Parameters or query string included in the request URL
  slWebRequest.Values['Params'] := Request.Query;

  // Authorization details (token, JWT, etc.)
  slWebRequest.Values['Authz'] := Request.Authorization;

  // Hostname or IP of the server being accessed
  slWebRequest.Values['Host'] := Request.Host;

  sURL := GetFullRequestURLNew(Request);
  // Full URL used to invoke the API
  slWebRequest.Values['URL'] := sURL;
  // GetFullRequestURL(Request);//Request.URL;

  // Name or identifier of the API method being called
  // slWebRequest.Values['APIMethodName'] := ExtractApiMethodName(Request.URL);

  // HTTP method used (GET, POST, PUT, DELETE, etc.)
  slWebRequest.Values['RequestMethod'] := Request.Method;

  // User associated with the API request (if applicable)
  // slWebRequest.Values['User'] := Request.Username; // Adjust as per your application's authentication

  // Additional details (if needed)
  slWebRequest.Values['AdditionalDetails'] := ''; // AnyOtherDetails

  // Content type of the request body
  slWebRequest.Values['ContentType'] := Request.ContentType;

  // Length of the request body in bytes
  slWebRequest.Values['ContentLength'] := ProcessandFormatContentSize
    (Request.Content);
  // IntToStr(Request.ContentLength);

  // Date and time when the request was received
  slWebRequest.Values['requestReceivedTime'] := DateTimeToStr(Now);
  // Or use another timestamp

  // Endpoint or API method responded to (if applicable)
  slWebRequest.Values['Endpoint'] := ExtractApiMethodName(sURL);
  // ExtractApiMethodName(Request.URL);//'YourEndpointName'; // Adjust based on your application logic

  // Purpose (outbound, FormNotification..,)
  slWebRequest.Values['APIName'] := GetAPIName(Request.Content);

  // Response header
  SetCustomResponseHeaders(Response);
  slWebRequest.Values['ResponseHeader'] := Response.CustomHeaders.Text;
  // GetInvocationMetadata  //Response.CustomHeaders.Text;
  //slWebRequest.SaveToFile
    //('E:\Projects\Axpert\Axpert64\APIRequest_MetaData.log');
  Except on E:Exception do
    if Assigned(slWebRequest) then
      slWebRequest.Values['AdditionalDetails']  := 'Error in SaveAxRequestDetails '+E.Message;
  end;
end;

function GeneratePragma: string;
var
  SessionID: string;
  SessionExpires: string;
begin
  // Generate session-related values dynamically
  SessionID := TGuid.NewGuid.ToString; // Generate a new GUID as a session ID
  SessionExpires := IntToStr(20 * 60 * 1000);
  // Example: 20 minutes in milliseconds
  Result := Format('dssession=%s,dssessionexpires=%s',
    [SessionID, SessionExpires]);
end;

function GetServerInfo: string;
var
  Buffer: array [0 .. 255] of Char;
  Size: DWORD;
begin
  Size := SizeOf(Buffer);
  if GetComputerName(Buffer, Size) then
    Result := Format('%s/1.0', [Buffer])
  else
    Result := 'UnknownServer/1.0';
end;

function GetPoweredBy: string;
var
  OSVersionInfo: TOSVersionInfo;
begin
  OSVersionInfo.dwOSVersionInfoSize := SizeOf(TOSVersionInfo);
  if GetVersionEx(OSVersionInfo) then
    Result := Format('Windows %d.%d', [OSVersionInfo.dwMajorVersion,
      OSVersionInfo.dwMinorVersion])
  else
    Result := 'UnknownOS';
end;

Procedure TAPILoggingHandler.SetCustomResponseHeaders(Response: TWebResponse);
begin
  // Set dynamic headers
  Response.SetCustomHeader('Pragma', GeneratePragma);
  Response.SetCustomHeader('Server', GetServerInfo);
  Response.SetCustomHeader('X-Powered-By', GetPoweredBy);

  // Set other necessary headers
  Response.ContentType := 'application/json';
  // or any other appropriate content type
  Response.SetCustomHeader('Date',
    FormatDateTime('ddd, dd mmm yyyy hh:nn:ss "GMT"', (Now))); // format as GMT
  // Response.ContentLength := Length(Response.Content); // Set content length dynamically
end;

