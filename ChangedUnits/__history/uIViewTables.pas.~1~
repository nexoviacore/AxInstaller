procedure TIViewTables.InsertIntoIViewColsTable;
var
  i,j,k : integer;
  colnode,cnode,n : IXMLNode;
  w,fname,fcaption,decimals,dtype,exp,run_tot,disp_tot,hidden,f,nname : string;
begin
  k := 0;
  for I := 0 to enode.ChildNodes.Count - 1 do begin
    nname := vartostr(enode.ChildNodes[i].Attributes['cat']);
    if (nname = 'querycol') or (nname = 'column') then begin
      try
        inc(k);
        colnode := enode.ChildNodes[i];
        fname   :=  VarToStr(colnode.ChildNodes.FindNode(xml_columnname).NodeValue);
        fcaption := VarToStr(colnode.ChildNodes.FindNode(xml_columnheading).NodeValue);
        decimals := VarToStr(colnode.ChildNodes.FindNode(xml_decimals).NodeValue);
        if VarToStr(colnode.ChildNodes.FindNode(xml_datatype).NodeValue) = 'Date/Time' then dtype := 'D'
        else if VarToStr(colnode.ChildNodes.FindNode(xml_datatype).NodeValue) = 'Character' then dtype := 'C'
        else dtype := 'N';
        exp := VarToStr(colnode.ChildNodes.FindNode(xml_expression).NodeValue);
        if  lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_runningtotal).NodeValue)) = 'true' then run_tot := 'T'
        else run_tot := 'F';
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_displaytotal).NodeValue))= 'true' then disp_tot := 'T'
        else disp_tot := 'F';
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_hidden).NodeValue))= 'true' then hidden := 'T'
        else hidden := 'F';
        cxds.ClearEdit;
        cxds.Submit('INAME',iname,'c');
        cxds.Submit('ICAPTION',icaption,'c');
        cxds.Submit('F_NAME',fname,'c');
        cxds.Submit('F_CAPTION',fcaption,'c');
        cxds.Submit('DECIMALS',decimals,'n');
        cxds.Submit('DATATYPE',dtype,'c');
        cxds.Submit('HIDDEN',hidden,'c');
        cxds.Submit('EXPRESSION',exp,'c');
        cxds.Submit('RUNNING_TOTAL',run_tot,'c');
        cxds.Submit('DISPLAY_TOTAL',disp_tot,'c');
        cxds.Submit('Colcat',nname,'c');
        cxds.Submit('ordno',IntToStr(k),'n');
        if (nname = 'querycol') then begin
          f := VarToStr(colnode.ChildNodes.FindNode(xml_queryname).NodeValue);
          cxds.Submit('QUERY_NAME',f,'c');
        end;
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_norepeat).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('NO_REPEAT',f,'c');
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_applycomma).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('APPLY_COMMA',f,'c');
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_setfactor).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('SET_FACTOR',f,'c');
        f :=VarToStr(colnode.ChildNodes.FindNode(xml_alignment).NodeValue);
        cxds.Submit('ALIGNMENT',f,'c');
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_colseparator).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('COL_SEPERATOR',f,'c');
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_zerooff).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('ZERO_OFF',f,'c');
        if lowercase(VarToStr(colnode.ChildNodes.FindNode(xml_computepost).NodeValue))= 'true' then f := 'T'
        else f := 'F';
        cxds.Submit('COMPUTE_POST',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_color).NodeValue);
        cxds.Submit('COLOR',f,'c');
        f :=  VarToStr(colnode.ChildNodes.FindNode(xml_font).NodeValue);
        cxds.Submit('FONT',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_columnwidth).NodeValue);
        cxds.Submit('COLUMN_WIDTH',f,'n');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_displayexpression).NodeValue);
        cxds.Submit('DISP_EXPR',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_beforefill).NodeValue);
        cxds.Submit('BEFORE_FILL',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_click).NodeValue);
        cxds.Submit('CLICK',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_dblclick).NodeValue);
        cxds.Submit('DBLCLICK',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_tablename).NodeValue);
        cxds.Submit('TABLE_NAME',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_searchname).NodeValue);
        cxds.Submit('SEARCH_NAME',f,'c');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_groupno).NodeValue);
        cxds.Submit('GROUP_NO',f,'n');
        f := VarToStr(colnode.ChildNodes.FindNode(xml_groupheading).NodeValue);
        cxds.Submit('GROUP_HEADING',f,'c');
        cnode := colnode.ChildNodes.FindNode(xml_setcellfont);
        if cnode = nil then
          f := ''
        else begin
          f := '';
          if not (cnode.NodeType in [ntElement, ntText]) then
          begin
            for j := 0 to cnode.ChildNodes.Count-1 do begin
              n := cnode.ChildNodes[j];
              f := f+n.NodeValue+'~'+VarToStr(n.Attributes['textstyle'])+'@#';
            end;
          end;
        end;
        cxds.Submit('SET_CELLFONT',f,'c');
        w := 'INAME = '+QuotedStr(iname)+ 'and F_NAME = '+ QuotedStr(fname);
        cxds.AddOrEdit('IVIEWCOLS',w);
        cxds.close;
      Except on E:Exception do
        begin
          if assigned(axpro) then
             axpro.dbm.gf.DoDebug.Log(axpro.dbm.gf.Axp_logstr+'\uIViewTables\InsertIntoIViewColsTable - '+e.Message);
          axpro.dbm.gf.DoDebug.Msg(E.Message);
          Writeln(ErrorFile,e.Message);
          continue;
        end;
      end;
    end;
  end;
end;



