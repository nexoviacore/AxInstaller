procedure TMain.StoreLatestVersion(const ProductVersionOrCRVersion,ResultOfInstallation,ResultOfInstallMsg: string);
var
  Installation: TInstallation;
begin
  WriteLog('StoreLatestVersion - Start');

  if selectedProductVersion<>'' then
   WriteLog('ProductVersion Name : ' + selectedProductVersion);


  if selectedCR<>'' then
   WriteLog('ChangeRequest Name : ' + selectedCR);


  WriteLog('Version : ' + ProductVersionOrCRVersion);

  Installation := nil;
 try
  try
    WriteLog('Creating TInstallation object');

    Installation := TInstallation.Create;

    WriteLog('TInstallation object created successfully');

  if selectedProductVersion<>'' then
    Installation.StoreLatestVersionToDb(selectedProductVersion,ProductVersionOrCRVersion,ResultOfInstallation,ResultOfInstallMsg);

  if selectedCR<>'' then
    Installation.StoreLatestVersionToDb(selectedCR,ProductVersionOrCRVersion,ResultOfInstallation,ResultOfInstallMsg);

    WriteLog('StoreLatestVersionToDb completed successfully');
    WriteLog('StoreLatestVersion - Completed');

  except
    on E: Exception do
    begin
      WriteLog('StoreLatestVersion - FAILED');

      if selectedProductVersion <> '' then
        WriteLog('ProductVersion Name : ' + selectedProductVersion);

      if selectedCR<>'' then
        WriteLog('ChangeRequest Name : ' + selectedCR);

      WriteLog('Version : ' + ProductVersionOrCRVersion);
      WriteLog('Exception Class : ' + E.ClassName);
      WriteLog('Error : ' + E.Message);

      raise;
    end;
  end;
  finally
    if Assigned(Installation) then
    begin
      WriteLog('Freeing TInstallation object');

      Installation.Free;

      WriteLog('TInstallation object freed successfully');
    end;
   end;
    WriteLog('StoreLatestVersion - End');
end;

function TMain.GetLatestVersion(): string;
var
  Installation: TInstallation;
begin
  Result := '';

  WriteLog('GetLatestVersion - Start');

  if selectedProductVersion <> '' then
   WriteLog('ProductVersion Name : ' + selectedProductVersion);

  if selectedCR <> '' then
   WriteLog('ChangeRequest Name : ' + selectedCR);
  

  Installation := nil;
 try
  try
    WriteLog('Creating TInstallation object');

    Installation := TInstallation.Create;

    WriteLog('TInstallation object created successfully');

    if selectedProductVersion<>'' then
      Result := Installation.GetStoredVersionFromDB(selectedProductVersion);

    if selectedCR<>'' then
       Result := Installation.GetStoredVersionFromDB(selectedCR);


    WriteLog('Stored version returned : ' + Result);
    WriteLog('GetLatestVersion - Completed');

  except
    on E: Exception do
    begin
      WriteLog('GetLatestVersion - FAILED');
      if selectedProductVersion<> '' then
        WriteLog('ProductVersion Name : ' + selectedProductVersion);

      if selectedCR <> '' then
        WriteLog('ChangeRequest Name : ' + selectedCR);

      WriteLog('Exception Class : ' + E.ClassName);
      WriteLog('Error : ' + E.Message);

      raise;
    end;
  end;
  finally
    if Assigned(Installation) then
    begin
      WriteLog('Freeing TInstallation object');

      Installation.Free;

      WriteLog('TInstallation object freed successfully');
    end;

    WriteLog('GetLatestVersion - End');
  end;
end;

function TMain.GetAndStoreLatestVersion(const ProductVersionOrCRVersion,ResultOfInstallation,ResultOfInstallMsg: string;
  IsGet: Boolean): string;
begin
  WriteLog('GetAndStoreLatestVersion Is started.....');
  WriteLog('Version Given : ' + ProductVersionOrCRVersion +' IsGetVERSION : ' + BoolToStr(IsGet, True));
  Result := '';

  if IsGet then
  begin
    Result := GetLatestVersion();
  end
  else
  begin
        StoreLatestVersion(ProductVersionOrCRVersion,ResultOfInstallation,ResultOfInstallMsg);
  end;

end;

function TMain.CompareProductVersionVersion(const RequestedVersion,
  InstalledVersion: string): Integer;
var
  RequestedNumber: Extended;
  InstalledNumber: Extended;
  Version: string;
  InstalledStr: string;
  Code: Integer;
begin
  Version := StringReplace(
    RequestedVersion,
    'version',
    '',
    [rfReplaceAll, rfIgnoreCase]
  );

  InstalledStr := StringReplace(
    InstalledVersion,
    'version',
    '',
    [rfReplaceAll, rfIgnoreCase]
  );

  Version := Trim(Version);
  InstalledStr := Trim(InstalledStr);

  Val(Version, RequestedNumber, Code);

  if Code <> 0 then
    raise Exception.Create(
      'Invalid requested version: ' + RequestedVersion);

  Val(InstalledStr, InstalledNumber, Code);

  if Code <> 0 then
    raise Exception.Create(
      'Invalid installed version: ' + InstalledVersion);

  if RequestedNumber > InstalledNumber then
    Result := 1
  else if RequestedNumber < InstalledNumber then
    Result := -1
  else
    Result := 0;
end;

procedure TMain.ClearTempFiles;
var
  sExePath, sStartPath, sSessionId, sFolder, sFull, sIViewMask : string;
  aFolders, aFiles, aIViewMatches : array of string;
  i, j, k : Integer;
begin
  try
    if not Assigned(dbm) then
      Exit;
    sSessionId := Trim(dbm.gf.sessionid);
    if sSessionId = '' then
      Exit;
    sExePath   := dbm.gf.exepath;
    sStartPath := dbm.gf.startpath;

    SetLength(aFiles, 2);
    aFiles[0] := 'import_' + sSessionId + '.txt';   // #1 - uCreateStructure.ImportStructure
    aFiles[1] := 'dataupd_' + sSessionId + '.txt';  // #3 - uStructInTable.Create

    sIViewMask := 'iviewtbl_service_' + sSessionId + '*';

    if SameText(IncludeTrailingPathDelimiter(sExePath),
                IncludeTrailingPathDelimiter(sStartPath)) then
    begin
      SetLength(aFolders, 1);
      aFolders[0] := sExePath;
    end
    else
    begin
      SetLength(aFolders, 2);
      aFolders[0] := sExePath;
      aFolders[1] := sStartPath;
    end;

    for i := 0 to High(aFolders) do
    begin
      sFolder := Trim(aFolders[i]);
      if (sFolder = '') or (not TDirectory.Exists(sFolder)) then
        Continue;

      { #1 and #3 - exact filenames }
      for j := 0 to High(aFiles) do
      begin
        sFull := IncludeTrailingPathDelimiter(sFolder) + aFiles[j];
        if FileExists(sFull) then
        begin
          if System.SysUtils.DeleteFile(sFull) then
            WriteLog('ClearTempFiles: Deleted ' + sFull)
          else
            WriteLog('ClearTempFiles: Unable to delete ' + sFull);
        end;
      end;

      { #2 - every iviewtbl_service_<SessionID>* variant in this folder }
      aIViewMatches := TDirectory.GetFiles(sFolder, sIViewMask);
      for k := 0 to High(aIViewMatches) do
      begin
        if System.SysUtils.DeleteFile(aIViewMatches[k]) then
          WriteLog('ClearTempFiles: Deleted ' + aIViewMatches[k])
        else
          WriteLog('ClearTempFiles: Unable to delete ' + aIViewMatches[k]);
      end;
    end;
  except
    on E: Exception do
      WriteLog('ClearTempFiles: Error in ClearTempFiles - ' + E.Message);
  end;
end;

