// GetRequestContentType
function GetRequestContentType(ARequest: TIdHTTPRequest): string;
var
  i, DelimiterPos: Integer;
  HeaderLine: String;
begin
  // Set return an empty string
  Result := '';

  // First, check if ContentType is set directly
  if ARequest.ContentType <> '' then
  begin
    Result := ARequest.ContentType;
    Exit;
  end;

  // If ContentType is not set directly, check the custom headers
  // Due to : for assigning values / some other reason , we are unable to read
  // values directly , so we are approaching diff way to fetch the value

  // Iterate through CustomHeaders to find 'Content-Type'
  for i := 0 to ARequest.CustomHeaders.Count - 1 do
  begin
    // Check if the header name is 'Content-Type' (case-insensitive)
    if SameText(ARequest.CustomHeaders.Names[i], 'Content-Type') then
    begin
      HeaderLine := ARequest.CustomHeaders[i];
      DelimiterPos := Pos(':', HeaderLine);
      if DelimiterPos > 0 then
      begin
        Result := Trim(Copy(HeaderLine, DelimiterPos + 1, Length(HeaderLine)));
        // Result := ARequest.CustomHeaders.ValueFromIndex[i];
        Exit;
      end;
    end;
  end;
end;

// GetRequestSource
function GetHTTPRequestSource(IdHTTP: TIdHTTP): string;
begin
  Result := 'unknown'; // Default value if none of the headers are found

  try
    // Check User-Agent header
    if IdHTTP.Request.UserAgent <> '' then
    begin
      Result := IdHTTP.Request.UserAgent;
      Exit; // Return immediately if User-Agent header is found
    end;

    // Check Referer header
    if IdHTTP.Request.Referer <> '' then
    begin
      Result := IdHTTP.Request.Referer;
      Exit; // Return immediately if Referer header is found
    end;

    // Check custom headers
    if IdHTTP.Request.CustomHeaders.IndexOfName('X-Client-App') <> -1 then
    begin
      Result := IdHTTP.Request.CustomHeaders.Values['X-Client-App'];
      Exit; // Return immediately if custom header is found
    end;

    // Add more checks for additional headers if needed

  except
    on E: Exception do
    begin
      // Handle exceptions (optional)
      Result := 'error: ' + E.Message;
    end;
  end;
end;

// ExtractURLParams
function ExtractURLParams(const URL: string): string;
var
  URI: TIdURI;
  ParamsList: TStringList;
  Param: string;
begin
  Result := '';

  // Create a TStringList to hold the parameters
  ParamsList := TStringList.create;
  try
    // Parse the URL using TIdURI
    URI := TIdURI.create(URL);
    try
      // Check if there are parameters in the URL
      if URI.Params <> '' then
      begin
        // Split the parameters into individual strings
        ParamsList.Delimiter := '&';
        ParamsList.DelimitedText := URI.Params;

        // Build the result string with parameters
        for Param in ParamsList do
        begin
          if Result <> '' then
            Result := Result + ', ';

          Result := Result + Param;
        end;
      end;
    finally
      URI.Free;
    end;
  finally
    ParamsList.Free;
  end;
end;


// GetPurposeFromFirstObject
function GetPurposeFromFirstObject(const JSONObject: TJSONObject): string;
var
  Pair: TJSONPair;
  FirstObject: TJSONObject;
begin
  Result := '';
  if JSONObject.Size > 0 then
  begin
    Pair := JSONObject.Get(0); // Get the first key-value pair
    if Assigned(Pair) and (Pair.jsonValue is TJSONObject) then
    begin
      FirstObject := Pair.jsonValue as TJSONObject;
      // Attempt to find "purpose" key and get its value
      Pair := FirstObject.Get('apipurpose');
      if Assigned(Pair) then
      begin
        // Return the value of the "purpose" key as a string
        Result := Pair.jsonValue.Value;
      end;
    end;
  end;
end;

// GetPurposeValue
function GetPurposeValue(const JSONString: string): string;
var
  JSONObject: TJSONObject;
  JSONPair: TJSONPair;
  JSONArray: TJsonArray;
  jsonValue: TJSONValue;
begin
  Result := '';
  try
    // Parse the main JSON string
    JSONObject := TJSONObject.ParseJSONValue(JSONString) as TJSONObject;
    if Assigned(JSONObject) then
    begin
      try
        // Check if "_parameters" key exists and is a JSON array
        JSONPair := JSONObject.Get('_parameters');
        if Assigned(JSONPair) and (JSONPair.jsonValue is TJsonArray) then
        begin
          JSONArray := JSONPair.jsonValue as TJsonArray;
          // Check if the array has at least one element and the first element is a JSON object
          if (JSONArray.Size > 0) then
          begin
            jsonValue := JSONArray.Get(0);
            if Assigned(jsonValue) and (jsonValue is TJSONObject) then
            begin
              // Get purpose from the first object in the array
              Result := GetPurposeFromFirstObject(jsonValue as TJSONObject);
            end;
          end;
        end
        else
        begin
          // Get purpose from the main JSON object
          Result := GetPurposeFromFirstObject(JSONObject);
        end;
      finally
        // Free the main JSON object
        JSONObject.Free;
      end;
    end;
  except
    on E: Exception do
    begin
      // Handle parsing or other errors
    end;
  end;
end;

