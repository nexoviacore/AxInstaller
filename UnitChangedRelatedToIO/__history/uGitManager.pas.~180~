            ReadErrorList(errmsg);
            httpretry := 0;
            while (httpretry < MaxhttpRetryCount) or (errmsg = '') do
            begin
              // if e.ErrorCode in [408, 421, 425, 429, 500, 502, 503, 504]
              (* A **429 Too Many Requests** response means the server is rate-limiting
