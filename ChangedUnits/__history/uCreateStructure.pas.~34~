        CopyFillGridProperties(NewTransId,RefID);                                   // Axpdef_fillgrid, Axpdef_fillgriddtl
        CopyGenMapProperties(NewTransId,RefID);                                     // Axpdef_genmap, Axpdef_genmapdtl, Axpdef_genmaprowctrl
        Axp.dbm.Commit(Axp.dbm.gf.connectionname);
        Result := '';
      end;
    Except
