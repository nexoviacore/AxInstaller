      ReloadConfig();
      // appwriteln('Configuration reloaded.');
      appwriteln;

      AppWrite('AxInstaller> ');
      // appreadln(Cmd);

{$IFDEF CONSOLE_APP}
      Cmd := ReadInput;
      parseCommand(Cmd);
{$ELSE}
      // RestImp
{$ENDIF};
    end
    else if Pos('list', lowercase(Command)) <> 0 then
    begin
      appwriteln;
      appwriteln('Available Connections ');
      appwriteln('==================');
      JSONText := cfg.Readconfigfile();
      if JSONText = 'empty' then
        appwriteln('Connection not found need to add new connection')
