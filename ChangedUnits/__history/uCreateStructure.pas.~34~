procedure TCreateStructure.AddValuesToFromAPINode(dnode: IXMLNode; fxds: TXDS;fldName : String);
var
  detnode, snode, tmpnode: IXMLNode;
  i: Integer;
  tempstr, substr,wndwhgt,wndwwdh: String;
begin
  detnode := nil;
  snode := nil;
  tmpnode := nil;
  detnode := dnode;
  wndwhgt := fxds.CDS.FieldByName('windowheight').AsString;
  wndwwdh := fxds.CDS.FieldByName('windowwidth').AsString;
  if (wndwhgt = '') then
    detnode.ChildValues[xml_SGHeight] := '0'
  else
    detnode.ChildValues[xml_SGHeight] := wndwhgt;
  if (wndwwdh = '') then
    detnode.ChildValues[xml_SGWidth] := '0'
  else
    detnode.ChildValues[xml_SGWidth] := wndwwdh;
  if (lowercase(fxds.CDS.FieldByName('autoselect').AsString) = 'true') then
    detnode.ChildValues[xml_AutoSelect] := 'True'
  else
    detnode.ChildValues[xml_AutoSelect] := 'False';
  if (lowercase(fxds.CDS.FieldByName('refresh').AsString) = 'true') then
    detnode.ChildValues[xml_Refresh] := 'True'
  else
    detnode.ChildValues[xml_Refresh] := 'False';

  snode := dnode.ChildNodes.FindNode(xml_SQL);
  if snode = nil then snode := dnode;
  if (lowercase(fxds.CDS.FieldByName('combobox').AsString) = 'true') then
    snode.Attributes['txt'] := 'f'
  else
    snode.Attributes['txt'] := 't';
  snode.Attributes['stype'] := fxds.CDS.FieldByName('modeofentry').AsString;
  snode.Attributes['url'] := fxds.CDS.FieldByName('execapiurl').AsString;
  snode.Attributes['paramstr'] := fxds.CDS.FieldByName('execapiparameterstring').AsString;
  snode.Attributes['headerstr'] := fxds.CDS.FieldByName('execapiheaderstring').AsString;
  snode.Attributes['reqstr'] := fxds.CDS.FieldByName('execapirequeststring').AsString;
  snode.Attributes['mapname'] := fxds.CDS.FieldByName('apifieldname').AsString;
  snode.Attributes['restype'] := fxds.CDS.FieldByName('apiresponsetype').AsString;
  snode.Attributes['resformat'] := fxds.CDS.FieldByName('apiresponseformat').AsString;

  detnode := detnode.ChildNodes[xml_source];
  detnode.Attributes['stype'] := 'api';
end;

