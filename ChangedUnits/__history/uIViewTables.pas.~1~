i,j: Integer;
hypnode,temp,pnode : IXMLNode;
hypname,w,b : String;
begin
    for i := 0 to enode.ChildNodes.Count-1 do
    begin
      if (vartostr(enode.ChildNodes[i].Attributes['cat']) = 'hyperlinks') then begin
      hypnode := enode.ChildNodes[i];
      try
        cxds.close;
        for j := 0 to hypnode.ChildNodes.Count-1 do
        begin
          cxds.ClearEdit;
          temp := hypnode.ChildNodes[j];
          cxds.Submit('INAME',iname,'c');
          hypname := VarToStr(temp.NodeName);
          cxds.Submit('HYPNAME',hypname,'c');
          b := VarToStr(temp.Attributes['sname']);
          cxds.Submit('SNAME',b,'c');
          b := VarToStr(temp.Attributes['source']);
          cxds.Submit('HYPSOURCE',b,'c');
          if lowercase(VarToStr(temp.Attributes['pop'])) = 'true' then b := 'T'
          else b := 'F';
