// RemoveSplitCharAndMakeValidJsonStr
function RemoveSplitCharAndMakeValidJsonStr(pInputJsonStr: String): String;
var
  sStrTobeReplaced, sStrReplaceWith: String;
begin
  Result := pInputJsonStr;
  if pInputJsonStr = '' then
    Exit;
  sStrTobeReplaced := '}*$*{';
  sStrReplaceWith := ',';

  pInputJsonStr := ReplaceStr(pInputJsonStr, sStrTobeReplaced, sStrReplaceWith);

  sStrTobeReplaced := '}#$#{';
  pInputJsonStr := ReplaceStr(pInputJsonStr, sStrTobeReplaced, sStrReplaceWith);
  Result := pInputJsonStr;
end;

// EscapeJSONString
// takes a JSON string as input and returns an escaped JSON string as output
function EscapeJSONString(const JSON: string): string;
const
  SpecialChars = ['\', '"', '/', #8, #9, #10, #12, #13];
var
  i: Integer;
  sb: TStringBuilder;
begin
  sb := TStringBuilder.create;
  try
    for i := 1 to Length(JSON) do
    begin
      case JSON[i] of
        '\':
          sb.Append('\\');
        // '"': sb.Append('\"'); //this is not required , else this will replace normal key value "
        '/':
          sb.Append('\/');
        #8:
          sb.Append('\b');
        #9:
          sb.Append('\t');
        #10:
          sb.Append('\n');
        #12:
          sb.Append('\f');
        #13:
          sb.Append('\r');
      else
        if JSON[i] < #32 then
          sb.Append('\u').Append(Format('%.4x', [Ord(JSON[i])]))
        else
          sb.Append(JSON[i]);
      end;
    end;
    Result := sb.ToString;
  finally
    sb.Free;
  end;
end;

// PrepareJsonResult
(*
  This function mainly introduced to handle AxpertJobsAPI response, because where we cannot
  capture proper json result due to its implementation logic.
  This can be used for any other purpose as well if req in the future
*)
function PrepareJsonResult(const endpoint: string;
  const InputData: string): string;
var
  sErrStr: string;
begin
  Result := InputData;
  try
    if IsValidJson(InputData) then
      Exit
    else if (InputData <> '') and (Lowercase(endpoint) <> 'axpertjobsapi') then
    begin
      // If not valid json
      Result := EscapeJSONString(InputData);
    end
    else if (Lowercase(endpoint) = 'axpertjobsapi') then
    begin
      // This will be executed only for axpertjobsapi
      // since Axpertjobs API rerurns empty for success and normal str for error.
      if Trim(InputData) = '' then
        Result := '{"status":"success","msg":"Script executed successfully"}'
      else
      begin
        sErrStr := InputData;
        sErrStr := RemoveSplitCharAndMakeValidJsonStr(sErrStr);
        Result := '{"error":{"status":"failed","msg":"' + sErrStr + '"}}';
      end;
    end;

  finally

  end;
end;

// SaveResponseToDatabase
procedure TAPILoggingHandler.SaveResponseToDatabase(dbm: TDBManager;
  ResponseBody, ErrorMsg: string);
var
  sDateTime, ExecutionTime, ContentLength, endpoint: String;
  OldServerDateTime: TDateTime;
  axds: TXDS;
begin
  if Not Assigned(dbm) then
    Exit;
  RequestEndTime := Now;
  dbm.gf.DoDebug.msg('SaveResponseToDatabase starts...');
  axds := nil;
  try
    axds := dbm.GetXDS(nil);
    try
      axds.close;
      axds.Append('AxResponse');
      axds.Submit('ResponseID', TGuid.NewGuid.ToString, 'c');
      OldServerDateTime := dbm.ServerDateTime;
      // due to ServerDateTime condition in udbmanager its not fetching recent datetime
      // so we used this approach to get the value
      dbm.ServerDateTime := 0;
      sDateTime := DateTimeToStr(dbm.getserverdatetime);
      dbm.ServerDateTime := OldServerDateTime;
      // axds.Submit('Timestamp',sDateTime,'d');  //Timestamp & responseSentTime are same
      axds.Submit('ResponseSentTime', sDateTime, 'd'); //
      endpoint := slWebRequest.Values['Endpoint'];
      ResponseBody := PrepareJsonResult(endpoint, ResponseBody);
      dbm.gf.DoDebug.msg('GetResponseStatus starts');
      axds.Submit('StatusCode', GetResponseStatus(ResponseBody), 'n');
      dbm.gf.DoDebug.msg('GetResponseStatus ends');
      // Responsecode need to be identified
      axds.Submit('ResponseString', ResponseBody, 'c');
      axds.Submit('ContentType', 'application/json', 'c'); // hardcoded
      ContentLength := ProcessandFormatContentSize(ResponseBody);
      axds.Submit('ContentLength', ContentLength, 'c');
      axds.Submit('Headers', ReplaceStr(slWebRequest.Values['ResponseHeader'] +
        'Content-Length=' + ContentLength, '=', ':')
        { IdHTTP.Response.RawHeaders.Text } , 'c');
      ExecutionTime := FormatTimeDifference(RequestStartTime, RequestEndTime);
      axds.Submit('ExecutionTime', ExecutionTime, 'c');
      axds.Submit('ErrorDetails', ErrorMsg, 'c');
      axds.Submit('Endpoint', endpoint, 'c');
      axds.Submit('RequestMethod',
        UpperCase(slWebRequest.Values['RequestMethod']), 'c');
      axds.Submit('UserName', dbm.gf.username, 'c');
      axds.Submit('AdditionalDetails', '', 'c');
      sAPIRequestID := slWebRequest.Values['RequestID'];
      axds.Submit('RequestID', sAPIRequestID, 'c');
      axds.Post;
    except
      on E: Exception do
      begin
        dbm.gf.DoDebug.Log(dbm.gf.Axp_logstr +
          '\uAPILoggingImpl\SaveResponseToDatabase - ' + E.Message);
        dbm.gf.DoDebug.msg(E.Message);
      end;
    end;
  finally
    // finally
    if Assigned(axds) then
    begin
      if axds.Active then
        axds.close;
      FreeAndNil(axds);
    end;
  end;
  dbm.gf.DoDebug.msg('SaveResponseToDatabase ends.');
end;

