function ExtractZipFiles(const zipfilepath: string): string;
var
  zipFiles: TStringDynArray;
  zipFile: TZipFile;
  I: Integer;
  zipPath: string;
  extractPath: string;
begin
  Result := '';

  try
    if not DirectoryExists(zipfilepath) then
      Exit;

    zipFiles := TDirectory.GetFiles(zipfilepath, '*.zip',
      TSearchOption.soAllDirectories);

    for I := 0 to Length(zipFiles) - 1 do
    begin
      zipPath := zipFiles[I];

      extractPath := ExcludeTrailingPathDelimiter(
        ExtractFileDir(zipPath));

      AppWriteln('   - Extracting package ZIP: ' +
        ExtractFileName(zipPath));

      ForceDirectories(extractPath);

      zipFile := TZipFile.Create;
      try
        try
          zipFile.Open(zipPath, zmRead);
          zipFile.ExtractAll(extractPath);
          zipFile.Close;
        except
          on E: Exception do
          begin
            try
              zipFile.Close;
            except
              // Ignore secondary close error.
            end;

            raise Exception.Create(
              'Failed to extract package ZIP ''' +
              ExtractFileName(zipPath) + ''': ' + E.Message);
          end;
        end;
      finally
        zipFile.Free;
      end;

      // Delete the ZIP only after successful extraction.
      if FileExists(zipPath) then
      begin
        DeleteFile(PChar(zipPath));

        // Verify that the ZIP was actually deleted.
        if FileExists(zipPath) then
        begin
          raise Exception.Create(
            'Package ZIP was extracted successfully, but could not be deleted: ' +
            ExtractFileName(zipPath));
        end;
      end;
    end;

  except
    on E: Exception do
    begin
      Console_Write('Error: ' + E.Message, 12);
      raise;
    end;
  end;
end;

