begin
  writeln(self.f1, s);
end;

procedure TCreateStructure.CreatePageXML;
var
  pagecreate: TAutoPageCreate;
  PgXML: IXMLDocument;
begin
  RemoveDefaultPage('tstruct',FName);
//  if not accpage then Exit;

  pagecreate := TAutoPageCreate.Create;
  pagecreate.Axp := Axp;
  {$IFNDEF ForService}
    pagecreate.dtopint := dtopint;
  {$ENDIF}
  pagecreate.sType := 'tstruct';
  pagecreate.Name := FName;
  pagecreate.Caption := FCaption;
  PageCaption := pagecreate.Caption;
  if pos('default', lowercase(FolderName)) = 0 then
    pagecreate.ParentName := FolderName;
  //Assigning bSkipUserAccessDelOnWriteDef to TAutoPageCreate's bSkipUserAccessDelOnWriteDef var
  pagecreate.bSkipUserAccessDelOnWriteDef := bSkipUserAccessDelOnWriteDef;
  pagecreate.SavePageXML;
  if (pagecreate.ParentName <> '') then
  begin
    PgXML := pagecreate.GetPageXML;
    PgXML.DocumentElement.Attributes['name'] := 'PageTs'+FName;
    PgXML.DocumentElement.Attributes['caption'] := FCaption;
    PgXML.DocumentElement.Attributes['ptype'] := 'p';
    PgXML.DocumentElement.Attributes['pgtype'] := 't'+FName;
    FImportDiff.ImportAutoPage(FName, PgXML);
  end;
  pagecreate.Free;
end;

