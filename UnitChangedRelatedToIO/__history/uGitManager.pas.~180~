                    ReadErrorList(errmsg);

                    // If the retry itself returns a non-retryable error, stop retrying.
                    // if (e is EIdHTTPProtocolException) and
                    // not(EIdHTTPProtocolException(e).ErrorCode
                    // in [408, 409, 421, 425, 429, 500, 502, 503, 504, 507])
                    if (E is EIdHTTPProtocolException) and
                      not(IsRetryableHttpError(EIdHTTPProtocolException(E)
                      .ErrorCode)) then
                    begin
                      // If any issue occurs
                      bGitPullIncomplete := True;
                      raise;
                    end;

                  end;
                end;
              end
              else
              begin
                // If any issue occurs
                bGitPullIncomplete := True;
                raise;
              end;
            end;

            if errmsg <> '' then
            begin
              // If any issue occurs
              bGitPullIncomplete := True;
              raise Exception.create(errmsg);
            end;
          end;

          on E: EIdSocketError do
          begin
