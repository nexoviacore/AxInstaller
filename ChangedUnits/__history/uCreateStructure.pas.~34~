procedure TCreateStructure.LoadTransFields(st: TStrings; trgtstruct: String);
var tenode, tpnode: IXMLNode;
    i: Integer;
    gs,dcname: string;
    q,x : TXDS;
begin
  try
  try
    st.Clear;
    mAsGrid := '';
    sourcekeys := '';
    q := nil;
    x := nil;
    q := Axp.dbm.GetXDS(nil);
    q.buffered := True;
    q.CDS.CommandText := 'select name,asgrid from vw_dc where '+Axp.dbm.gf.sqllower+'(transid) = '+QuotedStr(LowerCase(trgtstruct));
    q.open;
    if q.CDS.RecordCount > 0 then begin
      q.CDS.First;
      while not q.CDS.Eof  do begin
        dcname := q.CDS.FieldByName('name').AsString;
        gs := lowercase(copy(q.CDS.FieldByName('asgrid').AsString, 1, 1));

        x :=  Axp.dbm.GetXDS(nil);
        x.buffered := True;
        x.CDS.CommandText := 'select name,sourcekey,savenormalized from vw_field_informations where '+Axp.dbm.gf.sqllower+'(transid) = '
                             +QuotedStr(LowerCase(trgtstruct))+' and '+Axp.dbm.gf.sqllower+'(dcname) = '+QuotedStr(LowerCase(dcname))+
                             ' order by sordno';
        x.open;
        if x.CDS.RecordCount > 0 then begin
          x.CDS.First;
          while not x.CDS.Eof  do begin
            st.Add(x.CDS.FieldByName('name').AsString);
            sourcekeys := sourcekeys + ifthen((Lowercase(x.CDS.FieldByName('sourcekey').AsString)) = 'true','T','F');
  //          copy(x.CDS.FieldByName('savenormalized').AsString, 1, 1);
            mAsGrid := mAsGrid + gs;
            x.CDS.Next;
          end;
        end;
        q.CDS.Next;
      end;
    end
    else
      raise Exception.Create('Post to tstruct/form ('+trgtstruct+') is not available.');
  except
    on E: Exception do
    begin
      errstr := copy(E.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create(errstr);
    end;
  end;
  finally
    if assigned(q) then
    begin
      q.close;
      FreeAndNil(q);
    end;
    if assigned(x) then
    begin
      x.close;
      FreeAndNil(x);
    end;
  end;
end;

procedure TCreateStructure.ImportStructure;
begin
  try
    writeintolog('ImportStructure Starts');
    {$IFNDEF ForService}
      AssignFile(f1,ExtractFilePath(application.ExeName)+'import.txt');
    {$ELSE}
      AssignFile(f1,Axp.dbm.gf.exepath+'\import.txt');
      WriteInToLog(Axp.dbm.gf.exepath+'\import.txt');
    {$ENDIF}
    rewrite(f1);
    WriteInToLog('1');
    CreateImportObjects;
    WriteInToLog('2');
    if assigned(inode) then
      FImportDiff.inode := inode;
    FImportDiff.servicename := servicename;
    (*
     Based on bImportOnlyXMLandCreateTransactionTables variable value Import structure functionality will differ.
     When bImportOnlyXMLandCreateTransactionTables is true then only XML and Transaction tables will get created
     else normal structure import will happen.
    *)
    if bImportOnlyXMLandCreateTransactionTables then
    begin
      (*
      When calling from service CompareOnly boolean var value will be set to false on Create of FImportDiff / FImportStructDef.
      But when bImportOnlyXMLandCreateTransactionTables is true then CompareOnly value will be always false , so assigning false here.
      else scripts will be written in SQLScriptList StringList when calling CreateTable / CreateDC.
      *)
      FImportDiff.CompareOnly := False;
      FImportStructDef.CompareOnly := False;
      FImportDiff.ImportStructXMLandCreateTransactionTables(FName,fxml)
    end
    else
      FImportDiff.ImportStructure(FName,fxml);
    WriteInToLog('5');
    if (not bSkipPageCreation) and (not chkpageexists(FName)) then
    begin
      CreatePageXML;
    end;
  finally
    CloseFile(f1);
  end;
  writeintolog('ImportStructure Ends');
end;

