Procedure TCreateStructure.ResetOtherPages(PrvOrd,NewOrd : Integer; pName : String);
begin
  if PrvOrd > NewOrd then
    axp.ExecSQL('update axpages set ordno = ordno+1 where ordno between '+IntToStr(NewOrd)+' and '+
    IntToStr(PrvOrd-1) + ' and '+Axp.dbm.gf.sqllower+'(name) <> '+ QuotedStr(LowerCase(pName)),'','',False)
  else if PrvOrd < NewOrd then begin
    if PrvOrd = 0 then
      axp.ExecSQL('update axpages set ordno = ordno+1 where ordno between '+IntToStr(NewOrd)+' and '+
      '(select max(ordno) from axpages) and '+Axp.dbm.gf.sqllower+'(name) <> '+ QuotedStr(LowerCase(pName)),'','',False)
    else
      axp.ExecSQL('update axpages set ordno = ordno-1 where ordno between '+IntToStr(PrvOrd+1)+' and '+
      IntToStr(NewOrd) + ' and '+Axp.dbm.gf.sqllower+'(name) <> '+ QuotedStr(LowerCase(pName)),'','',False);
  end;
end;

