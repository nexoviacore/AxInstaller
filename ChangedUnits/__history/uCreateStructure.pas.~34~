procedure TCreateStructure.FillSourceField(tval: TStrings);
var
  tenode, tpnode: IXMLNode;
  i: Integer;
  gs: string;
begin
  tval.Clear;
  tasgrid := '';
  tFldTypes := '';
  for i := 0 to enode.ChildNodes.Count - 1 do
  begin
    tpnode := enode.ChildNodes.Nodes[i];
    if not tpnode.HasAttribute('cat') then
      continue;
    if tpnode.Attributes['cat'] = 'dc' then
    begin
      tval.Add(tpnode.ChildNodes.Nodes[xml_Table].Text + 'id');
      tFldTypes := tFldTypes + 'N';
      gs := lowercase(copy(tpnode.ChildNodes.Nodes[xml_AsGrid].Text, 1, 1));
      tasgrid := tasgrid + gs;
    end;
    if (tpnode.Attributes['cat'] = 'field') and
      (lowercase(VarToStr(tpnode.NodeName)) <> 'axp_attach') then // ch1
    begin
      tval.Add(VarToStr(tpnode.NodeName));
      tFldTypes := tFldTypes +
        copy(tpnode.ChildNodes[xml_DataType].NodeValue, 1, 1);
      tasgrid := tasgrid + gs;
    end;
  end;
  tenode := nil;
  tpnode := nil;
end;

