procedure TCreateStructure.SetMapFieldsValues(gnode: IXMLNode; mapping: String);
// need to send target transid as parameter
var
  f1node, tmpnode: IXMLNode;
  i, j, ind: Integer;
  s, ord, ftype, skey, targettstruct, mapsubstr,tmpstr : String;
  sourcefrom, source, fsource, sourcedcasgrid, targetfield, targetrow: String;
  tgxds: TXDS;
begin
  FillSourceField(gensrclist);
  targettstruct := VarToStr(gnode.ChildNodes[xml_GenTarget].NodeValue);
  LoadTransFields(gentarlist,tarTRANSID);
  f1node := gnode.ChildNodes.FindNode(xml_GMap);
  // sourcefrom,source,fsource,sourcedcasgrid,targetfield,targetrow -- source field will be empty for - field

  i := 1;
  mapsubstr := Axp.dbm.gf.GetNthString(mapping, 1, '$');
  while (mapsubstr <> '') do
  begin
    sourcefrom := lowercase(Axp.dbm.gf.GetNthString(mapsubstr, 1, ','));
    source := Axp.dbm.gf.GetNthString(mapsubstr, 2, ',');
    fsource := Axp.dbm.gf.GetNthString(mapsubstr, 3, ',');
    sourcedcasgrid := Axp.dbm.gf.GetNthString(mapsubstr, 4, ',');
    targetfield := Axp.dbm.gf.GetNthString(mapsubstr, 5, ',');
    targetrow := Axp.dbm.gf.GetNthString(mapsubstr, 6, ',');
    tmpnode := f1node.AddChild(targetfield);
    tmpnode.Attributes['trow'] := targetrow;
    ind := gensrclist.IndexOf(fsource);
    ftype := tFldTypes[ind + 1];
    ind := gentarlist.IndexOf(targetfield);
    skey := sourcekeys[ind + 1];
    s := '';
    ord := '';
    if (lowercase(mAsGrid[ind + 1]) = 't') then
    begin
      for j := 0 to RowCtrlFlds.Count - 1 do
      begin
//        if (lowercase(RowCtrlFlds.ValueFromIndex[j]) = lowercase(targetrow))
        tmpstr := RowCtrlFlds.ValueFromIndex[j];
        if (RowCtrlFlds.names[j] = targetrow) then
        begin
//          s := RowCtrlFlds.Names[j];
          s := tmpstr;
          ord := IntToStr(j + 1);
          break;
        end;
      end;
    end;
//    if (VarToStr(gnode.ChildValues['Based On DC']) = '') then    xml_GenParent
    if (VarToStr(gnode.ChildValues[xml_GenParent]) = '') then
    begin
      if (targetrow = '0') then
      begin
        if (lowercase(sourcefrom) = 'value') then
          tmpnode.Attributes['srow'] := '0'
        else if (lowercase(sourcefrom) = 'field') then
        begin
          ind := gensrclist.IndexOf(source);
          if (tasgrid[ind + 1] = 't') then
            tmpnode.Attributes['srow'] := '0'
          else
            tmpnode.Attributes['srow'] := '1';
        end
        else
          tmpnode.Attributes['srow'] := '1';
      end
      else
        tmpnode.Attributes['srow'] := '1'
    end
    else
    begin
      if (lowercase(sourcefrom) = 'field') then
      begin
//        ind := gensrclist.IndexOf(source);
        ind := gensrclist.IndexOf(fsource);
        if (tasgrid[ind + 1] = 't') then
          tmpnode.Attributes['srow'] := '0'
        else
          tmpnode.Attributes['srow'] := '1';
      end
      else if (lowercase(sourcefrom) = 'id') then
        tmpnode.Attributes['srow'] := '1';
    end;

    if (lowercase(sourcefrom) = 'value') then
    begin
      if (lowercase(sourcedcasgrid) = 't') then
        tmpnode.Attributes['srow'] := '0'
      else
        tmpnode.Attributes['srow'] := '1';
    end;
    tmpnode.Attributes['control'] := s;
    tmpnode.Attributes['group'] := '';
    // tmpnode.Attributes['group']   := tgxds.CDS.FieldByName('groupfield').AsString;  //need to add group field at structure
    tmpnode.Attributes['type'] := sourcefrom;
    tmpnode.Attributes['ord'] := ord;
    if ((lowercase(sourcefrom) = 'field') and (skey = 'T') and (ftype = 'N')) then
      tmpnode.Attributes['id'] := 'True'
    else
      tmpnode.Attributes['id'] := 'False';
    ind := 0;
    if LowerCase(sourcefrom) = 'field' then
      tmpnode.NodeValue := fsource
    else tmpnode.NodeValue := source;
    inc(i);
