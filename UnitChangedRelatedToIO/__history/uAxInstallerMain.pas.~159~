              appwriteln;
              Console_write('Current active connection :', 14);
              Console_write(activeconnection, 10);
              appwriteln;
              Break;

            end;
          if Not bSkipReadCmd then
          begin
{$IFDEF CONSOLE_APP}
            Command := instBeforeReadCommand;
            parseCommand(Command);
{$ELSE}
{$ENDIF};
          end;

        end;
        if Confound = False then
        begin
          appwriteln('Please check your app name ');
          AppWrite('AxInstaller> ');
          // appreadln(Cmd);

{$IFDEF CONSOLE_APP}
          Cmd := ReadInput;
          parseCommand(Cmd);
{$ELSE}
{$ENDIF};
        end;
      end;
    end
    else if Pos('new', lowercase(Command)) <> 0 then
    begin
      if not assigned(cfg) then
        cfg := TConfig.Create;
      cfg.FillUserInfo();
      cfg.readactiveconnection();
      // console_write('Connection added successfully :' + projectname, 14);
      appwriteln;
      appwriteln;
      AppWrite('AxInstaller> ');
      // appreadln(Command);
{$IFDEF CONSOLE_APP}
      Command := ReadInput;
      parseCommand(Command);
{$ELSE}
{$ENDIF};
    end
    else if Pos('edit', lowercase(Command)) <> 0 then
    begin
      // configeditflag:=true;
      if not assigned(cfg) then
        cfg := TConfig.Create;
      cfg.configeditflag := True;
      cfg.FillUserInfo();

      Console_write('Connection updated successfully..!', 14);
      appwriteln;
      appwriteln;
      AppWrite('AxInstaller> ');
      // appreadln(Command);
{$IFDEF CONSOLE_APP}
      Command := ReadInput;
      parseCommand(Command);
{$ELSE}
{$ENDIF};
    end
    else if Pos('delete', lowercase(Command)) <> 0 then
    begin
      JSONText := cfg.Readconfigfile();
      try
        commandstrlist := TStringList.Create;
        commandstrlist.Delimiter := ' ';
        commandstrlist.DelimitedText := Command;
        app := commandstrlist[2];
      Except
        on E: Exception do
        begin
          appwriteln;
          appwriteln('Please check given command once again ');
          appwriteln;
          AppWrite('AxInstaller> ');
          // appreadln(Cmd);
{$IFDEF CONSOLE_APP}
          Cmd := ReadInput;
          parseCommand(Cmd);
{$ELSE}
{$ENDIF};
        end;

      end;
      app := Trim(app);
      if JSONText = 'empty' then
        appwriteln('Connection not found need to add new connection')
      else
      begin
        if lowercase(app) = lowercase(activeconnection) then
        begin
          Console_write('You cannot delete active connection', 12);
          appwriteln;
          appwriteln;
          AppWrite('AxInstaller> ');
          // appreadln(Command);
{$IFDEF CONSOLE_APP}
          Command := ReadInput;
          parseCommand(Command);
{$ELSE}
{$ENDIF};
        end
        else
        begin
          JSONObject := TJSONObject.ParseJSONValue(JSONText) as TJSONObject;
          AppJSONObject := JSONObject.Get('appsettings')
            .JsonValue as TJSONObject;
          for Pair in AppJSONObject do
            if lowercase(Pair.JSONString.Value) = lowercase(app) then
            begin
              AppJSONObject.removepair(Pair.JSONString.Value);
              AssignFile(UserJsonFile, AppDir + 'appsetting.config');
              Rewrite(UserJsonFile);
              TotalJSONText := JSONObject.ToString;
              TotalJSONText := StringReplace(JSONObject.ToString, '\', '\\',
                [rfReplaceAll, rfIgnoreCase]);
              appwriteln(UserJsonFile, TotalJSONText);
              CloseFile(UserJsonFile);
              Console_write
                ('Connection Deleted from Appsettings successfully..! ', 14);

              // Deletes the conn details from axapps
              projectname := app;
              database.removingconfromaxapps;
              appwriteln;
              Console_write
                ('Connection Deleted from AxApps successfully..! ', 14);
            end;

          appwriteln;
        end;
      end;
      appwriteln;
      AppWrite('AxInstaller> ');
      // appreadln(Command);
{$IFDEF CONSOLE_APP}
      Command := ReadInput;
      parseCommand(Command);
{$ELSE}
{$ENDIF};

    end;
  finally
    FreeAndNil(cfg);
  end;
end;

