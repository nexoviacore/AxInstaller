procedure TCreateStructure.SaveStructure(stransid: String);
var
  tmnode,oenode: IXMLNode;
  userdesigned: Boolean;
  Ht, Lt, wt, Top1, Top2: Integer;
  t, stype : String;
  q : TXDS;
  oxml : ixmldocument;
begin
  writeintolog('SaveStructure starts');
  tmnode := nil;
  oenode := nil;
  oxml := nil;
  FName := stransid;
  LoadPropsXML;

  //Load existing structure xml
  try
    oxml := Axp.GetStructure('tstructs',stransid,'','');
  except
  end;
  if assigned(oxml) then begin
    oenode := oxml.DocumentElement;
    if assigned(oenode) then begin
      actnode := oenode.ChildNodes.FindNode('actions');
      //dtasknode := oenode.ChildNodes.FindNode('dtasks');
    end;
  end;
  fxml := LoadXMLData('<root pform="yes"></root>');
  enode := fxml.DocumentElement;
  LoadTstructProperties;
  LoadDCProperties;
  LoadMDMapProperties;
  //LoadDesktopActionProperties;
  LoadActionScriptProperties;
  if lowercase(FName) <> 'axglo' then LoadAxpConfigProperties;
  //Set CreatePage True when IncludePage is t/true
  if (Lowercase(sIncludePage) = 't') or (Lowercase(sIncludePage) = 'true') then
     CreateDefPage := True;
  if CreateDefPage then // linked with core structure
    fxml.DocumentElement.Attributes['defpage'] := 'n'
  else
    fxml.DocumentElement.Attributes['defpage'] := 'y';
  t := axp.dbm.gf.convertToDBDateTime(axp.dbm.connection.dbtype,axp.dbm.getserverdatetime);
  if not IsStructExists(FName) then
  begin
    fxml.DocumentElement.Attributes['createdon'] := t;
    fxml.DocumentElement.Attributes['createdby'] := axp.dbm.gf.username;
  end;
  fxml.DocumentElement.Attributes['updatedon'] := t;
  fxml.DocumentElement.Attributes['updatedby'] := axp.dbm.gf.username;
  cnode := enode.ChildNodes.FindNode('comps');
  if not assigned(cnode) then
  begin
    cnode := enode.AddChild('comps');
    cnode.Attributes['cat'] := 'comps';
    tmnode := cnode.AddChild('x__headtext');
    tmnode.Attributes['t'] := 'lbl';
    tmnode.Attributes['p'] := 'x__heading';
    tmnode.Attributes['c'] := 'Test11';
    tmnode.Attributes['tlhw'] := '5,3,19,56';
    tmnode.Attributes['color'] := '';
    tmnode.Attributes['font'] := 'Tahoma,12,tfff';
  end;
  stype := 'tstruct';
  q := TXDS.Create('q', nil, axp.dbm.Connection, axp.dbm.gf);
  q.buffered := True;
  q.CDS.CommandText := 'select title,key,folder,action,task,script,icon,parent,haschildren,ordno,footer,visible,position from AxToolBar where name = '+
                            QuotedStr(Fname) + ' and stype = ' + QuotedStr(stype) + ' and (parent is null or parent = '''') order by ordno';
  q.open;
  if q.CDS.RecordCount > 0 then
    LoadToolBarToCompsNode(q,cnode,IntToStr(q.CDS.RecordCount))
  else
    LoadCompsNode(cnode);
  if assigned(q) then
  begin
    q.close;
    q.Destroy;
  end;
  inode := enode.ChildNodes.FindNode('iframes');
  userdesigned := assigned(inode);
  if not userdesigned then
  begin
    inode := enode.AddChild('iframes');
    inode.Attributes['cat'] := 'iframes';
//    inode.Attributes['layout'] := 'default';
    if (lowercase(layout) = 'header tabbed') then
      inode.Attributes['layout'] := 'single'
    else if (lowercase(layout) = 'header tabbed footer') then
      inode.Attributes['layout'] := 'double'
    else
      inode.Attributes['layout'] := lowercase(layout);
  end;
  Top1 := 0; Ht := 0; Top2 := 89 + 30; wt := 0; Lt := 0;
  inode := enode.ChildNodes.FindNode('iframes');

  (*
  bSkipSaveStructureToDB boolean var introduced to skip save structure into DB.
  The purpose is , we need XML for comparision before updating this changes to core structure table.
  Thats why , we introduced  bSkipSaveStructureToDB var.
  By defualt it will be false , where ONLY XML is required in that calling point we may need to set this var true.
  So after preparing the XML we can access it from anywhere by using public XMLDOC fmxl.

  The reason for introducing boolean var to handle this implmementaion is that existing functionality / calling points
  should not get affect due to this change.

  on 13 May 2021,
  Structure diff was removed so bSkipSaveStructureToDB not used now.Keeping this code for future purpose.
  *)
  if bSkipSaveStructureToDB then
    Exit;

  ImportStructure;
//  fxml.SaveToFile('E:\ASBDefine Rest as on 03052018\test1.xml');
  (*
   Lviews table will get update when doing publish. so Recreation is not required at that time of Publish.
   we introduced bSkipLviewCreationONPublish var to handle lview creation
  *)
  if Not bSkipLviewCreationONPublish then
  begin
    if createlview then
    begin
      DeleteListView(FName);
      CreateListView;
    end
    else
      DeleteListView(FName);
  end;
//  if ((lowercase(menupos) = 'insert before') or (lowercase(menupos) = 'insert after')) then
//    UpdatePageOrder;
//  UpdatePagesByPosition;
  if tsIcon <> '' then
    SetTstructIcon;
  oxml := nil;
  writeintolog('SaveStructure ends');
end;

Function TCreateStructure.CheckFieldExists(trnsid : String):String;
var
dcname : String;
begin
  Try
    result := '';
    MXDS.close;
    MXDS.CDS.CommandText := 'select name from vw_dc where '+Axp.dbm.gf.sqllower+'(transid)=:stransid ';
    //'select name from vw_dc where '+Axp.dbm.gf.sqllower+'(transid)=:stransid order by name asc';
    MXDS.AssignParam(0,lowercase(trnsid), 'c');
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
      MXDS.CDS.First;
      while not MXDS.CDS.Eof  do
      begin
        dcname := MXDS.CDS.FieldByName('name').AsString;
        if not CheckFieldExistsInView(dcname) then
        begin
          result := 'Unable to Create Structure - '+dcname+' should have atleast one field';
          break;
        end;
        MXDS.CDS.Next;
      end;
    end;
    MXDS.close;
  except on E:Exception do
    begin
      errstr := e.message;
      if (errstr <> '') then
        raise Exception.Create(errstr);
    end;
  End;
end;

//GetPageFolderName - get Foldername and ordnum for page
(*
  These statements were taken from LoadTstructProperties and created as separate procedure for making this
  functionality reusable.
  GetPageFolderName called from LoadTstructProperties and WriteTStructDef.
*)
Procedure TCreateStructure.GetPageFolderName;
var
  pMenuList,sname,shead : String;
begin
    accpage := not CreateDefPage;
    OrdNum := GetPrvOrd(FName,LvlNum);
    if lowercase(menupos) = 'default' then
    begin
      FolderName := 'Default';
//      OrdNum := GetPrvOrd(FName);
    end
    else if lowercase(menupos) = 'add under' then
    begin
//      FolderName := FetchPageID(FName);   // to get the parent name from axpages table
      MXDS.CDS.CommandText := 'select parent from axpages where '+Axp.dbm.gf.sqllower+'(name)='+QuotedStr(lowercase('PageTs'+FName));
      MXDS.open;
      if MXDS.CDS.RecordCount > 0 then
        FolderName := MXDS.CDS.FieldByName('parent').AsString;
      //if (shead = '') and (FolderName = '') then
      //  FolderName := 'Default';
      MXDS.close;
    end else if ((lowercase(menupos) = 'insert after') or (lowercase(menupos) = 'insert before')) then
    begin
      pMenuList := Copy(menulist,2,(length(menulist)-1));
      if POS('\',pMenuList) < 1 then
      begin
        FolderName := 'Default';
//        OrdNum := GetPrvOrd(FName);
      end
      else begin
        sname := ExtractFileName(menulist);
//          spath := ExtractFileDir(menulist);
//          shead := ExtractFileName(spath);
        MXDS.CDS.CommandText := 'select parent from axpages where '+Axp.dbm.gf.sqllower+'(caption)='+QuotedStr(lowercase(sname));
        MXDS.open;
        if MXDS.CDS.RecordCount > 0 then
          FolderName := MXDS.CDS.FieldByName('parent').AsString;
        if (shead = '') and (FolderName = '') then
          FolderName := 'Default';
        MXDS.close;
      end;
    end;
end;


procedure TCreateStructure.LoadTstructProperties;
var
  fnode, tcnode, tmpnode, tctnode: IXMLNode;
  tempstr, substr, tkchg, spath: String;
  i: Integer;
begin
  Try
    DXDS.close;
    DXDS.CDS.CommandText := 'select * from vw_tstructs where '+Axp.dbm.gf.sqllower+'(transid)=:ntransid';
    DXDS.AssignParam(0, lowercase(FName), 'c');
    DXDS.open;
    if (DXDS.CDS.RecordCount > 0) then
    begin
      fnode := enode.AddChild(FName);
      AddDefNodes('form', fnode);
      fnode.Attributes['cat'] := 'tstruct';
      fnode.ChildValues[xml_Name] := FName;
      FCaption := DXDS.CDS.FieldByName('caption').AsString;
      fnode.ChildValues[xml_Caption] := FCaption;
      fnode.ChildValues[xml_SaveControl] := DXDS.CDS.FieldByName('savecontrol').AsString;
      fnode.ChildValues[xml_DelControl] := DXDS.CDS.FieldByName('deletecontrol').AsString;
      tcnode := nil;
      tcnode := fnode.ChildNodes.FindNode(xml_Track);
      layout := DXDS.CDS.FieldByName('layouttype').AsString;
      if (layout = '') then
        layout := 'default';
      tkchg := lowercase(DXDS.CDS.FieldByName('trackchanges').AsString);
      if tkchg = 'true' then
      begin
        tcnode.Attributes['tchng'] := 'y';
        tcnode.Attributes['track'] := 't';
        if (lowercase(DXDS.CDS.FieldByName('trackchangesmadeby').AsString) = 'all users') then
          tcnode.Attributes['ausers'] := 't'
        else
        begin
          tctnode := tcnode.AddChild(xml_TrackUsers);
          tempstr := DXDS.CDS.FieldByName('selectuserlist').AsString;
          if (tempstr <> '') then
          begin
            i := 1;
            substr := Axp.dbm.gf.GetNthString(tempstr, i, ',');
            while (substr <> '') do
            begin
              tmpnode := nil;
              tmpnode := tctnode.AddChild('l' + IntToStr(i));
              tmpnode.NodeValue := substr;
              inc(i);
              substr := Axp.dbm.gf.GetNthString(tempstr, i, ',');
            end;
          end;
        end;
        tempstr := '';
//        tctnode := nil;
        if (lowercase(DXDS.CDS.FieldByName('trackchangesfield').AsString) = 'all fields') then
          tcnode.Attributes['aflds'] := 't'
        else
        begin
          tctnode := tcnode.AddChild(xml_TrackFields);
          tempstr := DXDS.CDS.FieldByName('selectfieldlist').AsString;
          if (tempstr <> '') then
          begin
            i := 1;
            substr := Axp.dbm.gf.GetNthString(tempstr, i, ',');
            while (substr <> '') do
            begin
              tmpnode := nil;
              tmpnode := tctnode.AddChild('l' + IntToStr(i));
              tmpnode.NodeValue := substr;
              inc(i);
              substr := Axp.dbm.gf.GetNthString(tempstr, i, ',');
            end;
          end;
        end;
      end
      else
        fnode.ChildValues[xml_Track] := 'False';
      if (lowercase(DXDS.CDS.FieldByName('attachment').AsString) = 'true') then
        fnode.ChildValues[xml_Attach] := 'True'
      else
        fnode.ChildValues[xml_Attach] := 'False';
      if (lowercase(DXDS.CDS.FieldByName('listview').AsString) = 'true') then
      begin
        fnode.ChildValues[xml_ListView] := 'True';
        createlview := True;
      end
      else
      begin
        fnode.ChildValues[xml_ListView] := 'False';
        createlview := False;
      end;
      if (lowercase(DXDS.CDS.FieldByName('workflow').AsString) = 'true') then
      begin
        fnode.ChildValues[xml_WorkFlow] := 'True';
        fxml.DocumentElement.Attributes['wflow'] := 'T';
      end
      else
      begin
        fnode.ChildValues[xml_WorkFlow] := 'False';
        fxml.DocumentElement.Attributes['wflow'] := 'F';
      end;
      fnode.ChildValues[xml_Schema] := DXDS.CDS.FieldByName('schema').AsString;
//      fnode.ChildValues[xml_Purpose] := trim(DXDS.CDS.FieldByName('purpose').AsString);
      if trim(DXDS.CDS.FieldByName('purpose').AsString) <> '' then begin
        if not assigned(fnode.ChildNodes.FindNode(xml_Purpose)) then
          fnode.AddChild(xml_Purpose).AddChild('l').NodeValue := trim(DXDS.CDS.FieldByName('purpose').AsString)
        else fnode.ChildNodes.FindNode(xml_Purpose).AddChild('l').NodeValue := trim(DXDS.CDS.FieldByName('purpose').AsString);
      end else fnode.ChildValues[xml_Purpose] := '';
      CreateDefPage := (lowercase(DXDS.CDS.FieldByName('isacoretrans').AsString) = 'yes');
      sIncludePage := DXDS.CDS.FieldByName('includepage').AsString;
      menupos := lowercase(DXDS.CDS.FieldByName('menuposition').AsString);  // insert before,insert after,insert under
      menulist := lowercase(DXDS.CDS.FieldByName('menulist').AsString);
      (*
      bSkipPageRelatedProcess boolean variable introduced to SKIP Page related process at the time of READTSTRUCTDEF.
      So this will be true only when the call is from READTSTRUCTDEF.

      But at the same time we need to execute this same process at the time of WRITETSTRUCTDEF ,
      For that we required menupos and menulist values . So this needs to be updated in STRUTCURE XML.
      So when calling WRITETSTRUCTDEF with STRUCTURE XML , we can execute this page related process.
      *)
      if Not bSkipPageRelatedProcess then
      begin
  //      accpage := (lowercase(DXDS.CDS.FieldByName('ismenuaccess').AsString) = 'yes');
        GetPageFolderName;
      end;
    end
    else
      raise Exception.Create('TStruct('+FName+') details not found.');
  except
    on e: Exception do
    begin
      errstr := copy(e.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create(errstr);
    end;
  end;
end;

procedure TCreateStructure.LoadDCProperties();
var
  fnode: IXMLNode;
  dcname: String;
begin
  Try
    dcname := '';
    MXDS.close;
    (*
    Order by clause removed since it was ordering the data based on dcname and its a varchar field. its failed to order data
    when dc count goes more than 9.
    This order by need to be handled in view itself, so the required filtering and ordering will be done in the view definition.
    only data will be fecthed from the view. This way is better to handle if any changes need to be done the data level. Instead
    of changing in DLL, only view definition change is enough to control these data.
    *)

    MXDS.CDS.CommandText := 'select * from vw_dc where '+Axp.dbm.gf.sqllower+'(transid)=:stransid';
    //'select * from vw_dc where '+Axp.dbm.gf.sqllower+'(transid)=:stransid order by name asc';
    MXDS.AssignParam(0,lowercase(FName), 'c');
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        dcname := MXDS.CDS.FieldByName('name').AsString;
        fnode := enode.AddChild(dcname);
        AddDefNodes('frame',fnode);
        fnode.Attributes['cat'] := 'dc';
        fnode.ChildValues[xml_Name] := dcname;
        fnode.ChildValues[xml_Caption] := MXDS.CDS.FieldByName('caption').AsString;
        fnode.ChildValues[xml_FrameNo] := copy(dcname,3,Length(dcname));
        fnode.ChildValues[xml_Table] := MXDS.CDS.FieldByName('tablename').AsString;
        if lowercase(MXDS.CDS.FieldByName('asgrid').AsString) = 'true' then
          fnode.ChildValues[xml_AsGrid] := 'True'
        else
          fnode.ChildValues[xml_AsGrid] := 'False';
        if lowercase(MXDS.CDS.FieldByName('allowchange').AsString) = 'true' then
          fnode.ChildValues[xml_AllowChange] := 'True'
        else
          fnode.ChildValues[xml_AllowChange] := 'False';
        if lowercase(MXDS.CDS.FieldByName('adddcrows').AsString) = 'true' then
          fnode.ChildValues[xml_AddDcRows] := 'True'
        else
          fnode.ChildValues[xml_AddDcRows] := 'False';
        if lowercase(MXDS.CDS.FieldByName('deletedcrows').AsString) = 'true' then
          fnode.ChildValues[xml_DeleteDcRows] := 'True'
        else
          fnode.ChildValues[xml_DeleteDcRows] := 'False';
        fnode.ChildValues[xml_PopUp] := 'False';
        if lowercase(MXDS.CDS.FieldByName('allowempty').AsString) = 'true' then
          fnode.ChildValues[xml_DcAllowEmpty] := 'True'
        else
          fnode.ChildValues[xml_DcAllowEmpty] := 'False';
        fnode.ChildValues[xml_Purpose] := trim(MXDS.CDS.FieldByName('purpose').AsString);
        //Load field properties to XML / based on DC
        LoadFieldProperties(dcname);
        //Load fillgrid properties to XML / based on DC
        LoadFillGridProperties(dcname);
        //Load GenMap properties to XML / based on DC
        //LoadGenMapProperties(dcname);
//        LoadMDMapProperties(dcname);
        MXDS.CDS.Next;
      end;
      //After loading all the fields LoadGenMapProperties will be called.
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        dcname := MXDS.CDS.FieldByName('name').AsString;
        LoadGenMapProperties(dcname);
        MXDS.CDS.Next;
      end;
    end
    else
      raise Exception.Create('DC details not found for TStruct('+FName+').');
  except
    on e: Exception do
    begin
      errstr := copy(e.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create(dcname+' - '+errstr);
    end;
  End;
end;

Procedure TCreateStructure.LoadActionScriptProperties;
var fnode, anode, bnode, dnode, ScriptNode: IXMLNode;
    i,maxNodes: Integer;
    actname, IsFormControl: String;
    ScriptDet : TStringList;
begin
  try
  try
    writeintolog('Script Node append started...');
    ScriptDet := TstringList.Create;
    if Not bSkipActionNodePreparation then
      LoadActionNode;
    MXDS.close;
    MXDS.CDS.CommandText := 'select * from axpdef_script where ' + Axp.dbm.gf.sqllower + '(stransid)=:stransid order by name asc';
    MXDS.AssignParam(0, lowercase(FName), 'c');
    writeintolog(MXDS.CDS.CommandText);
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
//      fnode := enode.ChildNodes.FindNode('actions');
//      if not assigned(fnode) then begin
        fnode := enode.AddChild('scripts');
        fnode.Attributes['cat'] := 'actions';
//      end;
      writeintolog('fnode : ' + fnode.XML);
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        actname := MXDS.CDS.FieldByName('name').AsString;
        anode := fnode.AddChild(actname);
        anode.Attributes['cap'] := MXDS.CDS.FieldByName('caption').AsString;
        anode.Attributes['type'] := 'tstruct';
        anode.Attributes['apply'] := MXDS.CDS.FieldByName('event').AsString;
        anode.Attributes['applyon'] := MXDS.CDS.FieldByName('object').AsString;
        anode.Attributes['sname'] := FName;
        anode.Attributes['scripts'] := 'yes';
        IsFormControl :=  MXDS.CDS.FieldByName('control_type').AsString;
        anode.Attributes['desc'] := '';
        anode.Attributes['failmessage'] := '';
        anode.Attributes['validate'] := 'no';//MXDS.CDS.FieldByName('validate').AsString;
        if LowerCase(IsFormControl) = 't' then anode.Attributes['formcontrol'] := 'true'
        else anode.Attributes['formcontrol'] := 'false';//MXDS.CDS.FieldByName('web').AsString;
        anode.Attributes['breakonerror'] := 'no';//MXDS.CDS.FieldByName('breakonerror').AsString;
        writeintolog('anode : ' + anode.XML);
        DXDS.close;
        DXDS.CDS.CommandText := 'select * from axpdef_script where ' + Axp.dbm.gf.sqllower + '(stransid)= ' + QuotedStr(Lowercase(FName)) +  
          ' and name = ' + QuotedStr(actname);
        writeintolog(DXDS.CDS.CommandText);
        DXDS.open;
        if (DXDS.CDS.RecordCount > 0) then
        begin
          i := 1;
          DXDS.CDS.First;
          while not DXDS.CDS.Eof do
          begin
            bnode := anode.AddChild('r' + IntToStr(i));
            bnode.Attributes['id'] := 'a' + IntToStr(i);
            bnode.Attributes['op'] := '5';
            bnode.Attributes['task'] := 'scripts';
            bnode.Attributes['type'] := '';
            bnode.Attributes['sname'] := '';
            bnode.Attributes['apply'] := '';
            bnode.Attributes['applyon'] := '';
            writeintolog('bnode : ' + bnode.XML);
            dnode := bnode.AddChild('param' + IntToStr(i));
            dnode.Attributes['task'] := 'scripts';
            dnode.Attributes['op'] := '7';
            writeintolog('dnode : ' + dnode.XML);
            ScriptDet.Text := DXDS.CDS.FieldByName('exp_editor_script').AsString;
//            ScriptDet := Axp.dbm.gf.FindAndReplace(ScriptDet,#$D#$A,'');
//            ScriptDet := Axp.dbm.gf.FindAndReplace(ScriptDet,#$A,'');
            if ScriptDet.Text <> '' then
            begin
              ScriptNode := dnode.AddChild('exprset');
              ScriptNode := ListOutExpression(ScriptNode, ScriptDet,maxNodes);
              writeintolog('Scriptnode : ' + ScriptNode.XML);
            end;
            i := i + 1;
            DXDS.CDS.Next;
          end;
        end;
        anode.Attributes['localnum'] := maxNodes;
        MXDS.CDS.Next;
      end;
    end;
  except
    on E: Exception do
    begin
      errstr := copy(E.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create('Error while loading scripts for Tstruct('+FName+') - '+errstr);
    end;
  end;
  finally
    ScriptDet.Clear;
    FreeAndNil(ScriptDet);
  end;
end;

Procedure TCreateStructure.LoadActionnode;
var fnode,anode : ixmlnode;
    i : integer;
begin
  if not assigned(actnode) then exit;
  anode := nil;  fnode := nil;
  for i := 0 to actnode.ChildNodes.Count-1 do begin
    anode := actnode.ChildNodes[i].CloneNode(True);
    if VarToStr(anode.Attributes['scripts']) <> 'yes' then begin
      if not assigned(fnode) then begin
        fnode := enode.AddChild('actions');
        fnode.Attributes['cat'] := 'actions';
      end;
      fnode.ChildNodes.Add(anode);
    end;
  end;
end;

Function TCreateStructure.ListOutExpression(SNode: IXMLNode; Script: TStringList;var maxNodes : Integer) : IXMLNode;
var
  i : Integer;
  nnode: IXMLNode;
begin
//  ScriptList := Tstringlist.Create;
//  ScriptList.Delimiter := ';';
//  ScriptList.StrictDelimiter := true;
//  ScriptList.DelimitedText := Script;
  writeintolog('Script Saved in DB : ' + Script.Text);
  for i := 0 to Script.Count - 1 do
  begin
    nnode := nil;
    nnode := SNode.AddChild('l' + IntToStr(i));
    nnode.nodevalue := Script[i];
  end;
  maxNodes := i +1;
  Result := SNode;
  writeintolog('After ListOutExpression Result : ' + SNode.XML);
end;

procedure TCreateStructure.LoadFieldProperties(frmno: String);
var
  fnode, tnode, detnode, snode, Agnode,PatternNode: IXMLNode;
  FldName, moe, chkmoe,actsql,AutoGenVal,CustDtype,Seprtr,TabStop: String;
  ftmp: TXDS;
  AutoGenList : TStringList;
  k : Integer;
begin
  try
    Try
      fnode := nil;   // field node
      tnode := nil;   // details node of a field
      detnode := nil; // fill node
      snode := nil;   // autogenerate node
      ftmp := nil;
      PatternNode := nil;
      ftmp := Axp.dbm.GetXDS(nil);
      ftmp.buffered := True;
      ftmp.CDS.CommandText := 'select * from vw_field_informations where '+Axp.dbm.gf.sqllower+'(transid)= :ntransid '+' and '+
                               Axp.dbm.gf.sqllower+'(dcname)=:dcnme order by sleveno,sordno';
      ftmp.AssignParam(0, lowercase(FName), 'c');
      ftmp.AssignParam(1, lowercase(frmno), 'c');
      ftmp.open;
      if (ftmp.CDS.RecordCount > 0) then
      begin
        ftmp.CDS.First;
        while not ftmp.CDS.Eof do
        begin
          tnode := nil;
          FldName := ftmp.CDS.FieldByName('name').AsString;
          moe := ftmp.CDS.FieldByName('modeofentry').AsString;
          fnode := enode.AddChild(FldName);
          AddDefNodes('field', fnode);
          fnode.Attributes['cat'] := 'field';
          fnode.Attributes['dcno'] := copy(frmno,3,2);
          CustDtype := ftmp.CDS.FieldByName('customdatatype').AsString;
          fnode.Attributes['fieldtype'] := CustDtype;//ftmp.CDS.FieldByName('customdatatype').AsString;
          Seprtr := ftmp.CDS.FieldByName('separator').AsString;
          AddDetailsNodes(fnode,CustDtype,Seprtr);
          fnode.ChildValues[xml_Name] := FldName;
          fnode.ChildValues[xml_Caption] := ftmp.CDS.FieldByName('caption').AsString;
          fnode.ChildValues[xml_TableTypeDetails] := CustDtype;//ftmp.CDS.FieldByName('customdatatype').AsString;
          fnode.ChildValues[xml_DataType] := ftmp.CDS.FieldByName('datatype').AsString;
          fnode.ChildValues[xml_DataWidth] := ftmp.CDS.FieldByName('datawidth').AsInteger;
          fnode.ChildValues[xml_Dec] := ftmp.CDS.FieldByName('fdecimal').AsInteger;
          TabStop := ftmp.CDS.FieldByName('tabstop').AsString;
          if Lowercase(Trim(TabStop)) = 'true' then
            fnode.ChildValues[xml_Tabstop] := 'True'
          else fnode.ChildValues[xml_Tabstop] := 'False';
          chkmoe := Trim(lowercase(moe));
          if ((chkmoe = 'select from form') or (chkmoe = 'select from sql') or (chkmoe = 'select from list') or (chkmoe = 'select from api')) then
            fnode.ChildValues[xml_MOE] := 'Select'
          else begin
            if (chkmoe = 'from api') then
            begin
              chkmoe := 'accept';
              fnode.ChildValues[xml_MOE] := 'Accept';
              //Adding attribute fromapi with true value to identify the MOE "from api" in the client side at runtime
              fnode.ChildNodes.FindNode(xml_MOE).Attributes['fromapi'] := 'true';
            end else fnode.ChildValues[xml_MOE] := chkmoe;
          end;
          if (lowercase(ftmp.CDS.FieldByName('hidden').AsString) = 'true') then
            fnode.ChildValues[xml_Hide] := 'True'
          else
            fnode.ChildValues[xml_Hide] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('allowempty').AsString) = 'true') then
            fnode.ChildValues[xml_Empty] := 'True'
          else
            fnode.ChildValues[xml_Empty] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('readonly').AsString) = 'true') then
            fnode.ChildValues[xml_ReadOnly] := 'True'
          else
            fnode.ChildValues[xml_ReadOnly] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('setcarry').AsString) = 'true') then
            fnode.ChildValues[xml_SetCarry] := 'True'
          else
            fnode.ChildValues[xml_SetCarry] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('savevalue').AsString) = 'true') then
            fnode.ChildValues[xml_Save] := 'True'
          else
            fnode.ChildValues[xml_Save] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('allowduplicate').AsString) = 'true') then
            fnode.ChildValues[xml_Duplicate] := 'True'
          else
            fnode.ChildValues[xml_Duplicate] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('onlypositive').AsString) = 'true') then
            fnode.ChildValues[xml_OnlyPositive] := 'True'
          else
            fnode.ChildValues[xml_OnlyPositive] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('applycomma').AsString) = 'true') then
            fnode.ChildValues[xml_ApplyComma] := 'True'
          else
            fnode.ChildValues[xml_ApplyComma] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('clientvalidation').AsString) = 'true') then
            fnode.ChildValues[xml_CValidate] := 'True'
          else
            fnode.ChildValues[xml_CValidate] := 'False';
          if (lowercase(ftmp.CDS.FieldByName('tabstop').AsString) = 'true') then
            fnode.ChildValues[xml_CValidate] := 'True'
          else
            fnode.ChildValues[xml_CValidate] := 'False';
          fnode.ChildValues[xml_Expr] := ftmp.CDS.FieldByName('expression').AsString;
          fnode.ChildValues[xml_VExp] := ftmp.CDS.FieldByName('validateexpression').AsString;
          fnode.ChildValues[xml_Mask] := ftmp.CDS.FieldByName('mask').AsString;
          fnode.ChildValues[xml_Pattern] := ftmp.CDS.FieldByName('pattern').AsString;
          fnode.ChildValues[xml_Hint] := ftmp.CDS.FieldByName('hint').AsString;
          fnode.ChildValues[xml_PWordChar] := ftmp.CDS.FieldByName('password_character').AsString;
          fnode.ChildValues[xml_Purpose] := trim(ftmp.CDS.FieldByName('purpose').AsString);
          fnode.ChildValues[xml_SearchSQL] := ftmp.CDS.FieldByName('search_sql').AsString;
          fnode.ChildValues[xml_displaydetail] := ftmp.CDS.FieldByName('displaydetail').AsString;
          if (Lowercase(CustDtype) = 'password') then begin
            PatternNode := fnode.ChildNodes.FindNode(xml_PWordChar);
            PatternNode.Attributes['alphanumeric'] := ftmp.CDS.FieldByName('password_alphanumeric').AsString;
            PatternNode.Attributes['minlength'] := ftmp.CDS.FieldByName('password_minlength').AsString;
            PatternNode.Attributes['expirydays'] := ftmp.CDS.FieldByName('password_expirydays').AsString;
          end;
          tnode := fnode.ChildNodes.FindNode(xml_Details);
          if (chkmoe = 'accept') then
          begin
            fnode.ChildValues[xml_MOE] := 'Accept';
            if (lowercase(ftmp.CDS.FieldByName('suggestive').AsString) = 'true') then
              tnode.ChildValues[xml_Suggestive] := 'True'
            else
              tnode.ChildValues[xml_Suggestive] := 'False';
            if (lowercase(ftmp.CDS.FieldByName('refresh').AsString) = 'true') then
              tnode.ChildValues[xml_Refresh] := 'True'
            else
              tnode.ChildValues[xml_Refresh] := 'False';
            if (lowercase(ftmp.CDS.FieldByName('autoselect').AsString) = 'true') then
              tnode.ChildValues[xml_AutoSelect] := 'True'
            else
              tnode.ChildValues[xml_AutoSelect] := 'False';
            tnode := tnode.ChildNodes.FindNode(xml_SQL);
            actsql := ftmp.CDS.FieldByName('detail').AsString;
            if (actsql <> '') then
            begin
              tnode.ChildValues['l'] := Axp.dbm.gf.FindAndReplace(actsql,#13#10,' ');
            end else if ftmp.CDS.FindField('execapidefname') <> nil then
            begin
              if ftmp.CDS.FieldByName('execapidefname').AsString <> '' then
              begin
                fnode.ChildNodes.FindNode(xml_MOE).Attributes['apiname'] := ftmp.CDS.FieldByName('execapidefname').AsString;
                AddValuesToFromAPINode(tnode, ftmp,FldName);
              end;
            end;
          end
          else if (chkmoe = 'autogenerate') then
          begin
            snode := tnode.ChildNodes.FindNode(xml_Sequence);
            AutoGenList := TStringList.Create;
            AutoGenList.Delimiter := '^';
            AutoGenList.DelimitedText := ftmp.CDS.FieldByName('def_sequence').AsString;
            for k := 0 to AutoGenList.Count-1 do
            begin
              AutoGenVal := AutoGenList[k];
              Agnode := snode.AddChild('l');
              Agnode.Attributes['r'] := 'f';
              Agnode.AddChild(xml_Prefix).NodeValue :=  axp.dbm.gf.GetNthString(AutoGenVal, 1, '|');//ftmp.CDS.FieldByName('prefix').AsString;
              Agnode.AddChild(xml_PrefixField).NodeValue := axp.dbm.gf.GetNthString(AutoGenVal, 2, '|');//ftmp.CDS.FieldByName('prefix_fields').AsString;
              Agnode.AddChild(xml_Desc).NodeValue := '';//ftmp.CDS.FieldByName('description').AsString;
              Agnode.AddChild(xml_StartNo).NodeValue := axp.dbm.gf.GetNthString(AutoGenVal, 3, '|');//ftmp.CDS.FieldByName('start_no').AsString;
              Agnode.AddChild(xml_SActive).NodeValue := axp.dbm.gf.GetNthString(AutoGenVal, 4, '|');//ftmp.CDS.FieldByName('sactive').AsString;
              Agnode.AddChild(xml_Digits).NodeValue  := axp.dbm.gf.GetNthString(AutoGenVal, 5, '|');//ftmp.CDS.FieldByName('no_of_digits').AsString;
            end;
          end
          else if (chkmoe = 'select from form') then
          begin
            fnode.ChildValues[xml_SourceKey] := 'True';
            AddValuesToFromFormNode(tnode, ftmp);
          end
          else if (chkmoe = 'select from sql') then
          begin
            if (lowercase(ftmp.CDS.FieldByName('sourcekey').AsString) = 'true') then
              fnode.ChildValues[xml_SourceKey] := 'True'
            else
              fnode.ChildValues[xml_SourceKey] := 'False';
            AddValuesToFromSQLNode(tnode, ftmp);
          end
          else if (lowercase(chkmoe) = 'select from list') then
            AddValuesToFromListNode(tnode, ftmp,FldName)
          else if (lowercase(chkmoe) = 'select from api') then
            AddValuesToFromAPINode(tnode, ftmp,FldName)
          else if (lowercase(chkmoe) = 'fill') then
          begin
            fnode.ChildValues[xml_MOE] := 'Fill';
            detnode := fnode.ChildNodes[xml_Details];
            if (ftmp.CDS.FieldByName('master').AsString <> '') then
              detnode.ChildValues[xml_FParent] := ftmp.CDS.FieldByName('master').AsString
            else raise Exception.Create('Values not found for Parent Field in the Field View');
            if (ftmp.CDS.FieldByName('source').AsString <> '') then
              detnode.ChildValues[xml_FSource] := ftmp.CDS.FieldByName('source').AsString
            else raise Exception.Create('Values not found for Source Field in the Field View');
            if (lowercase(ftmp.CDS.FieldByName('suggestive').AsString) = 'true') then
              detnode.ChildValues[xml_Suggestive] := 'True'
            else
              detnode.ChildValues[xml_Suggestive] := 'False';
          end;
          if (ftmp.CDS.FieldByName('def_table').AsString <> '') then
            fnode.ChildValues[xml_TableTypeDetails] := ftmp.CDS.FieldByName('def_table').AsString
          else begin
            if (ftmp.CDS.FieldByName('dsf').AsString <> '') then
              fnode.ChildValues[xml_TableTypeDetails] := 'true~'+ftmp.CDS.FieldByName('dsf').AsString
            else fnode.ChildValues[xml_TableTypeDetails] := '';
          end;
          SetComponentType(ftmp,fnode);
          ftmp.CDS.Next;
        end;
      end
      else
        raise Exception.Create('Field details not found for TStruct('+FName+') - DC('+frmno+').');
    except
      on e: Exception do
      begin
        errstr := copy(e.message, 1, 199);
        if (errstr <> '') then
          raise Exception.Create('Field('+FldName+') - '+errstr);
      end;
    End;
  finally
    if assigned(ftmp) then
    begin
      ftmp.close;
      ftmp.Free;
      ftmp := nil;
    end;
  end;
end;

