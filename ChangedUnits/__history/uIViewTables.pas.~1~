  k:=0;
  for I := 0 to enode.ChildNodes.Count - 1 do begin
    if vartostr(enode.ChildNodes[i].Attributes['cat']) = 'subtotals' then begin
      try
        inc(k);
        subNode := enode.ChildNodes[i];
        keycol := VarToStr(subnode.ChildNodes.FindNode(xml_blockedcolumn).NodeValue);
        n := subnode.ChildNodes.FindNode(xml_headercaption);
