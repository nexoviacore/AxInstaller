procedure TIViewTables.DeleteRecordsInIviewTables;
var
  i : integer;
  SQLList : TStringList;
begin
  SQLList := TStringList.Create;
  SQLList.Add('delete from IVIEWMAIN WHERE INAME ='+QuotedStr(iname));
  SQLList.Add('delete from IVIEWCOLS WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWBUTTONS WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWSUBTOTALS WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWPARAMS  WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWSQL WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWHYPLINK WHERE INAME ='+ QuotedStr(iname));
  SQLList.Add('delete from IVIEWHYPPARVAL WHERE INAME ='+ QuotedStr(iname));
  for I := 0 to SQLList.Count - 1 do begin
    try
      axpro.ExecSQL(SQLList[i],'','',false);
    Except on E:Exception do
      begin
        if assigned(axpro) then
            axpro.dbm.gf.DoDebug.Log(axpro.dbm.gf.Axp_logstr+'\uIViewTables\DeleteRecordsInIviewTables - '+e.Message);
        axpro.dbm.gf.DoDebug.Msg(E.Message);
        Writeln(ErrorFile,e.Message);
        Continue;
      end;
    end;
  end;
  FreeAndNil(SQLList);
end;

