function TMain.findpatchindex(patch: string): integer;
var
  I: integer;
  Found: Boolean;
begin
  Found := False;
  for I := Low(Patcharray) to High(Patcharray) do
  begin
    if lowercase(patch) = lowercase(Patcharray[I]) then
    begin
      Result := I;
      Found := True;
      Break;
    end;
  end;
  if Found = False then
    Result := -1;

end;

