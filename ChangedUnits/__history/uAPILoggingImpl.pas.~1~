// SaveRequestToDatabase
procedure TAPILoggingHandler.SaveRequestToDatabase(dbm: TDBManager);
var
  sDateTime: String;
  OldServerDateTime: TDateTime;
  axds: TXDS;
begin
  if Not Assigned(dbm) then
    Exit;
  dbm.gf.DoDebug.msg('SaveRequestToDatabase starts...');
  if Not Assigned(slWebRequest) or (slWebRequest.Count = 0) then
  begin
    // WriteRESTLog('SaveRequestToDatabase/ No data found in the WebRequest.');
    dbm.gf.DoDebug.msg
      ('SaveRequestToDatabase/ No data found in the WebRequest.');
    Exit;
  end;

  axds := nil;
  try
    axds := dbm.GetXDS(nil);
    try
      axds.close;
      axds.Append('AxRequest');
      sAPIRequestID := slWebRequest.Values['RequestID'];
      axds.Submit('RequestID', sAPIRequestID, 'c');
      OldServerDateTime := dbm.ServerDateTime;
      // due to ServerDateTime condition in udbmanager its not fetching recent datetime
      // so we used this approach to get the value
      dbm.ServerDateTime := 0;
      sDateTime := DateTimeToStr(dbm.getserverdatetime);
      dbm.ServerDateTime := OldServerDateTime;
      // axds.Submit('Timestamp',sDateTime,'d');  //Timestamp & responseSentTime are same
      axds.Submit('RequestReceivedTime', sDateTime, 'd');
      // Timestamp & responseSentTime are same

      axds.Submit('SourceFrom', slWebRequest.Values['SourceFrom'], 'c');
      // Timestamp & responseSentTime are same
      axds.Submit('SourceMachineIP', slWebRequest.Values['SourceMachineIP'],
        'c'); // Timestamp & responseSentTime are same

      axds.Submit('RequestString', slWebRequest.Values['RequestString'], 'c');
      axds.Submit('ContentType', slWebRequest.Values['ContentType'], 'c');
      axds.Submit('ContentLength', slWebRequest.Values['ContentLength'], 'c');
      axds.Submit('Headers', slWebRequest.Values['Headers'], 'c');
      axds.Submit('Params', slWebRequest.Values['Params'], 'c');
      axds.Submit('AuthZ', slWebRequest.Values['Authz'], 'c');

      axds.Submit('Host', slWebRequest.Values['Host'], 'c');
      axds.Submit('URL', slWebRequest.Values['URL'], 'c');
      axds.Submit('Endpoint', slWebRequest.Values['Endpoint'], 'c');
      axds.Submit('RequestMethod',
        UpperCase(slWebRequest.Values['RequestMethod']), 'c');
      axds.Submit('APIName', slWebRequest.Values['APIName'], 'c');
      axds.Submit('UserName', dbm.gf.username, 'c');
      axds.Submit('AdditionalDetails', '', 'c');

      axds.Post;
    except
      on E: Exception do
      begin
        dbm.gf.DoDebug.Log(dbm.gf.Axp_logstr +
          '\uAPILoggingImpl\SaveRequestToDatabase - ' + E.Message);
        dbm.gf.DoDebug.msg(E.Message);
      end;
    end;
  finally
    // finally
    if Assigned(axds) then
    begin
      if axds.Active then
        axds.close;
      FreeAndNil(axds);
    end;
  end;
  dbm.gf.DoDebug.msg('SaveRequestToDatabase ends.');
end;

// GetJSONValue
function GetJSONValue(JSONObject: TJSONObject; const key: string): TJSONValue;
var
  JSONPair: TJSONPair;
begin
  Result := nil;
  if JSONObject <> nil then
  begin
    JSONPair := JSONObject.Get(key);
    if Assigned(JSONPair) then
      Result := JSONPair.jsonValue;
  end;
end;

// FindValue
function FindValue(const AJSON: TJSONObject; const AKey: string): TJSONValue;
var
  Pair: TJSONPair;
begin
  Result := nil;
  if not Assigned(AJSON) then
    Exit;

  Pair := AJSON.Get(AKey); // Retrieves the TJSONPair for the given key
  if Assigned(Pair) then
    Result := Pair.jsonValue;
  // If the pair exists, return the associated JSON value
end;

// IsFailedResponse
function IsFailedResponse(const jsonResponse: TJSONObject): Boolean;
var
  statusValue, errorValue, resultValue: TJSONValue;
  resultArray: TJsonArray;
  resultObject: TJSONObject;
begin
  Result := False;
  if Assigned(jsonResponse) then
  begin
    // Check for top-level "status" key
{$IFDEF VER240}
    statusValue := GetJSONValue(jsonResponse, 'status');
{$ELSE}
    statusValue := jsonResponse.GetValue('status');
{$ENDIF}
    if Assigned(statusValue) and (Lowercase(statusValue.Value) = 'failed') then
    begin
      Result := True;
      Exit;
    end;

    // Check for top-level "error" key
{$IFDEF VER240}
    errorValue := GetJSONValue(jsonResponse, 'error');
{$ELSE}
    errorValue := jsonResponse.GetValue('error');
{$ENDIF}
    if Assigned(errorValue) then
    begin
      Result := True;
      Exit;
    end;

    // Check for "result" array
{$IFDEF VER240}
    resultValue := GetJSONValue(jsonResponse, 'result');
    if Assigned(resultValue) and (resultValue is TJsonArray) then
    begin
      resultArray := TJsonArray(resultValue);
      if (resultArray.Size > 0) and (resultArray.Get(0) is TJSONObject) then
      begin
        resultObject := TJSONObject(resultArray.Get(0));
        if Assigned(resultObject) then
        begin
          statusValue := FindValue(resultObject, 'status');
          if Assigned(statusValue) and (Lowercase(statusValue.Value) = 'failed')
          then
          begin
            Result := True;
            Exit;
          end;

          // Check for "error" key under "result" object
          errorValue := FindValue(resultObject, 'error');
          if Assigned(errorValue) then
          begin
            Result := True;
            Exit;
          end;
        end;
      end;
    end;

{$ELSE}
    resultValue := GetJSONValue(jsonResponse, 'result');
    if Assigned(resultValue) and (resultValue is TJsonArray) then
    begin
      resultArray := TJsonArray(resultValue);
      if (resultArray.Size > 0) and (resultArray.Get(0) is TJSONObject) then
      begin
        resultObject := TJSONObject(resultArray.Get(0));
        if Assigned(resultObject) then
        begin
          statusValue := FindValue(resultObject, 'status');
          // resultObject.FindValue('status');
          if Assigned(statusValue) and (Lowercase(statusValue.Value) = 'failed')
          then
          begin
            Result := True;
            Exit;
          end;

          // Check for "error" key under "result" object
          errorValue := FindValue(resultObject, 'error');
          // resultObject.FindValue('error');
          if Assigned(errorValue) then
          begin
            Result := True;
            Exit;
          end;
        end;
      end;
    end;
{$ENDIF}
  end;
end;

