      lview := TListView.Create;
      lview.Axp := Axp;
      lview.Name := FName;
      lview.uname := 'all';
      lview.Caption := FCaption;
      lview.xml := LoadXMLData('<root></root>');
      enode := lview.xml.DocumentElement;
      if sdef.attach then
        enode.Attributes['attach'] := 't'
      else
        enode.Attributes['attach'] := 'f';
      if sdef.track then
        enode.Attributes['track'] := 't'
      else
        enode.Attributes['track'] := 'f';
      if VarToStr(fxml.DocumentElement.Attributes['pform']) = 'yes' then
        enode.Attributes['pform'] := 't'
      else
        enode.Attributes['pform'] := 'f';
      enode := fxml.DocumentElement;
      lview.orgNode := enode.CloneNode(True);
      lview.Init;
      n := enode.ChildNodes[0];
      n := enode.ChildNodes.FindNode('dc1');
      tname := VarToStr(n.ChildValues[xml_Table]);
      lview.ptable := tname;
      lview.ViewDefaultProperties(tname);
      flist := '';
      j := 0;
      hlsrc := '';
      (*
      LvwHlinkField holds the name of the hyperlink field, which was set in Configure List view.
      If LvwHlinkField is not empty, then check whether that field is visible and
       non-normalized. If so, then set the same field as the Hyperlink field, else
      use the existing functionality to set the Hyperlink field.
      *)
      if sLvwHlinkField <> '' then
      begin
        LvwHlinkFld := sdef.GetField(sLvwHlinkField);
        if Assigned(LvwHlinkFld) and (Not LvwHlinkFld.hidden) and
            (Not LvwHlinkFld.SourceKey) and (LvwHlinkFld.FrameNo = 1) then
            hlsrc := sLvwHlinkField;
      end;

      if hlsrc = '' then
      begin
        for i := 0 to enode.ChildNodes.Count - 1 do
        begin
          n := enode.ChildNodes[i];
          if VarToStr(n.NodeName) = 'dc2' then
            break;
          if VarToStr(n.Attributes['cat']) = 'field' then
          begin
            if (VarToStr(n.ChildValues[xml_MOE]) = 'AutoGenerate') and
              (n.ChildValues[xml_Hide] = 'False') then
            begin
              hlsrc := VarToStr(n.ChildValues[xml_Name]);
              break;
            end;
          end;
        end;
      end;

      for i := 0 to enode.ChildNodes.Count - 1 do
      begin
        n := enode.ChildNodes[i];
        if VarToStr(n.NodeName) = 'dc2' then
          break;
        if VarToStr(n.Attributes['cat']) = 'field' then
        begin
          if (VarToStr(n.ChildValues[xml_Save]) = 'False') or
            (VarToStr(n.ChildValues[xml_DataType]) = 'Image') then
            continue;
          nm := VarToStr(n.ChildValues[xml_Name]);
          if (lowercase(nm) = 'viewfilter') then
            continue;
          vfList.Add(nm);
          flist := flist + nm + ',';
          cap := VarToStr(n.ChildValues[xml_Caption]);
          dtype := VarToStr(n.ChildValues[xml_DataType]);
          deci := VarToStr(n.ChildValues[xml_Dec]);
          lview.ViewDefaultColProperties(nm, cap, dtype, '80', deci, tname,
            VarToStr(n.ChildValues[xml_ApplyComma]),
            VarToStr(n.ChildValues[xml_Hide]));
          if hlsrc <> '' then
          begin
            lview.source := hlsrc;
            j := j + 1;
          end;
          if (j = 0) and (n.ChildValues[xml_Hide] = 'False') and
            (n.ChildValues[xml_Sourcekey] = 'False') then
          begin
            lview.source := nm;
            j := j + 1;
          end;
        end;
      end;
      flist := copy(flist, 1, Length(flist) - 1);
      FrameSQL := TFrameSQL.Create(sdef, vfList, '', '');
      FrameSQL.Axp := Axp;
      FrameSQL.block := lview.block;
      FrameSQL.ForListView := True;
      stext := FrameSQL.FrameListSQL;
      FrameSQL.Destroy;
      FrameSQL := nil;
      lview.ViewDefaultSqlProperties(stext);
      lview.flist := vfList;
      lview.ColumnsReset(stext);
      lview.RecordidCol;
      lview.save;
    Except on E:Exception do
      Raise Exception.Create('Error in CreateListView for tstruct('+FName+') - '+E.Message);
    end;
  finally
    if Assigned(lview) then
      FreeAndNil(lview);
    if Assigned(vfList) then
      FreeAndNil(vfList);
    if Assigned(sdef) then
      FreeAndNil(sdef);
    LvwHlinkFld := nil;
  end;
end;

procedure TCreateStructure.DeleteListView(tst: String);
var
  lview: TListView;
begin
  try
    try
      (*
      As per the design, whenever we save the structure, the List view will be recreated.
      To Avoid resetting of hyperlink field we have introduced the below functionality.
      If "createlview" is true then we will fetch the hyperlink field before clearing the List view.
      When recreating the List view, we will check for this field again in the structure, if it exists
      then this field will be set as a hyperlink field else as per the existing design hyperlink field will be created.
      *)
      if createlview then
         sLvwHlinkField := GetLviewHyperlinkField(tst);

      lview := nil;
      lview := TListView.Create;
      lview.Axp := Axp;
      lview.Name := tst;
      lview.Remove;
    Except on E:Exception do
      raise Exception.Create('Error in DeleteListView for tstruct('+tst+') - '+E.Message);
    end;
  finally
    if Assigned(lview) then
      FreeAndNil(lview);
  end;
end;

procedure TCreateStructure.UpdatePageOrder;
// menupos - insert before,insert after,insert under   menulist
var
  mnxds, q1: TXDS;
  headname, trnsid, morderno, pgtype: String;
  updpage, sname, spath, shead: String;
  moveorder, lorderno: Integer;
begin
  if ((lowercase(menupos) = 'insert before') or (lowercase(menupos) = 'insert after')) then
  begin
    trnsid := FetchPageID(FName);
    if (copy(trnsid, 1, 1) = 't') then
      pgtype := 'Ts'
    else
      pgtype := 'Iv';
    if lowercase(FolderName) = 'default' then
      headname := '';
    mnxds := Axp.dbm.GetXDS(nil);
    mnxds.buffered := True;
    mnxds.CDS.CommandText := 'select ordno from axpages where ' +Axp.dbm.gf.sqllower + '(name)=' +
      QuotedStr(lowercase('Page' + pgtype + copy(trnsid, 2, Length(trnsid))));
    mnxds.open;
    lorderno := mnxds.CDS.FieldByName('ordno').AsInteger;
    if (lowercase(menupos) = 'insert after') then
      lorderno := lorderno + 1;
    if (headname <> '') then
      mnxds.CDS.CommandText := 'select max(ordno) cnt from axpages where ' +Axp.dbm.gf.sqllower + '(parent)=' + QuotedStr(lowercase(headname))
    else
      mnxds.CDS.CommandText := 'select max(ordno) cnt from axpages where ' +Axp.dbm.gf.sqllower + '(parent) is null';
    mnxds.open;
    morderno := mnxds.CDS.FieldByName('cnt').AsString;
    mnxds.CDS.CommandText := '';
    if (headname <> '') then
      mnxds.CDS.CommandText := 'select ordno,name from axpages where ordno >= '+ QuotedStr(IntToStr(lorderno)) + ' and ordno < '
      + QuotedStr((morderno)) + ' and ' + Axp.dbm.gf.sqllower + '(parent) = ' +QuotedStr(lowercase(headname)) + ' order by ordno'
    else
      mnxds.CDS.CommandText := 'select ordno,name from axpages where ordno >= '+ QuotedStr(IntToStr(lorderno)) + ' and ordno < '
      + QuotedStr((morderno)) + ' and ' + Axp.dbm.gf.sqllower + '(parent) is null order by ordno';
    mnxds.open;
    q1 := Axp.dbm.GetXDS(nil);
    q1.buffered := True;
    while not mnxds.CDS.Eof do
    begin
      moveorder := mnxds.CDS.FieldByName('ordno').AsInteger;
      updpage := mnxds.CDS.FieldByName('name').AsString;
      q1.CDS.CommandText := 'update axpages set ordno = ' +QuotedStr(IntToStr(moveorder + 1)) + ' where lower(name) = ' +QuotedStr(lowercase(updpage));
      q1.CDS.Execute;
      mnxds.CDS.Next;
    end;
    q1.CDS.CommandText := 'update axpages set ordno = ' +QuotedStr(IntToStr(lorderno)) + ' where ' + Axp.dbm.gf.sqllower +'(name)='+
      QuotedStr(lowercase('PageTs' + FName));
    q1.CDS.Execute;
    if Assigned(mnxds) then
    begin
      mnxds.close;
      mnxds.Free;
    end;
    if Assigned(q1) then
    begin
      q1.close;
      q1.Free;
    end;
  end;
end;

