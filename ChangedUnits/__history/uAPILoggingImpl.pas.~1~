function GetDLLDirectory: string;
var
  ModuleName: array [0 .. MAX_PATH] of Char;
  DLLPath: string;
begin
  // Get the module file name of the DLL
  if GetModuleFileName(HInstance, ModuleName, MAX_PATH) > 0 then
  begin
    DLLPath := ExtractFilePath(ModuleName);
    // Ensure it ends with a backslash
    if not DLLPath.EndsWith('\') then
      DLLPath := DLLPath + '\';
    Result := DLLPath;
  end
  else
    Result := '';
end;

