begin
  writeintolog('GetLviewHyperlinkField starts');
  try
    result := '';
    lvwXML := nil;
    lvwHlinkNode := nil;
    lvwSelfHypNode := nil;
    //Load Lviews XML
    lvwXML := axp.getstructure('lviews', sTStructName, '', '');
    if Assigned(lvwXML) then
    begin
       //Find hyperlinks node
       lvwHlinkNode := lvwXML.DocumentElement.ChildNodes.FindNode('hyperlinks');
       if Assigned(lvwHlinkNode) then
       begin
          //Find selfhyp node
          lvwSelfHypNode := lvwHlinkNode.ChildNodes.FindNode('selfhyp');
          if Assigned(lvwSelfHypNode) then
          begin
            //Get hyperlink field
            if lvwSelfHypNode.HasAttribute('source') then
              result := lvwSelfHypNode.Attributes['source'];
          end;
       end;
    end;
  finally
    lvwXML := nil;
    lvwHlinkNode := nil;
    lvwSelfHypNode := nil;
  end;
  writeintolog('GetLviewHyperlinkField end.');
end;

initialization
  SkippedTransIdsList := TStringList.Create;

finalization
  SkippedTransIdsList.Free;


end.

