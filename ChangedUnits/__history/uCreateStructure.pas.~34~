Function TCreateStructure.SaveAsTstruct(OldTransId,NewTransId,NewTransCaption : String) : String;
var RefID,DcIds,FldIds,ESTr : String;
begin
  try
    try
      Result := ''; ESTr := '';
      Axp.dbm.StartTransaction(Axp.dbm.gf.connectionname);
      RefID := '0'; dcids := '';
      FName := OldTransId;
      RefID := CopyTStructProperties(NewTransId,NewTransCaption);                   // Axpdef_tstruct
      if RefID <> '0' then begin
        DcIds := CopyDCProperties(NewTransId,NewTransCaption,RefID);                // Axpdef_DC
