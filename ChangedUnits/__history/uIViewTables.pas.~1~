procedure TIViewTables.InsertIntoIviewParamsTable;
var
 i,j,k : integer;
 paramNode, n,pnode : IXMLNode;
 blobno,w,sql,pname,pcaption,dtype,decimals,parhidden,value,sugg,exp,valexp,moe,d :  string;
 pordno : String;
begin
  k:=0;
  for I := 0 to enode.ChildNodes.Count - 1 do begin
    if vartostr(enode.ChildNodes[i].Attributes['cat']) = 'params' then begin
      try
        inc(k);
        paramNode := enode.ChildNodes[i];
        pordno := paramnode.Attributes['ord'];
        pname := VarToStr(paramNode.ChildNodes.FindNode(xml_name).NodeValue);
        pcaption := VarToStr(paramNode.ChildNodes.FindNode(xml_caption).NodeValue);
        if VarToStr(paramNode.ChildNodes.FindNode(xml_datatype).NodeValue) = 'Character' then dtype := 'C'
        else if VarToStr(paramNode.ChildNodes.FindNode(xml_datatype).NodeValue) = 'Date/Time' then dtype := 'D'
        else dtype := 'N';
        if lowercase(vartostr(paramNode.ChildNodes.FindNode(xml_expression).Attributes['sugg']))= 'true' then sugg := 'T'
        else sugg := 'F';
        exp := VarToStr(paramNode.ChildNodes.FindNode(xml_expression).NodeValue);
        valexp := VarToStr(paramNode.ChildNodes.FindNode(xml_validateexpression).NodeValue);
        if lowercase(VarToStr(paramNode.ChildNodes.FindNode(xml_hidden).NodeValue)) = 'true' then parhidden := 'T'
        else parhidden := 'F';
        sql := VarToStr(paramNode.ChildNodes.FindNode(xml_paramsqlname).NodeValue);
        decimals := VarToStr(paramNode.ChildNodes.FindNode(xml_decimals).NodeValue);
        value := VarToStr(paramNode.ChildNodes.FindNode(xml_pvalue).NodeValue);
        moe := VarToStr(paramNode.ChildNodes.FindNode(xml_modeofentry).NodeValue);
        blobno := '1';
        cxds.ClearEdit;
        cxds.Submit('INAME',iname,'c');
        cxds.Submit('PNAME',pname,'c');
        cxds.Submit('PCAPTION',pcaption,'c');
        cxds.Submit('DTYPE',dtype,'c');
        cxds.Submit('SUGGESTIVE',sugg,'c');
        cxds.Submit('EXP',exp,'c');
        cxds.Submit('VAL_EXP',valexp,'c');
        cxds.Submit('HIDDEN',parhidden,'c');
        cxds.Submit('DECIMALS',decimals,'n');
        cxds.Submit('VALUE',value,'c');
        cxds.Submit('MOE',moe,'c');
        cxds.Submit('SCRIPTTEXT',sql,'c');
        cxds.Submit('BLOBNO',blobno,'n');
        cxds.Submit('PORD',pordno,'n');
        cxds.Submit('ordno',inttostr(k),'n');
//      d := VarToStr(paramNode.ChildNodes.FindNode('a15').NodeValue);
        n := paramNode.ChildNodes.FindNode(xml_Deps);
        if n = nil  then
          d := ''
        else
          d := vartostr(n.ChildValues['s']);
        cxds.Submit('DEPS',d,'c');
        if lowercase(VarToStr(paramNode.ChildNodes.FindNode(xml_multiselect).NodeValue)) = 'true' then d := 'T'
        else d := 'F';
        cxds.Submit('MULTISELECT',d,'c');
        if lowercase(VarToStr(paramNode.ChildNodes.FindNode(xml_dynamicparam).NodeValue)) = 'true' then d := 'T'
        else d := 'F';
        cxds.Submit('DYNAMIC_PARAM',d,'c');
        d := VarToStr(paramNode.ChildNodes.FindNode(xml_queryname).NodeValue);
        cxds.Submit('QUERY_NAME',d,'c');
        if lowercase(VarToStr(paramNode.ChildNodes.FindNode(xml_savevalue).NodeValue)) = 'true' then d := 'T'
        else d := 'F';
        cxds.Submit('SAVE_VALUE',d,'c');
        n := paramNode.ChildNodes.FindNode(xml_width);
        if n<> nil then  begin
          d:=VarToStr(n.NodeValue);
          cxds.Submit('PARAM_WIDTH',d,'n');
        end;
        n := paramNode.ChildNodes.FindNode(xml_clrcache);
        if n<> nil then  begin
          if lowercase(VarToStr(n.NodeValue)) = 'true' then d := 'T'
          else d := 'F';
        end else d:= 'F';
        cxds.Submit('clrcache',d,'c');
        pnode := paramNode.ChildNodes.FindNode(xml_picklistcols);
        d:='';
        if pnode<>nil then begin
          for j := 0 to pnode.ChildNodes.Count-1 do begin
            n := pnode.ChildNodes[j];
            d:= d+n.Attributes['ci']+'~'+n.Attributes['cn']+'@#';
          end;
        end;
        cxds.Submit('Picklist_cols',d,'c');
        w := 'INAME = '+quotedstr(iname)+'and PNAME = ' + QuotedStr(pname);

        cxds.AddOrEdit('IVIEWPARAMS',w);
        cxds.close;
      Except on E:Exception do
        begin
          if assigned(axpro) then
            axpro.dbm.gf.DoDebug.Log(axpro.dbm.gf.Axp_logstr+'\uIViewTables\InsertIntoIviewParamsTable - '+e.Message);
          axpro.dbm.gf.DoDebug.Msg(E.Message);
          Writeln(ErrorFile,e.Message);
          continue;
        end;
      end;
    end;
  end;
end;

procedure TIViewTables.InsertIntoIviewSqlTable;
var
  i,j,ordno : integer;
  fnode,sqlnode,temp : IXMLNode;
  blobno,w,sql_text,stype,task,relat_field,cat, sName : string;
begin
  sql_text := '';
//  sql_list:= TStringList.Create;
  ordno := 0;
  for I := 0 to enode.ChildNodes.Count - 1 do begin
    if (vartostr(enode.ChildNodes[i].Attributes['cat']) = 'sql') or
       (vartostr(enode.ChildNodes[i].Attributes['cat']) = 'expr') then begin
      try
        inc(ordno);
        sqlnode := enode.ChildNodes[i];
        sName := sqlnode.NodeName;
        cat := sqlnode.Attributes['cat'];
        temp := sqlnode.ChildNodes.FindNode(xml_sqltext);                                 //****changed due to split of xml_sqltext node*****
        fnode := temp.ChildNodes.findnode('l0');
        if (temp.ChildNodes.Count>0) and assigned(fnode) then begin
          sql_list.Clear;
          for j := 0 to temp.ChildNodes.Count - 1 do
          begin
            sql_list.Add(vartostr(temp.ChildNodes[j].NodeValue));
          end;
          sql_text:=sql_list.Text;
        end
        else begin
          sql_text := VarToStr(sqlnode.ChildNodes.FindNode(xml_sqltext).NodeValue);
        end;
        stype := VarToStr(sqlnode.ChildNodes.FindNode(xml_sqltype).NodeValue);
        task := VarToStr(sqlnode.ChildNodes.FindNode(xml_queryname).NodeValue);
        blobno := '1';
        relat_field := VarToStr(sqlnode.ChildNodes.FindNode(xml_relationfield).NodeValue);
        w := 'INAME =' + quotedstr(iname) +'and TASK = '+ quotedstr(task) + 'and TYPE = '+ quotedstr(stype);
        cxds.ClearEdit;
        cxds.close;
        cxds.Submit('INAME',iname,'c');
        cxds.Submit('SNAME',sname,'c');
        cxds.Submit('ORDNO',IntToStr(ordno),'n');
        cxds.Submit('SCRIPTTEXT',sql_text,'c');
        cxds.Submit('CAT',cat,'c');
        cxds.Submit('TYPE',stype,'c');
        cxds.Submit('TASK',task,'c');
        cxds.Submit('BLOBNO',blobno,'n');
        cxds.Submit('RELATION_FIELD',relat_field,'c');
        cxds.AddOrEdit('IVIEWSQL',w);
        cxds.close;
      Except on E:Exception do
        begin
          if assigned(axpro) then
            axpro.dbm.gf.DoDebug.Log(axpro.dbm.gf.Axp_logstr+'\uIViewTables\InsertIntoIviewSqlTable - '+e.Message);
          axpro.dbm.gf.DoDebug.Msg(E.Message);
          Writeln(ErrorFile,e.Message);
          continue;
        end;
      end;
    end;
  end;

end;

procedure TIViewTables.InsertIntoIviewHyperlinksTable;
