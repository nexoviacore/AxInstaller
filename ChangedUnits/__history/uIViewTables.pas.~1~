        subtotal_ord := VarToStr(subnode.ChildNodes.FindNode(xml_totalorder).NodeValue);
        w := 'INAME = '+ QuotedStr(iname)+ 'and KEY_COLUMN = ' + QuotedStr(keycol) ;
        cxds.ClearEdit;
        cxds.Submit('INAME',iname,'c');
        cxds.Submit('KEY_COLUMN',keycol,'c');
        cxds.Submit('HEADER',header,'c');
        cxds.Submit('HEADER_COLOR',hcolor,'c');
        cxds.Submit('FOOTER',footer,'c');
