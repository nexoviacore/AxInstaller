procedure TGitManager.InitIdHttp;
var
  NewHttp: TIdHttp;
  NewSSLIOHandler: TIdSSLIOHandlerSocketOpenSSL;
begin
  WriteLog('Creating IdHTTP instance');

  NewHttp := TIdHttp.create(nil);
  NewSSLIOHandler := nil;
  try
    NewSSLIOHandler := TIdSSLIOHandlerSocketOpenSSL.create(nil);
    NewSSLIOHandler.SSLOptions.SSLVersions := [sslvTLSv1_2];

    NewHttp.IOHandler := NewSSLIOHandler;
    NewHttp.HandleRedirects := True;
    NewHttp.RedirectMaximum := 15;
    NewHttp.ConnectTimeout := GitConnectTimeoutMs;
    NewHttp.ReadTimeout := GitReadTimeoutMs;
    NewHttp.ProtocolVersion := pv1_1;

    NewHttp.Request.CharSet := 'utf-8';
    NewHttp.Request.CacheControl := 'no-cache';
    NewHttp.Request.Accept := 'application/vnd.github+json';
    NewHttp.Request.UserAgent := 'Axpert';

    IdHttp1 := NewHttp;
    SSLIOHandler := NewSSLIOHandler;
  except
    NewHttp.Free;
    NewSSLIOHandler.Free;
    raise;
  end;

  WriteLog('IdHTTP initialized successfully. ConnectTimeout=' +
    IntToStr(GitConnectTimeoutMs) + 'ms, ReadTimeout=' +
    IntToStr(GitReadTimeoutMs) + 'ms');
end;

procedure TGitManager.SetGitAuthentication(const Token: string);
begin
  if Token <> '' then
  begin
    IdHttp1.Request.CustomHeaders.Values['Authorization'] := 'Bearer ' + Token;

    IdHttp1.Request.Accept := 'application/vnd.github+json';

    WriteLog('Git authentication configured');
  end;
end;

Procedure TGitManager.CleanIdHttp;
begin
  if Assigned(IdHttp1) then
    freeandnil(IdHttp1);
  if Assigned(SSLIOHandler) then
    freeandnil(SSLIOHandler);

end;

procedure TGitManager.ResetHttpConnection;
begin
  // A failed Indy request can leave protocol or TLS state unsuitable for reuse.
  // Recreate both objects before retrying, while retaining healthy connections.
  try
    CleanIdHttp;
  except
    on E: Exception do
      WriteLog('Error while cleaning HTTP resources: ' + E.Message);
  end;

  InitIdHttp;
  SetGitAuthentication(Access_Token);
  httpReqCount := 0;
end;

function SafeURLForLog(const URL: string): string;
var
  QueryPos: Integer;
begin
  // Query strings can contain signed credentials. Never write them to the log.
  QueryPos := Pos('?', URL);
  if QueryPos > 0 then
    Result := Copy(URL, 1, QueryPos - 1) + '?[redacted]'
  else
    Result := URL;
end;

procedure WriteGitLog(const Msg: string);
begin
  WriteLog(FormatDateTime('yyyy-mm-dd hh:nn:ss.zzz', Now) + ' ' + Msg);
end;

function TGitManager.IsRetryableRequestError(const E: Exception): Boolean;
var
  ErrorCode: Integer;
  RetryAfter: string;
begin
  Result := False;

  if E is EIdSocketError then
  begin
    ErrorCode := EIdSocketError(E).LastError;
    case ErrorCode of
      10051, 10052, 10053, 10054, 10060, 10061, 10065, 11001, 11002:
        Result := True;
    else
      Result := False;
    end;
    Exit;
  end;

  if E is EIdHTTPProtocolException then
  begin
    ErrorCode := EIdHTTPProtocolException(E).ErrorCode;
    case ErrorCode of
      408, 421, 425, 429, 500, 502, 503, 504:
        Result := True;
    else
      Result := False;
    end;

    // GitHub can report secondary rate limiting as 403. Retry only when the
    // server gives an explicit delay; a normal 403 and an exhausted hourly
    // quota must not be hammered by short retries.
    if (ErrorCode = 403) and Assigned(IdHttp1) and
      Assigned(IdHttp1.Response) then
    begin
      RetryAfter := IdHttp1.Response.RawHeaders.Values['Retry-After'];
      Result := RetryAfter <> '';
    end;
    Exit;
  end;

  Result := (Pos('read timed out', LowerCase(E.Message)) > 0) or
    SameText(Trim(E.Message), 'Zero size file found.');
end;

function TGitManager.GetRetryDelayMs(const AttemptNumber: Integer): Integer;
var
  RetryAfterSeconds: Integer;
  RetryAfterValue: string;
begin
  RetryAfterValue := '';
  if Assigned(IdHttp1) and Assigned(IdHttp1.Response) then
    RetryAfterValue := IdHttp1.Response.RawHeaders.Values['Retry-After'];

  RetryAfterSeconds := StrToIntDef(Trim(RetryAfterValue), 0);
  if RetryAfterSeconds > 0 then
  begin
    if RetryAfterSeconds > (GitMaxRetryDelayMs div 1000) then
      Result := GitMaxRetryDelayMs
    else
      Result := RetryAfterSeconds * 1000;
  end
  else
    Result := GitInitialRetryDelayMs * (1 shl (AttemptNumber - 1));

  if Result > GitMaxRetryDelayMs then
    Result := GitMaxRetryDelayMs;
end;

function TGitManager.GetTextWithRetry(const URL: string): string;
var
  AttemptNumber: Integer;
  RetryDelayMs: Integer;
  StartedAt: Cardinal;
begin
  Result := '';
  for AttemptNumber := 1 to MaxGitRequestAttempts do
  begin
    ResetIdHttpReqObj;
    StartedAt := GetTickCount;
    WriteGitLog('Git request start. URL=' + SafeURLForLog(URL) +
      ', attempt=' + IntToStr(AttemptNumber) + '/' +
      IntToStr(MaxGitRequestAttempts) + ', connect-timeout=' +
      IntToStr(GitConnectTimeoutMs) + 'ms, read-timeout=' +
      IntToStr(GitReadTimeoutMs) + 'ms');
    try
      Result := IdHttp1.Get(URL);
      WriteGitLog('Git request success. URL=' + SafeURLForLog(URL) +
        ', attempt=' + IntToStr(AttemptNumber) + ', elapsed=' +
        IntToStr(Cardinal(GetTickCount - StartedAt)) + 'ms, HTTP=' +
        IntToStr(IdHttp1.ResponseCode));
      Exit;
    except
      on E: Exception do
      begin
        WriteGitLog('Git request failed. URL=' + SafeURLForLog(URL) +
          ', attempt=' + IntToStr(AttemptNumber) + ', elapsed=' +
          IntToStr(Cardinal(GetTickCount - StartedAt)) + 'ms, exception=' +
          E.ClassName + ', message=' + E.Message);
        if E is EIdSocketError then
          WriteGitLog('Git socket error code=' +
            IntToStr(EIdSocketError(E).LastError))
        else if E is EIdHTTPProtocolException then
        begin
          WriteGitLog('Git HTTP status=' +
            IntToStr(EIdHTTPProtocolException(E).ErrorCode));
          if Assigned(IdHttp1.Response) then
            WriteGitLog('Git rate limit. remaining=' +
              IdHttp1.Response.RawHeaders.Values['X-RateLimit-Remaining'] +
              ', reset=' +
              IdHttp1.Response.RawHeaders.Values['X-RateLimit-Reset'] +
              ', retry-after=' +
              IdHttp1.Response.RawHeaders.Values['Retry-After']);
        end;

        if (AttemptNumber = MaxGitRequestAttempts) or
          not IsRetryableRequestError(E) then
        begin
          WriteGitLog('Git request final failure. URL=' +
            SafeURLForLog(URL) + ', attempts=' + IntToStr(AttemptNumber));
          raise EGitRequestFailed.Create(E.ClassName + ': ' + E.Message);
        end;

        RetryDelayMs := GetRetryDelayMs(AttemptNumber);
        WriteGitLog('Git request will retry with a fresh connection in ' +
          IntToStr(RetryDelayMs) + 'ms');
        ResetHttpConnection;
        Sleep(RetryDelayMs);
      end;
    end;
  end;
end;

function TGitManager.GetFileWithRetry(const URL, FileName: string): Int64;
var
  AttemptNumber: Integer;
  RetryDelayMs: Integer;
  StartedAt: Cardinal;
  FileStream: TFileStream;
  TempFileName: string;
begin
  Result := 0;
  TempFileName := FileName + '.part';

  for AttemptNumber := 1 to MaxGitRequestAttempts do
  begin
    ResetIdHttpReqObj;
    FileStream := nil;
    StartedAt := GetTickCount;
    WriteGitLog('Git download start. URL=' + SafeURLForLog(URL) +
      ', file=' + FileName + ', attempt=' + IntToStr(AttemptNumber) + '/' +
      IntToStr(MaxGitRequestAttempts) + ', connect-timeout=' +
      IntToStr(GitConnectTimeoutMs) + 'ms, read-timeout=' +
      IntToStr(GitReadTimeoutMs) + 'ms');
    try
      if FileExists(TempFileName) and not DeleteFile(TempFileName) then
        RaiseLastOSError;

      FileStream := TFileStream.create(TempFileName, fmCreate);
      IdHttp1.Get(URL, FileStream);
      Result := FileStream.Size;
      FreeAndNil(FileStream);

      if Result = 0 then
        raise Exception.create('Zero size file found.');

      if not MoveFileEx(PChar(TempFileName), PChar(FileName),
        MOVEFILE_REPLACE_EXISTING or MOVEFILE_WRITE_THROUGH) then
        RaiseLastOSError;

      WriteGitLog('Git download success. URL=' + SafeURLForLog(URL) +
        ', file=' + FileName + ', attempt=' + IntToStr(AttemptNumber) +
        ', elapsed=' + IntToStr(Cardinal(GetTickCount - StartedAt)) +
        'ms, HTTP=' + IntToStr(IdHttp1.ResponseCode) + ', bytes=' +
        IntToStr(Result));
      Exit;
    except
      on E: Exception do
      begin
        FreeAndNil(FileStream);
        if FileExists(TempFileName) and not DeleteFile(TempFileName) then
          WriteGitLog('Unable to remove partial download: ' + TempFileName);

        WriteGitLog('Git download failed. URL=' + SafeURLForLog(URL) +
          ', file=' + FileName + ', attempt=' + IntToStr(AttemptNumber) +
          ', elapsed=' + IntToStr(Cardinal(GetTickCount - StartedAt)) +
          'ms, exception=' + E.ClassName + ', message=' + E.Message);
        if E is EIdSocketError then
          WriteGitLog('Git socket error code=' +
            IntToStr(EIdSocketError(E).LastError))
        else if E is EIdHTTPProtocolException then
        begin
          WriteGitLog('Git HTTP status=' +
            IntToStr(EIdHTTPProtocolException(E).ErrorCode));
          if Assigned(IdHttp1.Response) then
            WriteGitLog('Git rate limit. remaining=' +
              IdHttp1.Response.RawHeaders.Values['X-RateLimit-Remaining'] +
              ', reset=' +
              IdHttp1.Response.RawHeaders.Values['X-RateLimit-Reset'] +
              ', retry-after=' +
              IdHttp1.Response.RawHeaders.Values['Retry-After']);
        end;

        if (AttemptNumber = MaxGitRequestAttempts) or
          not IsRetryableRequestError(E) then
        begin
          WriteGitLog('Git download final failure. URL=' +
            SafeURLForLog(URL) + ', file=' + FileName + ', attempts=' +
            IntToStr(AttemptNumber));
          raise EGitRequestFailed.Create(E.ClassName + ': ' + E.Message);
        end;

        RetryDelayMs := GetRetryDelayMs(AttemptNumber);
        WriteGitLog('Git download will retry with a fresh connection in ' +
          IntToStr(RetryDelayMs) + 'ms');
        ResetHttpConnection;
        Sleep(RetryDelayMs);
      end;
    end;
  end;
end;

