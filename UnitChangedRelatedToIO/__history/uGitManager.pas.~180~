                simultaneously, all requests count toward the same rate limit
                (depending on the Git provider and authentication method). *)

              if IsRetryableHttpError(E.ErrorCode) or
                (lowercase(errmsg) = 'Read timed out') then
              begin
                try
                  errmsg := '';
                  Inc(httpretry);
                  Appwriteln('Retrying..(' + inttostr(httpretry) + ')');
