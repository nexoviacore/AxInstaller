procedure TCreateStructure.AddValuesToFromSQLNode(dnode: IXMLNode; fxds: TXDS);
var
  detnode, snode,tn,xnode : IXMLNode;
  wndwdth,wndwhgt,srcfld,srctbl,sql : String;
  i : Integer;
begin
  detnode := nil;
  detnode := dnode;
  srcfld := fxds.CDS.FieldByName('sourcefield').AsString;//sourcefield (Before selectfield - )
  srctbl := fxds.CDS.FieldByName('source_table').AsString;// Source Table
  wndwdth := fxds.CDS.FieldByName('windowwidth').AsString;
  if (wndwdth <> '') then
    detnode.ChildValues[xml_SGWidth] := wndwdth
  else
    detnode.ChildValues[xml_SGWidth] := 0;
  wndwhgt := fxds.CDS.FieldByName('windowheight').AsString;
  if (wndwhgt <> '') then
    detnode.ChildValues[xml_SGHeight] := wndwhgt
  else
    detnode.ChildValues[xml_SGHeight] := 0;
  if (lowercase(fxds.CDS.FieldByName('autoselect').AsString) = 'true') then
    detnode.ChildValues[xml_AutoSelect] := 'True'
  else
    detnode.ChildValues[xml_AutoSelect] := 'False';
  if (lowercase(fxds.CDS.FieldByName('refresh').AsString) = 'true') then
    detnode.ChildValues[xml_Refresh] := 'True'
  else
    detnode.ChildValues[xml_Refresh] := 'False';
  detnode.ChildValues[xml_Trans] := srctbl;
  detnode := dnode.ChildNodes.FindNode(xml_Source);
  if ((lowercase(fxds.CDS.FieldByName('savenormalized').AsString) = 'false') or (lowercase(fxds.CDS.FieldByName('savenormalized').AsString) = '')) then
  begin
    detnode.Attributes['table'] := '';
    detnode.Attributes['cap'] := '';
    detnode.Attributes['stype'] := 'sql';
    detnode.Attributes['scol'] := '0';
  end
  else
  begin
    if srctbl = '' then raise Exception.Create('Source Table can''t'' be left Empty...!');
    if srcfld = '' then raise Exception.Create('Source Field can''t'' be left Empty...!');
    detnode.Attributes['table'] := srctbl;
    detnode.Attributes['cap'] := fxds.CDS.FieldByName('fromtransid').AsString;
    detnode.Attributes['stype'] := 'sql';
    detnode.Attributes['scol'] := '1';
  end;
  detnode.NodeValue := srcfld;
  sql := Trim(fxds.CDS.FieldByName('sql').AsString);
  sql := Axp.dbm.gf.FindAndReplace(sql,#13#10,' ');
  snode := dnode.ChildNodes.FindNode(xml_SQL);
  if lowercase(fxds.CDS.FieldByName('combobox').AsString) = 'true' then
    snode.Attributes['txt'] := 'f'
  else
    snode.Attributes['txt'] := 't';
  snode.AddChild('l').NodeValue := sql;
  tn := dnode.ChildNodes.FindNode(xml_Dynamic);
  GetDynamicData(sql);
  if tn <> nil then
  begin
    tn.ChildNodes.Clear;
    if DynamicList.Count > 0 then
    begin
      for i := 0 to DynamicList.Count - 1 do
      begin
        xnode := tn.AddChild('l');
        xnode.Attributes['cn'] := DynamicList[i];
      end;
    end;
  end else
  begin
    if DynamicList.Count > 0 then
    begin
      tn := dnode.AddChild(xml_Dynamic);
      for i := 0 to DynamicList.Count - 1 do
      begin
        xnode := tn.AddChild('l');
        xnode.Attributes['cn'] := DynamicList[i];
      end;
    end;
  end;
end;

