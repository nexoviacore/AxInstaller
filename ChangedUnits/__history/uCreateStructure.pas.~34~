function TCreateStructure.GetDynamicData(sql : String):Boolean;
var i,spos,epos : Integer;
    s,cName : String;
    Errstr:string;
begin
  result := False;
  spos := pos('{dynamicfilter',lowercase(sql));
  try
    if (spos>0) then
    begin
      s := sql;
      s := copy(s,spos,Length(s));
      epos := pos('}',s);
      s := trim(copy(s,1,epos-1));
      if pos('dynamicfilterword',lowercase(s)) > 0 then
        delete(s,1,18)
      else
        delete(s,1,14);
      epos := pos('~',s);
      if epos > 0 then
        s := copy(s,epos+1,Length(s));
      i := 1;
      cName := axp.dbm.gf.getnthstring(s,i);
      while cName <> '' do begin
        DynamicList.Add(cName);
        inc(i);
        cName := axp.dbm.gf.getnthstring(s,i);
      end;
    end;
  except
    On E:Exception do
    begin
      if assigned(axp) then
      begin
        Errstr:=axp.dbm.gf.Axp_logstr+'\uSelect\GetDynamicData - '+e.Message;
        axp.dbm.gf.DoDebug.msg(Errstr);
      end;
      DynamicList.Clear;
      Raise Exception.Create(E.Message);
    end;
  end;
  result := True;
end;

Procedure TCreateStructure.SetComponentType(ftmp : TXDS;fldnode : IXMLNode);
var
cmtype,sep : String;
begin
  cnode := fldnode.ChildNodes.FindNode(xml_gui);
  if assigned(cnode) then
  begin
    cmtype := ftmp.CDS.FieldByName('componenttype').AsString;
    if cmtype <> '' then
    begin
      if lowercase(cmtype) = 'radiogrouphorizontal' then
      begin
        cnode.Attributes['ctype'] := 'Radio group';
        cnode.Attributes['type'] := 'h';
      end else
      if lowercase(cmtype) = 'radiogroupvertical' then
      begin
        cnode.Attributes['ctype'] := 'Radio group';
        cnode.Attributes['type'] := 'v';
      end
      else
      if lowercase(cmtype) = 'check list' then
      begin
        cnode.Attributes['ctype'] := 'Check list';
        cnode.Attributes['type'] := 'v';
        sep := ftmp.CDS.FieldByName('separator').AsString;
        if (sep <> '') then
          cnode.Attributes['type'] := sep
        else
          cnode.Attributes['type'] := ',';
      end
      else
      if lowercase(cmtype) = 'check box' then
      begin
        cnode.Attributes['ctype'] := 'Check box';
        cnode.Attributes['type'] := 'v';
      end
      else
      if lowercase(cmtype) = 'memo' then
      begin
        cnode.Attributes['ctype'] := 'Memo';
        cnode.Attributes['type'] := 'v';
      end
      else
      if lowercase(cmtype) = 'default' then
      begin
        cnode.Attributes['ctype'] := '';
        cnode.Attributes['type'] := '';
      end
    end;
  end;
end;

Procedure TCreateStructure.UpdatePagesByPosition;
var PrvOrd,NewOrd,NewLevel : Integer;
    NewParent,PageName,pgtype : String;
begin
  try
    axp.dbm.gf.userroles := 'default';
//    PageOrderXML := axp.GetPageOrderXML;

  //  if (copy(FName, 1, 1) = 't') then
        pgtype := 'Ts';
  //    else
  //      pgtype := 'Iv';
    PageName := 'Page' + pgtype + FName;//copy(FName, 2, Length(FName));
    if LowerCase(FolderName) = 'default' then FolderName := '';

    (*
    When FolderName is empty set menu position to default.
    Else this may cause problem.
    *)
  //  if FolderName = '' then menupos := 'default';

    if lowercase(menupos) = 'insert before' then
    begin
      GetDataForInsertBefore(PageName,FolderName,PrvOrd,NewOrd,NewLevel,NewParent);
      axp.ExecSQL('update axpages set ordno =  ' + IntToStr(NewOrd) + ',levelno = ' + IntToStr(NewLevel)
      + ', parent = '+QuotedStr(NewParent)+' where '+Axp.dbm.gf.sqllower+'(name) = ' + quotedstr(LowerCase(PageName)),'','',False);
      ResetOtherPages(PrvOrd,NewOrd,PageName);
    end
    else if lowercase(menupos) = 'add under' then
    begin
      GetDataForAddUnder(PageName,FolderName,PrvOrd,NewOrd,NewLevel);
      axp.ExecSQL('update axpages set ordno =  ' + IntToStr(NewOrd) + ',levelno = '+ IntToStr(NewLevel) + ' where '+Axp.dbm.gf.sqllower+'(name) = '
      + quotedstr(LowerCase(PageName)),'','',False);
      ResetOtherPages(PrvOrd,NewOrd,PageName);
    end
    else if (lowercase(menupos) = 'default') and (IsNewTstruct) then
    begin
      GetDataForDefaultPosition(PageName,PrvOrd,NewOrd);
      axp.ExecSQL('update axpages set ordno =  ' + IntToStr(NewOrd) + ',levelno = 0,parent = Null where '+Axp.dbm.gf.sqllower+'(name) = '+QuotedStr(LowerCase(PageName)),'','',False);
      ResetOtherPages(PrvOrd,NewOrd,PageName);
    end;
    if HasNoParent then axp.ExecSQL('update axpages set ordno = ordno-1 where ordno > '+OrdNum,'','',False);
//    axp.SetStructure('axprops','pageorder','pageorder',PageOrderXML);
  Except on E:Exception do
    Raise Exception.Create('Error in updating menu - '+E.Message);
  end;
end;

Procedure TCreateStructure.GetDataForAddUnder(PageName,ParentName : String; var PrvOrd : Integer; var NewOrd : Integer; var NewLevel : Integer);
var tempord : Integer;
    IsMaxOrd : Boolean;
begin
  try
    IsMaxOrd := False;
    MXDS.close;
    MXDS.CDS.CommandText := 'select ordno from axpages where name = '+ QuotedStr(PageName);
    MXDS.open;
    if not MXDS.CDS.IsEmpty then
    begin
      MXDS.CDS.First;
      PrvOrd := StrToInt(MXDS.CDS.FieldByName('ordno').AsString);
    end else
    begin
      MXDS.close;
      MXDS.buffered := True;
      MXDS.CDS.CommandText := 'select Max(ordno) as maxord from axpages';
      MXDS.CDS.Open;
      PrvOrd := StrToInt(MXDS.CDS.FieldByName('maxord').AsString)+1;
    end;
    if ParentName = '' then ParentName := ExtractFileName(MenuList);

    MXDS.close;
    MXDS.CDS.CommandText := 'select ordno,levelno from axpages where '+Axp.dbm.gf.sqllower+'(name) = '+ QuotedStr(LowerCase(ParentName));
    MXDS.open;
    if not MXDS.CDS.IsEmpty then
    begin
      if MXDS.CDS.FieldByName('levelno').AsString = '' then
         NewLevel := 0
      else NewLevel := StrToInt(MXDS.CDS.FieldByName('levelno').AsString)+1;
      tempord := StrToInt(MXDS.CDS.FieldByName('ordno').AsString);
    end else begin
      NewLevel := Axp.dbm.gf.GetSeperatorCount(MenuList,'\');
      tempord := PrvOrd;
    end;

    MXDS.close;
    MXDS.CDS.CommandText := 'select ordno from axpages where ordno >= '+ IntToStr(tempord) +' and levelno <= '+ IntToStr(NewLevel-1) +
                       ' and '+Axp.dbm.gf.sqllower+'(name) <> '+ quotedstr(LowerCase(ParentName))+' order by ordno';
    MXDS.CDS.Open;
    if not MXDS.CDS.IsEmpty then
    begin
      MXDS.CDS.First;
      tempOrd := StrToInt(MXDS.CDS.FieldByName('ordno').AsString);
    end else
    begin
      MXDS.close;
      MXDS.buffered := True;
      MXDS.CDS.CommandText := 'select Max(ordno) as maxord from axpages where ordno >= '+IntToStr(tempOrd)+' and visible = ''T''';
      MXDS.CDS.Open;
      tempOrd := StrToInt(MXDS.CDS.FieldByName('maxord').AsString);
      IsMaxOrd := True;
    end;
    if (PrvOrd < tempOrd) and (not IsMaxOrd) then NewOrd := tempOrd-1
    else if PrvOrd = 0 then newOrd := tempord+1
    else newOrd := tempord;
  Except
  on E : Exception do begin
    Axp.dbm.gf.DoDebug.msg(Axp.dbm.gf.Axp_logstr+'\GetDataForAddUnder - '+e.Message);
  end;
 end;
end;

