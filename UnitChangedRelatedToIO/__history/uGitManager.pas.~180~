                    console_write(errmsg);
                    WriteLog(errmsg);
                    ReadErrorList(errmsg);
                  end;
                end;
              end;

              if errmsg <> '' then
              begin
                // If any issue occurs
                bGitPullIncomplete := True;
                raise Exception.create(errmsg);
              end;

            end;

            // Sleep(2000);
          end;
          on E: Exception do
          begin
            // InstallErrMsg := e.Message;
            InstallErrMsg := E.ClassName + ' : ' + E.Message;
            Console_Writeln
              ('Failed to pull files from the Git repository.', 12);
            Console_Writeln('IdHTTP1.Get error: ' + E.Message);
            WriteLog('IdHTTP1.Get error: ' + E.Message);
            ReadErrorList(E.Message);
            pageNotFoundError := True;
            // If any issue occurs
            bGitPullIncomplete := True;
            Exit;
          end;

        end;
      end
      else
      begin
        try
          WriteLog('IdHTTP1.Get starts, GURL: ' +
            SafeURLForLog(GURL + '/' + Fpath));
