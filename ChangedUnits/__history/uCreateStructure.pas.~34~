// AddAppParamsToAxGloFields
(*
 Method to read app params from axp_vp table and update it into axglo tstruct as fields.

*)
procedure TCreateStructure.AddAppParamsToAxGloFields;
var
  fnode, tnode, detnode, snode, Agnode, xnode,tn,confgNode: IXMLNode;
  FldName, moe, chkmoe,actsql,AutoGenVal,colNames,temp,CustDtype: String;
  ftmp: TXDS;
  AutoGenList : TStringList;
  i,k,fldIdx : Integer;
  isFirstTime : Boolean;
begin
  Try
    fnode := nil;   // field node
    tnode := nil;   // details node of a field
    detnode := nil; // fill node
    snode := nil;   // autogenerate node
    xnode := nil;
    tn := nil;
    confgNode := nil;
    ftmp := nil;
    fldIdx := 0;
    isFirstTime := True;
    //Clear axglo fields except default params fromuserlogin , axglo_user , axp_displaytext , axglo_hide ,axpimageserver,axpimagepath
    for i := enode.ChildNodes.Count - 1 downto 0 do
    begin
      fnode := enode.ChildNodes[i];
      if fnode.Attributes['cat'] = 'field' then
      begin
         if isFirstTime then
         begin
            fldIdx := i+1;
            isFirstTime := False;
         end;
         FldName := fnode.NodeName;
         if (lowercase(FldName) <> 'fromuserlogin') and (lowercase(FldName) <> 'axglo_user')
            and (lowercase(FldName) <> 'axp_displaytext') and (lowercase(FldName) <> 'axglo_hide')
            and (lowercase(FldName) <> 'axpimageserver') and (lowercase(FldName) <> 'axpimagepath') then
         begin
            enode.ChildNodes.Delete(i);
            fldIdx := fldIdx-1;
         end;
      end
      else
        Continue;
    end;

    ftmp := Axp.dbm.GetXDS(nil);
    ftmp.buffered := True;
    ftmp.CDS.CommandText := 'select * from axp_vp where '+Axp.dbm.gf.sqllower+'(isparam)= :isparam '+
                            ' order by createdon';
    ftmp.AssignParam(0, 't', 'c');
    ftmp.open;
    if (ftmp.CDS.RecordCount > 0) then
    begin
      ftmp.CDS.First;
      while not ftmp.CDS.Eof do
      begin
        tnode := nil;
        FldName := ftmp.CDS.FieldByName('vpname').AsString;
        moe := ftmp.CDS.FieldByName('modeofentry').AsString;

        fnode := enode.AddChild(FldName,fldIdx);
        Inc(fldIdx);
        AddDefNodes('field', fnode);
        fnode.Attributes['cat'] := 'field';
        fnode.Attributes['dcno'] := '1';
        CustDtype := ftmp.CDS.FieldByName('customdatatype').AsString;
        fnode.Attributes['fieldtype'] := CustDtype;//ftmp.CDS.FieldByName('customdatatype').AsString;
        AddDetailsNodes(fnode,CustDtype,',');
        fnode.ChildValues[xml_Name] := FldName;
        fnode.ChildValues[xml_Caption] := ftmp.CDS.FieldByName('pcaption').AsString;
        fnode.ChildValues[xml_TableTypeDetails] := CustDtype;//ftmp.CDS.FieldByName('customdatatype').AsString;
        fnode.ChildValues[xml_DataType] := ftmp.CDS.FieldByName('pdatatype').AsString;        
        fnode.ChildValues[xml_DataWidth] := ftmp.CDS.FieldByName('datawidth').AsInteger;
        if fnode.ChildValues[xml_DataWidth] = 0 then
          fnode.ChildValues[xml_DataWidth] := 200;//Param doesn;t have datawidth , earlier it was updated through genmap to axp_vp
        fnode.ChildValues[xml_Dec] := '0';//ftmp.CDS.FieldByName('fdecimal').AsInteger;
        chkmoe := Trim(lowercase(moe));
        fnode.ChildValues[xml_MOE] := chkmoe;
        if (lowercase(ftmp.CDS.FieldByName('display').AsString) = 't') then //caption hidden but fieldname display
          fnode.ChildValues[xml_Hide] := 'True'
        else
          fnode.ChildValues[xml_Hide] := 'False';

        fnode.ChildValues[xml_Empty] := 'True';

        if (lowercase(ftmp.CDS.FieldByName('readonly').AsString) = 't') then
          fnode.ChildValues[xml_ReadOnly] := 'True'
        else
          fnode.ChildValues[xml_ReadOnly] := 'False';
        fnode.ChildValues[xml_SetCarry] := 'False';
        fnode.ChildValues[xml_Save] := 'True';
        fnode.ChildValues[xml_Duplicate] := 'True';
        fnode.ChildValues[xml_OnlyPositive] := 'True';
        fnode.ChildValues[xml_ApplyComma] := 'True';
        fnode.ChildValues[xml_CValidate] := 'True';
        fnode.ChildValues[xml_Tabstop] := 'True';

        fnode.ChildValues[xml_Expr] := ftmp.CDS.FieldByName('vpvalue').AsString;
        fnode.ChildValues[xml_VExp] := '';
        fnode.ChildValues[xml_Mask] := '';
        fnode.ChildValues[xml_Pattern] := '';
        fnode.ChildValues[xml_Hint] := '';
        fnode.ChildValues[xml_PWordChar] := '';
        fnode.ChildValues[xml_Purpose] := '';
        fnode.ChildValues[xml_SearchSQL] := '';
        fnode.ChildValues[xml_displaydetail] := '';
        tnode := fnode.ChildNodes.FindNode(xml_Details);

        if (chkmoe = 'accept') then
        begin
          fnode.ChildValues[xml_MOE] := 'Accept';

          tnode.ChildValues[xml_Suggestive] := 'False';
          tnode.ChildValues[xml_Refresh] := 'False';
          tnode.ChildValues[xml_AutoSelect] := 'True';

          tnode := tnode.ChildNodes.FindNode(xml_SQL);
          actsql := ftmp.CDS.FieldByName('sql_editor_psql').AsString;
          if (actsql <> '') then
          begin
            tnode.ChildValues['l'] := Axp.dbm.gf.FindAndReplace(actsql,#13#10,' ');
          end;
        end
        else if (chkmoe = 'select') then
        begin
          fnode.ChildValues[xml_SourceKey] := 'False';
          tnode.ChildValues[xml_SGWidth] := 0;
          tnode.ChildValues[xml_SGHeight] := 0;
          tnode.ChildValues[xml_AutoSelect] := 'True';
          tnode.ChildValues[xml_Refresh] := 'False';
          tnode.ChildValues[xml_Trans] := '';
          detnode := tnode.ChildNodes.FindNode(xml_Source);
          detnode.Attributes['table'] := '';
          detnode.Attributes['cap'] := '';
          detnode.Attributes['stype'] := 'sql';
          detnode.Attributes['scol'] := '0';
          detnode.NodeValue := '';
          actsql := Trim(ftmp.CDS.FieldByName('sql_editor_psql').AsString);
          actsql := Axp.dbm.gf.FindAndReplace(actsql,#13#10,' ');

          snode := tnode.ChildNodes.FindNode(xml_SQL);

          snode.Attributes['txt'] := 't';
          snode.AddChild('l').NodeValue := actsql;
          tn := tnode.ChildNodes.FindNode(xml_Dynamic);
          GetDynamicData(actsql);
          if tn <> nil then
          begin
            tn.ChildNodes.Clear;
            if DynamicList.Count > 0 then
            begin
              for i := 0 to DynamicList.Count - 1 do
              begin
                xnode := tn.AddChild('l');
                xnode.Attributes['cn'] := DynamicList[i];
              end;
            end;
          end else
          begin
            if DynamicList.Count > 0 then
            begin
              tn := tnode.AddChild(xml_Dynamic);
              for i := 0 to DynamicList.Count - 1 do
              begin
                xnode := tn.AddChild('l');
                xnode.Attributes['cn'] := DynamicList[i];
              end;
            end;
          end;
        end
        else if (chkmoe = 'fill') then   //Fill moe
        begin
          fnode.ChildValues[xml_MOE] := 'Fill';
          if (ftmp.CDS.FieldByName('masterdl').AsString <> '') then
            tnode.ChildValues[xml_FParent] := ftmp.CDS.FieldByName('masterdl').AsString
          else raise Exception.Create('Values not found for Parent Field');
          if (ftmp.CDS.FieldByName('source').AsString <> '') then
            tnode.ChildValues[xml_FSource] := ftmp.CDS.FieldByName('source').AsString
          else raise Exception.Create('Values not found for Source Field');
          tnode.ChildValues[xml_Suggestive] := 'False';
        end;
        fnode.ChildValues[xml_TableTypeDetails] := '';
        //SetComponentType(ftmp,fnode);
        ftmp.CDS.Next;
      end;

      //Adding config node
      (*config details read from axp_vp itself, so we used same cds for creating XML data*)
      writeintolog('AxpConfig Node append for axglo started...');
      confgNode := enode.ChildNodes.FindNode('axpconfigs_' + FName);
      if Not Assigned(confgNode) then
        confgNode := enode.AddChild('axpconfigs_' + FName);
      confgNode.Attributes['cat'] := 'config';
      tnode := nil;

      ftmp.CDS.First;
      tnode := confgNode.ChildNodes.FindNode('CONFIGNAME');
      if Not Assigned(tnode) then
        tnode := confgNode.AddChild('CONFIGNAME');
      tnode.NodeValue := 'searchcols';
      colNames := '';
      while not ftmp.CDS.Eof do
      begin
        temp := ftmp.CDS.FieldByName('vpname').AsString;
        colNames := colNames + ',' + temp;
        ftmp.CDS.Next;
      end;
      tnode := nil;
      tnode := confgNode.ChildNodes.FindNode('CVALUE');
      if Not Assigned(tnode) then
        tnode := confgNode.AddChild('CVALUE');
      tnode.NodeValue := Copy(colNames, 2, length(colNames));
    end;
    if assigned(ftmp) then
    begin
      ftmp.close;
      ftmp.Free;
      ftmp := nil;
    end;
  except
    on e: Exception do
    begin
      errstr := copy(e.message, 1, 199);
      if (errstr <> '') then
        raise Exception.Create(FldName+' - '+errstr);
    end;
  End;
end;


//ReadAxGloDef
(*
  ReadAxGloDef will read xml from tstructs table , then param details will be read from axp_vp table
  and then it will append param in axglo tstructs xml as fields.
  Framed XML will be send as result of ReadAxGloDef function.
*)
procedure TCreateStructure.ReadAxGloDef;
var
  tmnode: IXMLNode;
  userdesigned: Boolean;
  Ht, Lt, wt, Top1, Top2: Integer;
  t, sType: String;
  q: TXDS;
begin
  writeintolog('ReadAxGloDef starts');
  try
    tmnode := nil;
    bSkipPageRelatedProcess := True;
    //FName := 'axglo';
    LoadPropsXML;
    fxml := Axp.GetStructure('tstructs',FName,'','');
    enode := fxml.DocumentElement;
    // Load app param details from axp_vp (New application variable/param (axvar))
    AddAppParamsToAxGloFields;
    //Complete Structure XML will be created at this stage

    //Clearing iframaes child nodes , since it will be recreated when saving / importing the structure
    //ref uImportStructdef-CreateTStruct
    // Load ifrmaes
    inode := enode.ChildNodes.FindNode('iframes');
    //if iframes node not available then create iframes node
    if Not Assigned(inode) then
    begin
      // Create ifrmaes
      inode := enode.AddChild('iframes');
      inode.Attributes['cat'] := 'iframes';
      inode.Attributes['layout'] := 'default';
    end
    else
      inode.ChildNodes.Clear; //Clear child nodes

    //Calling WriteTStructDef to update axglo tstruct in current schema(APP schema)
    WriteTStructDef(FName,fxml.xml.Text);

    (*
    After calling WriteTStructDef frames node will get updated into fxml
    since fxml is a global var and its used in WriteTStructDef.
    Called inode.childnodes.clear again to clear iframes , becase this XML will be send 
    as result to client and it will be used by writedefinition ws for updating axglo tstruct in the appschema.
    *)
    inode.ChildNodes.Clear; //Clear child nodes

  finally
    // Set bSkipPageRelatedProcess boolean var value to false.
    bSkipPageRelatedProcess := False;
  end;
  writeintolog('ReadAxGloDef ends');
end;

Function TCreateStructure.CheckDCTableChange : String;
var DCChangeList,OldTbl,CurrentTbl , s : String;
    IsDelete : Boolean;
begin
  try
  try
    Result := '';
    DCChangeList := '';
    IsDelete := False;
    MXDS.close;
    MXDS.CDS.CommandText := 'select name,caption,tablename,oldtablename,deleteoldtable from axpdef_dc where '+
                            Axp.dbm.gf.sqllower+'(stransid) = '+ QuotedStr(LowerCase(FName));
    MXDS.open;
    if (MXDS.CDS.RecordCount > 0) then
    begin
      MXDS.CDS.First;
      while not MXDS.CDS.Eof do
      begin
        s := '';
        OldTbl := LowerCase(MXDS.CDS.FieldByName('oldtablename').AsString);
        CurrentTbl := LowerCase(MXDS.CDS.FieldByName('tablename').AsString);
        IsDelete := (Lowercase(MXDS.CDS.FieldByName('deleteoldtable').AsString) = 'yes');

        if Trim(OldTbl) <> '' then begin
          if (Trim(CurrentTbl) <> Trim(OldTbl)) then
            s := OldTbl+'~'+CurrentTbl+'~'+Lowercase(MXDS.CDS.FieldByName('deleteoldtable').AsString);
        end;

        if s <> '' then DCChangeList := DCChangeList+',' + s;
        MXDS.CDS.Next;
      end;
    end;
//    if DCChangeList <> '' then Result := copy(Trim(DCChangeList),1, Length(DCChangeList)-1);
    if DCChangeList <> '' then
    begin
       delete(DCChangeList,1,1);
       Result := DCChangeList;
    end;
  Except
  on E : Exception do
    begin
      if assigned(Axp) then
        begin
          Errstr:=Axp.dbm.gf.Axp_logstr+'\CheckDCTableChange - '+e.Message;
          Axp.dbm.gf.DoDebug.msg(Errstr);
        end;
    end;
  end;
  finally
    MXDS.close;
  end;
end;

procedure TCreateStructure.TransferDataAndDropOldTable(tablist : String);
var i : Integer;
    s,Errstr,tabName,OldTab,NewTab : String;
    TabSL : TStringList;
begin
 try
   TabSL := TStringList.Create;
   TabSL.CommaText := tablist;
   for I := 0 to TabSL.Count-1 do
   begin
    tabName := TabSL[i];
    OldTab := Axp.dbm.gf.GetNthString(tabName, 1, '~');
    NewTab := Axp.dbm.gf.GetNthString(tabName, 2, '~');
    s := 'INSERT INTO '+NewTab+' SELECT DISTINCT * FROM '+OldTab+
         ' s WHERE NOT EXISTS (SELECT 1 FROM '+NewTab+' WHERE '+
         NewTab+'id = s.'+OldTab+'id)';
    axp.ExecSQL(s,'','',false);
    s := '';
    if Axp.dbm.gf.GetNthString(tabName, 3, '~') = 'yes' then begin
      if Axp.dbm.Connection.DbType = 'postgre' then
        s := 'DROP TABLE IF EXISTS '+OldTab
      else  s := 'DROP TABLE '+OldTab;
      axp.ExecSQL(s,'','',false);
    end;
   end;
 Except
  on E : Exception do
    begin
      if assigned(Axp) then
        begin
          Errstr:=Axp.dbm.gf.Axp_logstr+'\DropDCTables - '+e.Message;
          Axp.dbm.gf.DoDebug.msg(Errstr);
        end;
    end;
 end;
end;

