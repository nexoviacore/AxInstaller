          if lowercase(VarToStr(temp.Attributes['refresh'])) = 'true' then b := 'T'
          else b := 'F';
          cxds.Submit('HYPREFRESH',b,'c');
          if lowercase(VarToStr(temp.Attributes['load'])) = 'true' then b := 'T'
          else b := 'F';
          cxds.Submit('LOADNAME',b,'c');
          cxds.Submit('ordno',IntToStr(j+1),'n');
          w := 'INAME =' + quotedstr(iname)+'and HYPNAME = '+ quotedstr(hypname) ;
          cxds.AddOrEdit('IVIEWHYPLINK',w);
          cxds.close;
          InsertIntoIviewHypParValTable(iname,hypname,temp);
